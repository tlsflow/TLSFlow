{
  "version": 1,
  "publicRepositoryName": "TLSFlow",
  "initialSync": {
    "modeEnvironmentVariable": "PUBLIC_RELEASE_INITIAL_SYNC",
    "sourceCommitEnvironmentVariable": "PUBLIC_RELEASE_INITIAL_SOURCE_COMMIT",
    "projectionPolicy": "commit-on-whitelist-change",
    "defaultMode": "snapshot"
  },
  "publicPaths": [
    "agents",
    "backend",
    "web",
    "browser-runtime",
    "tls-inspector",
    "compatibility",
    "docker",
    "docs/Documentation",
    "docs/项目规范",
    ".dockerignore",
    "LICENSE",
    "version",
    "scripts/plugins/check-builtin-plugin-versions.mjs",
    "scripts/plugins/check-builtin-plugin-versions.test.mjs",
    "scripts/compatibility/check-compatibility-architecture.mjs",
    "scripts/compatibility/check-compatibility-architecture.test.mjs",
    "scripts/architecture/check-deployment-input-architecture.mjs",
    "scripts/architecture/check-deployment-input-architecture.test.mjs",
    "scripts/architecture/check-plugin-architecture.mjs",
    "scripts/architecture/check-plugin-architecture.test.mjs",
    "scripts/quality/check-utf8-mojibake.mjs",
    "scripts/quality/check-utf8-mojibake.test.mjs",
    "scripts/compatibility/compatibility-architecture-baseline.json",
    "scripts/architecture/plugin-architecture-debt.json",
    "scripts/public-release/public-release.config.json",
    "scripts/public-release/check-public-tree.mjs",
    "scripts/public-release/sync-github.mjs",
    "scripts/dev-backend.sh",
    "scripts/dev-web.sh",
    "scripts/dev-tls-inspector.sh",
    "scripts/dev/dev-all.sh",
    ".workflow/0014-sync-github.yml"
  ],
  "publicContributionPaths": [
    "agents",
    "backend",
    "browser-runtime",
    "compatibility",
    "docker",
    "docs/Documentation",
    "docs/项目规范",
    "tls-inspector",
    "web"
  ],
  "requiredPublicFiles": [
    "backend/src/database/migrations/20260823000000_unified_current_baseline.sql"
  ],
  "generatedFiles": [
    {
      "source": "scripts/public-release/public-repository.gitignore",
      "target": ".gitignore"
    }
  ],
  "forbiddenPathPatterns": [
    "^(?:specs|data|output|tmp|temp|private|secrets)(?:/|$)",
    "^data/license-generator/keys(?:/|$)",
    "^docs/(?!Documentation(?:/|$)|项目规范(?:/|$))",
    "^docs/Documentation/(?:node_modules|\\.vitepress/(?:dist|cache))(?:/|$)",
    "^docker/docs/20260806-Docker镜像发布与凭据边界说明\\.md$",
    "^AGENTS\\.md$",
    "^\\.workflow/(?:0014-generate-public-candidate|0014-import-public-contribution)\\.yml$",
    "^\\.workflow/20260805-公开发布凭据变量配置说明\\.md$",
    "^scripts/(?:archive|versioning)(?:/|$)",
    "^scripts/public-release/(?:generate-public-candidate|import-public-contribution)\\.mjs$",
    "^scripts/public-release/(?:public-release(?:\\.integration)?|sync-github\\.integration)\\.test\\.mjs$",
    "^scripts/20260806-脚本目录说明\\.md$",
    "(?:^|/)\\.env(?:$|\\.(?!example(?:$|\\.)|template(?:$|\\.))[^/]+$)",
    "(?:^|/)(?:.*\\.(?:key|pem|p12|pfx|jks|keystore|crt|csr|cer|der))$",
    "(?:^|/)(?:node_modules|\\.git|bin|obj)(?:/|$)",
    "(?:^|/).*(?:\\.exe|\\.dll|\\.pdb)$"
  ],
  "sensitiveFilePatterns": [
    "(?:^|/)\\.env(?:$|\\.(?!example(?:$|\\.)|template(?:$|\\.))[^/]+$)",
    "(?:^|/)(?:id_rsa|id_ed25519)(?:$|\\.)",
    "\\.(?:key|pem|p12|pfx|jks|keystore|crt|csr|cer|der)$"
  ],
  "sensitiveContentPatterns": [
    "-----BEGIN (?:RSA |EC |OPENSSH |DSA )?PRIVATE KEY-----\\s*(?:[A-Za-z0-9+/=]{40,}\\s*){2,}-----END (?:RSA |EC |OPENSSH |DSA )?PRIVATE KEY-----",
    "\\b(?:AKIA|ASIA)[0-9A-Z]{16}\\b",
    "\\bgh[pousr]_[A-Za-z0-9_]{30,}\\b",
    "\\bgithub_pat_[A-Za-z0-9_]{30,}\\b",
    "\\bsk-(?:proj-)?[A-Za-z0-9_-]{40,}\\b"
  ]
}
