#!/bin/sh
### BEGIN INIT INFO
# Provides:          gcac-linux-agent
# Required-Start:    $network $remote_fs
# Required-Stop:     $network $remote_fs
# Default-Start:     2 3 4 5
# Default-Stop:      0 1 6
# Short-Description: GCAC Linux Go Full Agent
### END INIT INFO

DAEMON=/opt/gcac/linux-agent/gcac-linux-agent
CONFIG=/etc/gcac/linux-agent/agent.config.json
PIDFILE=/run/gcac-linux-agent.pid

case "${1:-}" in
  start)
    start-stop-daemon --start --background --make-pidfile --pidfile "${PIDFILE}" --exec "${DAEMON}" -- run --config="${CONFIG}"
    ;;
  stop)
    start-stop-daemon --stop --pidfile "${PIDFILE}" --retry TERM/10/KILL/5
    rm -f "${PIDFILE}"
    ;;
  restart)
    "$0" stop
    "$0" start
    ;;
  status)
    start-stop-daemon --status --pidfile "${PIDFILE}"
    ;;
  *)
    echo "Usage: $0 {start|stop|restart|status}" >&2
    exit 2
    ;;
esac
