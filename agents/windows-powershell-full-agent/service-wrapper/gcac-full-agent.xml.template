<!--
  这是后续 WinSW 集成的占位模板。
  当前项目尚未分发 WinSW 可执行文件，因此这里只提供骨架，不在当前闭环中启用。
-->
<service>
  <id>GCAC_SERVICE_NAME</id>
  <name>GCAC_DISPLAY_NAME</name>
  <description>GCAC Windows PowerShell Full Agent</description>
  <executable>%SystemRoot%\System32\WindowsPowerShell\v1.0\powershell.exe</executable>
  <arguments>-NoProfile -ExecutionPolicy Bypass -File "C:\Program Files\GCAC\FullAgentPS\Start-GcacFullAgent.ps1" -ConfigPath "C:\ProgramData\GCAC\FullAgent\agent.config.json" -LogDir "C:\ProgramData\GCAC\FullAgent\logs"</arguments>
  <log mode="roll-by-size-time">
    <sizeThreshold>10240</sizeThreshold>
    <pattern>yyyyMMdd</pattern>
    <autoRollAtTime>00:00:00</autoRollAtTime>
  </log>
</service>
