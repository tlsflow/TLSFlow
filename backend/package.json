{
  "name": "gcac-backend",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "prebuild": "npm run clean && npm run check:utf8-mojibake",
    "build": "tsc -p tsconfig.json",
    "test": "npm run check:builtin-plugin-versions && npm run check:compatibility-architecture && npm run build && node --test \"dist/**/*.test.js\"",
    "test:unit": "npm run check:builtin-plugin-versions && npm run build && node --test \"dist/**/*.test.js\"",
    "test:integration": "npm run build && node --test \"dist/**/*.test.js\"",
    "generate:openapi": "npm run build && node dist/common/openapi/write-openapi.js",
    "check:openapi": "npm run generate:openapi && node --test \"dist/common/openapi/openapi.contract.test.js\"",
    "check:compatibility-architecture": "node ../scripts/compatibility/check-compatibility-architecture.mjs && node ../scripts/architecture/check-plugin-architecture.mjs && node ../scripts/architecture/check-deployment-input-architecture.mjs && node --test ../scripts/compatibility/check-compatibility-architecture.test.mjs ../scripts/architecture/check-plugin-architecture.test.mjs ../scripts/architecture/check-deployment-input-architecture.test.mjs ../scripts/compatibility/check-compatibility-governance.test.mjs && node ../scripts/compatibility/check-compatibility-governance.mjs",
    "check:compatibility-migration": "node ../scripts/compatibility/migrate-compatibility-profile-v1.mjs --check",
    "generate:compatibility": "node ../scripts/compatibility/generate-compatibility-catalog.mjs",
    "check:compatibility-docs": "node ../scripts/compatibility/generate-compatibility-catalog.mjs --check",
    "check:plugin-vendor-neutrality": "node ../scripts/architecture/check-plugin-architecture.mjs --preset vendor-neutrality --raw",
    "check:utf8-mojibake": "node ../scripts/quality/check-utf8-mojibake.mjs && node --test ../scripts/quality/check-utf8-mojibake.test.mjs",
    "check:builtin-plugin-versions": "node ../scripts/plugins/check-builtin-plugin-versions.mjs && node --test ../scripts/plugins/check-builtin-plugin-versions.test.mjs && tsx src/modules/plugins/builtin-plugins/builtin-plugin-package-ledger.ts && tsx --test src/modules/plugins/builtin-plugins/builtin-plugin-package-ledger.test.ts",
    "update:plugin-version": "node ../scripts/plugins/update-plugin-version.mjs",
    "update:builtin-plugin-package-ledger": "tsx src/modules/plugins/builtin-plugins/builtin-plugin-package-ledger.ts --update",
    "audit:managed-target-baseline": "node ../scripts/audits/audit-unified-managed-target-baseline.mjs",
    "audit:plugin-product-families": "node ../scripts/audits/audit-plugin-product-families.mjs",
    "migrate": "tsx src/database/migrate.ts",
    "migrate:prod": "node dist/database/migrate.js",
    "dev": "tsx watch src/main.ts",
    "start": "node dist/database/migrate.js && node dist/main.js",
    "start:no-migrate": "node dist/main.js"
  },
  "dependencies": {
    "@electric-sql/pglite": "0.5.1",
    "jsonata": "^2.2.1",
    "ldapts": "^8.1.8",
    "pg": "8.21.0",
    "ssh2": "^1.17.0"
  },
  "devDependencies": {
    "@types/node": "latest",
    "@types/pg": "latest",
    "@types/ssh2": "^1.15.5",
    "tsx": "latest",
    "typescript": "latest"
  }
}
