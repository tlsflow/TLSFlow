{
  "name": "gcac-backend",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run check:builtin-plugin-versions && npm run check:compatibility-architecture && npm run build && node --test \"dist/**/*.test.js\"",
    "test:unit": "npm run check:builtin-plugin-versions && npm run build && node --test \"dist/**/*.test.js\"",
    "test:integration": "npm run build && node --test \"dist/**/*.test.js\"",
    "generate:openapi": "npm run build && node dist/common/openapi/write-openapi.js",
    "check:openapi": "npm run generate:openapi && node --test \"dist/common/openapi/openapi.contract.test.js\"",
    "check:compatibility-architecture": "node ../scripts/check-compatibility-architecture.mjs && node --test ../scripts/check-compatibility-architecture.test.mjs ../scripts/check-compatibility-governance.test.mjs && node ../scripts/check-compatibility-governance.mjs",
    "check:compatibility-migration": "node ../scripts/migrate-compatibility-profile-v1.mjs --check",
    "generate:compatibility": "node ../scripts/generate-compatibility-catalog.mjs",
    "check:compatibility-docs": "node ../scripts/generate-compatibility-catalog.mjs --check",
    "check:plugin-vendor-neutrality": "node ../scripts/check-plugin-vendor-neutrality.mjs",
    "check:builtin-plugin-versions": "node ../scripts/check-builtin-plugin-versions.mjs && node --test ../scripts/check-builtin-plugin-versions.test.mjs",
    "migrate": "tsx src/database/migrate.ts",
    "migrate:prod": "node dist/database/migrate.js",
    "dev": "tsx watch src/main.ts",
    "start": "node dist/database/migrate.js && node dist/main.js",
    "start:no-migrate": "node dist/main.js"
  },
  "dependencies": {
    "jsonata": "^2.2.1",
    "ldapts": "^8.1.8",
    "ssh2": "^1.17.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "latest",
    "@types/node": "latest",
    "@types/pg": "latest",
    "@types/ssh2": "^1.15.5",
    "pg": "latest",
    "tsx": "latest",
    "typescript": "latest"
  }
}
