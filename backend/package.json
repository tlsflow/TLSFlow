{
  "name": "gcac-backend",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test \"dist/**/*.test.js\"",
    "test:unit": "npm run build && node --test \"dist/**/*.test.js\"",
    "test:integration": "npm run build && node --test \"dist/**/*.test.js\"",
    "generate:openapi": "npm run build && node dist/common/openapi/write-openapi.js",
    "check:openapi": "npm run generate:openapi && node --test \"dist/common/openapi/openapi.contract.test.js\"",
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js"
  },
  "dependencies": {
    "ldapts": "^8.1.8",
    "ssh2": "^1.17.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "latest",
    "@types/node": "latest",
    "@types/pg": "latest",
    "@types/ssh2": "^1.15.5",
    "pg": "latest",
    "tsx": "latest",
    "typescript": "latest"
  }
}
