{
  "name": "gcac-backend",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "prebuild": "npm run clean && npm run check:utf8-mojibake",
    "build": "tsc -p tsconfig.json && node scripts/copy-runtime-resources.mjs",
    "test:files": "node scripts/run-node-test-files.mjs --root dist --serial --require-test-secret",
    "test:p1": "node scripts/run-p1-test-suite.mjs --root dist --require-test-secret",
    "test:p2": "node scripts/run-p2-test-suite.mjs --build --root dist --require-test-secret",
    "test:isolated": "node scripts/run-node-test-files.mjs --build-isolated --serial --require-test-secret",
    "test:runner": "node --test scripts/run-node-test-files.test.mjs scripts/run-node-test-shards.test.mjs scripts/copy-runtime-resources.test.mjs",
    "test": "npm run check:builtin-plugin-versions && npm run check:compatibility-architecture && npm run test:full",
    "test:unit": "npm run check:builtin-plugin-versions && npm run test:full",
    "test:integration": "npm run test:full",
    "test:full": "node scripts/run-node-test-shards.mjs --build-isolated --require-test-secret --shard-count 2 --max-parallel 2 --file-timeout-ms 360000",
    "check:plugin-architecture:zero": "node ../scripts/architecture/check-plugin-architecture.mjs --require-zero",
    "generate:openapi": "npm run build && node dist/common/openapi/write-openapi.js",
    "check:openapi": "npm run generate:openapi && node --test \"dist/common/openapi/openapi.contract.test.js\"",
    "check:compatibility-architecture": "node ../scripts/compatibility/check-compatibility-architecture.mjs && node ../scripts/architecture/check-plugin-architecture.mjs && node ../scripts/architecture/check-deployment-input-architecture.mjs && node --test ../scripts/compatibility/check-compatibility-architecture.test.mjs ../scripts/architecture/check-plugin-architecture.test.mjs ../scripts/architecture/check-deployment-input-architecture.test.mjs",
    "check:plugin-vendor-neutrality": "node ../scripts/architecture/check-plugin-architecture.mjs --preset vendor-neutrality --raw",
    "check:utf8-mojibake": "node ../scripts/quality/check-utf8-mojibake.mjs && node --test ../scripts/quality/check-utf8-mojibake.test.mjs",
    "check:builtin-plugin-versions": "node ../scripts/plugins/check-builtin-plugin-versions.mjs && node --test ../scripts/plugins/check-builtin-plugin-versions.test.mjs && tsx src/modules/plugins/builtin-plugins/builtin-plugin-package-ledger.ts && tsx --test src/modules/plugins/builtin-plugins/builtin-plugin-package-ledger.test.ts",
    "update:plugin-version": "node ../scripts/plugins/update-plugin-version.mjs",
    "update:builtin-plugin-package-ledger": "tsx src/modules/plugins/builtin-plugins/builtin-plugin-package-ledger.ts --update",
    "audit:managed-target-baseline": "node ../scripts/audits/audit-unified-managed-target-baseline.mjs",
    "audit:plugin-product-families": "node ../scripts/audits/audit-plugin-product-families.mjs",
    "cutover:dev": "tsx src/database/development-database-cutover.ts",
    "migrate": "tsx src/database/migrate.ts",
    "migrate:prod": "node dist/database/migrate.js",
    "dev": "tsx watch src/main.ts",
    "start": "node dist/database/migrate.js && node dist/main.js",
    "start:no-migrate": "node dist/main.js"
  },
  "dependencies": {
    "@electric-sql/pglite": "0.5.1",
    "ali-oss": "^6.23.0",
    "jsonata": "^2.2.1",
    "ldapts": "^8.1.8",
    "node-forge": "^1.3.1",
    "pg": "8.21.0",
    "ssh2": "^1.17.0",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@types/node": "latest",
    "@types/node-forge": "^1.3.14",
    "@types/pg": "latest",
    "@types/ssh2": "^1.15.5",
    "@types/ws": "^8.18.1",
    "tsx": "latest",
    "typescript": "latest"
  }
}
