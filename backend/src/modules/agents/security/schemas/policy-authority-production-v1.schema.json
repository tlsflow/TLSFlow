{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "gcac://policy-authority-production/v1",
  "title": "GCAC Policy Authority 生产部署配置 v1",
  "type": "object",
  "additionalProperties": true,
  "$defs": {
    "requiredText": { "type": "string", "minLength": 1 },
    "absolutePath": { "type": "string", "minLength": 1, "pattern": "^(?:[A-Za-z]:[\\\\/]|[\\\\/]{1,2})" },
    "jsonText": { "type": "string", "minLength": 2 },
    "fingerprint": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  },
  "properties": {
    "NODE_ENV": { "const": "production" },
    "GCAC_POLICY_AUTHORITY_PROCESS_ROLE": { "enum": ["host", "standalone"] },
    "GCAC_POLICY_AUTHORITY_EXECUTABLE_PATH": { "$ref": "#/$defs/absolutePath" },
    "GCAC_POLICY_AUTHORITY_WORKING_DIRECTORY": { "$ref": "#/$defs/absolutePath" },
    "GCAC_POLICY_AUTHORITY_ARGS_JSON": { "$ref": "#/$defs/jsonText" },
    "GCAC_POLICY_AUTHORITY_ROOT_KEY_ID": { "$ref": "#/$defs/requiredText" },
    "GCAC_POLICY_AUTHORITY_ID": { "$ref": "#/$defs/requiredText" },
    "GCAC_POLICY_AUTHORITY_ROOT_PUBLIC_KEY_PEM": { "type": "string", "pattern": "BEGIN PUBLIC KEY" },
    "GCAC_POLICY_AUTHORITY_ROOT_FINGERPRINT_SHA256": { "$ref": "#/$defs/fingerprint" },
    "GCAC_POLICY_AUTHORITY_BOOTSTRAP_JSON": { "$ref": "#/$defs/jsonText" },
    "GCAC_POLICY_AUTHORITY_KEYSET_JSON": { "$ref": "#/$defs/jsonText" },
    "GCAC_POLICY_AUTHORITY_SIGNING_KEYS_JSON": { "$ref": "#/$defs/jsonText" },
    "GCAC_POLICY_AUTHORITY_POLICY_BUNDLE_JSON": { "$ref": "#/$defs/jsonText" },
    "GCAC_POLICY_AUTHORITY_STATE_FILE": { "$ref": "#/$defs/absolutePath" }
  },
  "oneOf": [
    {
      "required": [
        "NODE_ENV", "GCAC_POLICY_AUTHORITY_PROCESS_ROLE", "GCAC_POLICY_AUTHORITY_EXECUTABLE_PATH",
        "GCAC_POLICY_AUTHORITY_WORKING_DIRECTORY", "GCAC_POLICY_AUTHORITY_ARGS_JSON",
        "GCAC_POLICY_AUTHORITY_ROOT_KEY_ID", "GCAC_POLICY_AUTHORITY_ID",
        "GCAC_POLICY_AUTHORITY_ROOT_PUBLIC_KEY_PEM", "GCAC_POLICY_AUTHORITY_ROOT_FINGERPRINT_SHA256",
        "GCAC_POLICY_AUTHORITY_BOOTSTRAP_JSON", "GCAC_POLICY_AUTHORITY_KEYSET_JSON",
        "GCAC_POLICY_AUTHORITY_SIGNING_KEYS_JSON", "GCAC_POLICY_AUTHORITY_POLICY_BUNDLE_JSON",
        "GCAC_POLICY_AUTHORITY_STATE_FILE"
      ],
      "properties": { "GCAC_POLICY_AUTHORITY_PROCESS_ROLE": { "const": "host" } }
    },
    {
      "required": [
        "NODE_ENV", "GCAC_POLICY_AUTHORITY_PROCESS_ROLE", "GCAC_POLICY_AUTHORITY_ROOT_KEY_ID",
        "GCAC_POLICY_AUTHORITY_ID", "GCAC_POLICY_AUTHORITY_ROOT_PUBLIC_KEY_PEM",
        "GCAC_POLICY_AUTHORITY_ROOT_FINGERPRINT_SHA256", "GCAC_POLICY_AUTHORITY_BOOTSTRAP_JSON",
        "GCAC_POLICY_AUTHORITY_KEYSET_JSON", "GCAC_POLICY_AUTHORITY_SIGNING_KEYS_JSON",
        "GCAC_POLICY_AUTHORITY_POLICY_BUNDLE_JSON", "GCAC_POLICY_AUTHORITY_STATE_FILE"
      ],
      "properties": { "GCAC_POLICY_AUTHORITY_PROCESS_ROLE": { "const": "standalone" } }
    }
  ]
}
