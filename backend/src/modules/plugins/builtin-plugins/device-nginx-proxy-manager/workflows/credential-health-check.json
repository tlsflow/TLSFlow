{
  "apiVersion": "gcac.workflow/v1",
  "kind": "CurlSshWorkflow",
  "metadata": { "name": "nginx-proxy-manager-credential-health-check", "displayName": "Nginx Proxy Manager credential health check", "category": "device", "version": "0.1.12", "platforms": ["proxy"], "updateMethods": ["curl"], "maintainer": "GCAC 用户插件" },
  "inputContract": {
    "apiVersion": "gcac.deployment-input/v1",
    "variables": {
      "allowInsecureTls": { "type": "boolean", "required": true, "configurationMode": "required", "source": { "kind": "binding" }, "lifecycle": "pre_execution", "bindingPolicy": "required_binding", "descriptionKey": "deploymentInputs.allowInsecureTls.description", "ui": { "labelKey": "deploymentInputs.allowInsecureTls.label", "group": "security", "order": 10, "helpKey": "deploymentInputs.allowInsecureTls.help" } }
    },
    "connections": {
      "management": {
        "transport": "http",
        "allowedProtocols": ["http", "https"],
        "host": { "type": "string", "required": true, "configurationMode": "required", "source": { "kind": "binding" }, "lifecycle": "pre_execution", "bindingPolicy": "required_binding" },
        "port": { "type": "number", "required": true, "configurationMode": "advanced", "source": { "kind": "default" }, "lifecycle": "pre_execution", "bindingPolicy": "default_overridable", "default": 443 },
        "credentialSlot": "credential",
        "tls": { "enabled": { "type": "boolean", "required": true, "configurationMode": "advanced", "source": { "kind": "default" }, "lifecycle": "pre_execution", "bindingPolicy": "default_overridable", "default": true }, "verifyPeer": { "type": "boolean", "required": true, "configurationMode": "advanced", "source": { "kind": "default" }, "lifecycle": "pre_execution", "bindingPolicy": "default_overridable", "default": true }, "serverName": { "type": "string", "required": false, "configurationMode": "advanced", "source": { "kind": "binding" }, "lifecycle": "pre_execution", "bindingPolicy": "default_overridable", "default": "" } }
      }
    },
    "credentials": { "credential": { "allowedKinds": ["USERNAME_PASSWORD"], "required": true, "configurationMode": "required", "lifecycle": "pre_execution" } },
    "artifacts": {}
  },
  "steps": [
    {
      "name": "authenticate",
      "type": "http",
      "stage": "prepare",
      "request": { "method": "POST", "connectionRef": "management", "url": "/api/tokens", "bodyType": "form", "form": { "identity": "{{credentials.credential.username}}" }, "formCredentialRefs": { "secret": "{{credentials.credential}}" }, "headers": { "Accept": "application/json" }, "tls": { "verify": "{{connections.management.tls.verifyPeer}}", "sni": "{{connections.management.tls.serverName}}", "allowInsecure": true }, "timeoutSeconds": 30, "maxResponseBytes": 1048576, "failOnNon2xx": false },
      "extract": [
        { "name": "authStatusCode", "type": "statusCode" },
        { "name": "token", "type": "jsonPath", "path": "$.token", "optional": true, "sensitive": true }
      ]
    },
    {
      "name": "classifyAuthentication",
      "type": "transform",
      "stage": "verify",
      "transform": {
        "engine": "jsonata",
        "input": { "statusCode": "{{steps.authenticate.extracted.authStatusCode}}", "token": "{{steps.authenticate.extracted.token}}" },
        "outputs": {
          "credentialHealth": {
            "expression": "statusCode = 200 and $exists(token) and $string(token) != '' ? {'apiVersion':'gcac.credential-health-result/v1','status':'VALID','summary':'NPM 用户名密码认证成功','evidence':{'protocol':'NPM_API','httpStatus':statusCode}} : (statusCode = 401 or statusCode = 403 ? {'apiVersion':'gcac.credential-health-result/v1','status':'ERROR','reasonCode':'PASSWORD_INVALID','summary':'NPM 拒绝用户名或密码','evidence':{'protocol':'NPM_API','httpStatus':statusCode}} : (statusCode >= 500 and statusCode <= 599 ? {'apiVersion':'gcac.credential-health-result/v1','status':'UNREACHABLE','reasonCode':'REMOTE_SERVICE_ERROR','summary':'设备远端服务暂时不可用','evidence':{'protocol':'NPM_API','httpStatus':statusCode}} : {'apiVersion':'gcac.credential-health-result/v1','status':'ERROR','reasonCode':'CHECK_RESULT_INVALID','summary':'NPM 登录响应缺少 Token','evidence':{'protocol':'NPM_API','httpStatus':statusCode}}))"
          }
        },
        "timeoutMs": 1000,
        "maxInputBytes": 1048576,
        "maxOutputBytes": 65536
      }
    }
  ]
}
