{
  "apiVersion": "gcac.workflow/v1",
  "kind": "CurlSshWorkflow",
  "metadata": {
    "name": "nginx-proxy-manager-connection-test",
    "displayName": "Nginx Proxy Manager connection test",
    "category": "device",
    "version": "0.1.11",
    "platforms": ["proxy"],
    "updateMethods": ["curl"],
    "maintainer": "GCAC 用户插件"
  },
  "inputContract": {
    "apiVersion": "gcac.deployment-input/v1",
    "variables": {
      "allowInsecureTls": {
        "type": "boolean",
        "required": true,
        "configurationMode": "required",
        "source": { "kind": "binding" },
        "lifecycle": "pre_execution",
        "bindingPolicy": "required_binding",
        "descriptionKey": "deploymentInputs.allowInsecureTls.description",
        "ui": {
          "labelKey": "deploymentInputs.allowInsecureTls.label",
          "group": "security",
          "order": 10,
          "helpKey": "deploymentInputs.allowInsecureTls.help"
        }
      }
    },
    "connections": {
      "management": {
        "transport": "http",
        "allowedProtocols": ["http", "https"],
        "host": { "type": "string", "required": true, "configurationMode": "required", "source": { "kind": "binding" }, "lifecycle": "pre_execution", "bindingPolicy": "required_binding" },
        "port": { "type": "number", "required": true, "configurationMode": "advanced", "source": { "kind": "default" }, "lifecycle": "pre_execution", "bindingPolicy": "default_overridable", "default": 443 },
        "credentialSlot": "credential",
        "tls": {
          "enabled": { "type": "boolean", "required": true, "configurationMode": "advanced", "source": { "kind": "default" }, "lifecycle": "pre_execution", "bindingPolicy": "default_overridable", "default": true },
          "verifyPeer": { "type": "boolean", "required": true, "configurationMode": "advanced", "source": { "kind": "default" }, "lifecycle": "pre_execution", "bindingPolicy": "default_overridable", "default": true },
          "serverName": { "type": "string", "required": false, "configurationMode": "advanced", "source": { "kind": "binding" }, "lifecycle": "pre_execution", "bindingPolicy": "default_overridable", "default": "" }
        }
      }
    },
    "credentials": {
      "credential": { "allowedKinds": ["USERNAME_PASSWORD"], "required": true, "configurationMode": "required", "lifecycle": "pre_execution" }
    },
    "artifacts": {}
  },
  "steps": [
    {
      "name": "checkManagementPort",
      "type": "http",
      "stage": "prepare",
      "request": {
        "method": "GET",
        "connectionRef": "management",
        "url": "/",
        "headers": { "Accept": "application/json" },
        "tls": { "verify": "{{connections.management.tls.verifyPeer}}", "sni": "{{connections.management.tls.serverName}}", "allowInsecure": true },
        "timeoutSeconds": 30,
        "maxResponseBytes": 4194304,
        "successStatusCodes": [200, 301, 302, 401, 403, 404]
      }
    }
  ]
}
