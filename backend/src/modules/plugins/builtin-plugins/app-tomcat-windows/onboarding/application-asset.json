{
  "protocol": "gcac.application-onboarding/v1",
  "platformKey": "app.tomcat.windows",
  "displayNameKey": "plugin.appTomcatWindows.name",
  "platformMetadata": {
    "capabilityVersion": "v1",
    "compatibilityKeys": ["plugin.appTomcatWindows.onboarding.compatibility"],
    "requiredInformationKeys": ["plugin.appTomcatWindows.onboarding.requiredHost", "plugin.appTomcatWindows.onboarding.requiredTarget"]
  },
  "supportStatus": "SUPPORTED",
  "deploymentMode": "MANAGED_TARGET",
  "deviceResourceType": "device.windows-server",
  "deviceSelection": "EXISTING_OR_NEW",
  "newDeviceOnboarding": { "kind": "AGENT_INSTALL", "platformKey": "windows-server-2016-plus" },
  "forms": {},
  "capabilities": {
    "connectionTest": "certificate.verify",
    "discovery": "certificate.verify"
  },
  "targetProjection": {
    "targetType": "tls.binding",
    "frameworkTypes": ["app.tomcat"],
    "displayFields": ["displayName", "endpoint.port", "frameworkType"],
    "identityFields": ["managedTargetId", "configFingerprint"],
    "selectableWhen": "selectable"
  },
  "deploymentDefaults": {
    "capabilityKey": "certificate.deploy",
    "variables": {}
  },
  "certificate": {
    "acceptedFormats": ["PFX", "JKS"],
    "requiredArtifacts": ["keystore"],
    "defaultVersion": "LATEST_VALID"
  },
  "commit": { "executionSource": "PLUGIN", "inputContract": "certificate.deploy.v1" }
}
