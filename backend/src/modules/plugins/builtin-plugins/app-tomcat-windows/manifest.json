{
  "apiVersion": "gcac.plugin-manifest/v1",
  "kind": "GcacPlugin",
  "pluginId": "app.tomcat.windows",
  "version": "1.0.9",
  "displayNameKey": "plugin.appTomcatWindows.name",
  "descriptionKey": "plugin.appTomcatWindows.description",
  "defaultLocale": "zh-CN",
  "publisher": "GCAC",
  "runtime": "WORKFLOW_DSL",
  "source": "BUILTIN",
  "scope": "MANAGED",
  "trust": "OFFICIAL_SIGNED",
  "support": "OFFICIAL",
  "capabilities": [
    {
      "key": "certificate.deploy",
      "contractVersion": "v1",
      "actionContractId": "certificate.deploy.v1",
      "riskLevel": "HIGH",
      "executionLocations": [
        "AGENT"
      ]
    },
    {
      "key": "certificate.verify",
      "contractVersion": "v1",
      "actionContractId": "certificate.verify.v1",
      "riskLevel": "MEDIUM",
      "executionLocations": [
        "AGENT"
      ]
    },
    {
      "key": "certificate.rollback",
      "contractVersion": "v1",
      "actionContractId": "certificate.rollback.v1",
      "riskLevel": "HIGH",
      "executionLocations": [
        "AGENT"
      ]
    }
  ],
  "permissions": [
    "agent.plan.validate",
    "agent.plan.execute",
    "agent.execution.receipt"
  ],
  "compatibility": {
    "productFamilies": [
      "WINDOWS_SERVER"
    ],
    "frameworkTypes": [
      "app.tomcat"
    ],
    "targetTypes": [
      "tls.binding"
    ],
    "managementMethods": [
      "AGENT"
    ],
    "executionLocations": [
      "AGENT"
    ],
    "artifactContracts": [
      "certificate.deploy.v1"
    ]
  },
  "resources": {
    "logos": {
      "horizontal": "logos/logo.svg",
      "square": "logos/logo-square.svg"
    },
    "inputContracts": {
      "certificate.deploy": "contracts/deploy.json",
      "certificate.verify": "contracts/verify.json",
      "certificate.rollback": "contracts/rollback.json"
    },
    "workflows": {
      "certificate.deploy": "workflows/deploy.json",
      "certificate.verify": "workflows/verify.json",
      "certificate.rollback": "workflows/rollback.json"
    },
    "agentPlans": {
      "certificate.deploy": "agent-plans/deploy.json",
      "certificate.verify": "agent-plans/verify.json",
      "certificate.rollback": "agent-plans/rollback.json"
    },
    "locales": {
      "zh-CN": "locales/zh-CN.json",
      "zh-TW": "locales/zh-TW.json",
      "en-US": "locales/en-US.json",
      "ja-JP": "locales/ja-JP.json",
      "ko-KR": "locales/ko-KR.json",
      "fr-FR": "locales/fr-FR.json",
      "ru-RU": "locales/ru-RU.json",
      "pt-BR": "locales/pt-BR.json"
    },
    "presentations": {
      "application": "presentations/application.json",
      "certificate-binding": "presentations/certificate-binding.json"
    },
    "onboarding": { "applicationAsset": "onboarding/application-asset.json" }
  }
}
