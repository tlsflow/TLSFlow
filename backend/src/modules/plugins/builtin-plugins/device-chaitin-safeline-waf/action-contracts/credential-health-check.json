{
  "apiVersion": "gcac.plugin-action-contract/v1",
  "actionId": "credential.health-check.v1",
  "capability": "credential.health-check",
  "actionContractVersion": "v1",
  "inputSchema": {
    "type": "object",
    "required": ["deviceAddress", "credential"],
    "properties": {
      "deviceAddress": { "type": "string", "minLength": 1, "maxLength": 512 },
      "credential": {
        "type": "object",
        "required": ["secretRef"],
        "properties": { "secretRef": { "type": "string", "pattern": "^secret://[A-Za-z0-9._:/#-]{1,512}$" } },
        "additionalProperties": false
      }
    },
    "additionalProperties": false
  },
  "outputSchema": {
    "type": "object",
    "required": ["apiVersion", "status"],
    "properties": {
      "apiVersion": { "const": "gcac.credential-health-result/v1" },
      "status": { "enum": ["VALID", "ERROR", "UNREACHABLE"] },
      "reasonCode": { "type": "string", "maxLength": 64 },
      "summary": { "type": "string", "maxLength": 300 },
      "evidence": { "type": "object", "additionalProperties": true }
    },
    "additionalProperties": false
  },
  "writeEffect": false,
  "hostPermissions": ["secret.resolve", "network.http"]
}
