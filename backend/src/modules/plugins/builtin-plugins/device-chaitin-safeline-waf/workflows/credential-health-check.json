{
  "apiVersion": "gcac.workflow/v1",
  "kind": "CurlSshWorkflow",
  "metadata": { "name": "chaitin-safeline-waf-credential-health-check", "displayName": "SafeLine credential health check", "category": "device", "version": "0.1.13", "platforms": ["waf"], "updateMethods": ["curl"], "maintainer": "GCAC" },
  "inputContract": {
    "apiVersion": "gcac.deployment-input/v1",
    "variables": {
      "allowInsecureTls": { "type": "boolean", "required": true, "configurationMode": "required", "source": { "kind": "binding" }, "lifecycle": "pre_execution", "bindingPolicy": "required_binding", "descriptionKey": "deploymentInputs.allowInsecureTls.description", "ui": { "labelKey": "deploymentInputs.allowInsecureTls.label", "group": "security", "order": 10, "helpKey": "deploymentInputs.allowInsecureTls.help" } }
    },
    "connections": {
      "management": {
        "transport": "http",
        "allowedProtocols": ["http", "https"],
        "host": { "type": "string", "required": true, "configurationMode": "required", "source": { "kind": "binding" }, "lifecycle": "pre_execution", "bindingPolicy": "required_binding" },
        "port": { "type": "number", "required": true, "configurationMode": "advanced", "source": { "kind": "default" }, "lifecycle": "pre_execution", "bindingPolicy": "default_overridable", "default": 9443 },
        "credentialSlot": "credential",
        "tls": { "enabled": { "type": "boolean", "required": true, "configurationMode": "advanced", "source": { "kind": "default" }, "lifecycle": "pre_execution", "bindingPolicy": "default_overridable", "default": true }, "verifyPeer": { "type": "boolean", "required": true, "configurationMode": "advanced", "source": { "kind": "default" }, "lifecycle": "pre_execution", "bindingPolicy": "default_overridable", "default": true }, "serverName": { "type": "string", "required": false, "configurationMode": "advanced", "source": { "kind": "binding" }, "lifecycle": "pre_execution", "bindingPolicy": "default_overridable", "default": "" } }
      }
    },
    "credentials": { "credential": { "allowedKinds": ["API_KEY"], "required": true, "configurationMode": "required", "lifecycle": "pre_execution" } },
    "artifacts": {}
  },
  "steps": [
    {
      "name": "authenticate",
      "type": "http",
      "stage": "prepare",
      "request": { "method": "GET", "connectionRef": "management", "url": "/api/open/system", "auth": { "type": "api_key", "name": "X-SLCE-API-TOKEN", "in": "header", "credential": "{{credentials.credential}}" }, "headers": { "Accept": "application/json" }, "tls": { "verify": "{{connections.management.tls.verifyPeer}}", "sni": "{{connections.management.tls.serverName}}", "allowInsecure": true }, "timeoutSeconds": 30, "maxResponseBytes": 1048576, "failOnNon2xx": false },
      "extract": [{ "name": "authStatusCode", "type": "statusCode" }]
    },
    {
      "name": "classifyAuthentication",
      "type": "transform",
      "stage": "verify",
      "transform": {
        "engine": "jsonata",
        "input": { "statusCode": "{{steps.authenticate.extracted.authStatusCode}}" },
        "outputs": {
          "credentialHealth": {
            "expression": "statusCode = 200 ? {'apiVersion':'gcac.credential-health-result/v1','status':'VALID','summary':'API Token 有效','evidence':{'protocol':'SAFELINE_OPEN_API','httpStatus':statusCode}} : (statusCode = 401 or statusCode = 403 ? {'apiVersion':'gcac.credential-health-result/v1','status':'ERROR','reasonCode':'TOKEN_REJECTED','summary':'设备拒绝 API Token','evidence':{'protocol':'SAFELINE_OPEN_API','httpStatus':statusCode}} : (statusCode >= 500 and statusCode <= 599 ? {'apiVersion':'gcac.credential-health-result/v1','status':'UNREACHABLE','reasonCode':'REMOTE_SERVICE_ERROR','summary':'设备远端服务暂时不可用','evidence':{'protocol':'SAFELINE_OPEN_API','httpStatus':statusCode}} : {'apiVersion':'gcac.credential-health-result/v1','status':'ERROR','reasonCode':'CHECK_RESULT_INVALID','summary':'设备返回无法分类的检测结果','evidence':{'protocol':'SAFELINE_OPEN_API','httpStatus':statusCode}}))"
          }
        },
        "timeoutMs": 1000,
        "maxInputBytes": 1048576,
        "maxOutputBytes": 65536
      }
    }
  ]
}
