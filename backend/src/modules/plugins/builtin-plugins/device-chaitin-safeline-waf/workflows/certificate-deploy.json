{
  "apiVersion": "gcac.workflow/v1",
  "kind": "CurlSshWorkflow",
  "metadata": {
    "name": "chaitin-safeline-waf-certificate-deploy",
    "displayName": "SafeLine certificate deployment",
    "category": "certificate",
    "version": "0.1.11",
    "platforms": [
      "waf"
    ],
    "updateMethods": [
      "curl"
    ],
    "maintainer": "GCAC 用户插件"
  },
  "inputContract": {
    "apiVersion": "gcac.deployment-input/v1",
    "variables": {
      "targetSites": {
        "type": "array",
        "required": true,
        "configurationMode": "runtime",
        "source": {
          "kind": "asset",
          "path": "deployment.targets"
        },
        "lifecycle": "pre_execution",
        "bindingPolicy": "fixed"
      },
      "allowInsecureTls": {
        "type": "boolean",
        "required": true,
        "configurationMode": "required",
        "source": {
          "kind": "binding"
        },
        "lifecycle": "pre_execution",
        "bindingPolicy": "required_binding",
        "descriptionKey": "deploymentInputs.allowInsecureTls.description",
        "ui": {
          "labelKey": "deploymentInputs.allowInsecureTls.label",
          "group": "security",
          "order": 10,
          "helpKey": "deploymentInputs.allowInsecureTls.help"
        }
      },
      "recoverySnapshot": {
        "type": "object",
        "required": false,
        "configurationMode": "advanced",
        "source": {
          "kind": "binding"
        },
        "lifecycle": "pre_execution",
        "bindingPolicy": "default_overridable",
        "sensitive": true
      },
      "recoverySnapshotHash": {
        "type": "string",
        "required": false,
        "configurationMode": "advanced",
        "source": {
          "kind": "binding"
        },
        "lifecycle": "pre_execution",
        "bindingPolicy": "default_overridable"
      }
    },
    "connections": {
      "management": {
        "transport": "http",
        "allowedProtocols": [
          "http",
          "https"
        ],
        "host": {
          "type": "string",
          "required": true,
          "configurationMode": "required",
          "source": {
            "kind": "binding"
          },
          "lifecycle": "pre_execution",
          "bindingPolicy": "required_binding"
        },
        "port": {
          "type": "number",
          "required": true,
          "configurationMode": "advanced",
          "source": {
            "kind": "default"
          },
          "lifecycle": "pre_execution",
          "bindingPolicy": "default_overridable",
          "default": 9443
        },
        "credentialSlot": "credential",
        "tls": {
          "enabled": {
            "type": "boolean",
            "required": true,
            "configurationMode": "advanced",
            "source": {
              "kind": "default"
            },
            "lifecycle": "pre_execution",
            "bindingPolicy": "default_overridable",
            "default": true
          },
          "verifyPeer": {
            "type": "boolean",
            "required": true,
            "configurationMode": "advanced",
            "source": {
              "kind": "default"
            },
            "lifecycle": "pre_execution",
            "bindingPolicy": "default_overridable",
            "default": true
          },
          "serverName": {
            "type": "string",
            "required": false,
            "configurationMode": "advanced",
            "source": {
              "kind": "binding"
            },
            "lifecycle": "pre_execution",
            "bindingPolicy": "default_overridable",
            "default": ""
          }
        }
      }
    },
    "credentials": {
      "credential": {
        "allowedKinds": [
          "API_KEY"
        ],
        "required": true,
        "configurationMode": "required",
        "lifecycle": "pre_execution"
      }
    },
    "artifacts": {
      "certificate": {
        "kind": "certificate",
        "required": true,
        "configurationMode": "required",
        "lifecycle": "pre_execution",
        "artifactContract": {
          "outputs": {
            "leafPem": {
              "role": "public_certificate",
              "required": true,
              "format": "PEM",
              "encoding": "UTF-8"
            },
            "privateKeyPem": {
              "role": "private_key",
              "required": true,
              "format": "PEM",
              "encoding": "UTF-8",
              "sensitive": true
            },
            "orderedChainPem": {
              "role": "certificate_chain",
              "required": false,
              "format": "PEM",
              "encoding": "UTF-8"
            },
            "fingerprintSha256": {
              "role": "fingerprint_sha256",
              "required": true,
              "format": "HEX",
              "encoding": "UTF-8"
            }
          }
        }
      }
    }
  },
  "steps": [
    {
      "name": "readSystem",
      "type": "http",
      "stage": "prepare",
      "request": {
        "method": "GET",
        "connectionRef": "management",
        "url": "/api/open/system",
        "auth": {
          "type": "api_key",
          "name": "X-SLCE-API-TOKEN",
          "in": "header",
          "credential": "{{credentials.credential}}"
        },
        "headers": {
          "Accept": "application/json"
        },
        "tls": {
          "verify": "{{connections.management.tls.verifyPeer}}",
          "sni": "{{connections.management.tls.serverName}}",
          "allowInsecure": true
        },
        "timeoutSeconds": 30,
        "maxResponseBytes": 1048576,
        "successStatusCodes": [
          200
        ]
      },
      "extract": [
        {
          "name": "system",
          "type": "jsonPath",
          "path": "$.data"
        }
      ],
      "assert": [
        {
          "type": "statusCode",
          "equals": 200
        }
      ]
    },
    {
      "name": "readCertificates",
      "type": "http",
      "stage": "backup",
      "request": {
        "method": "GET",
        "connectionRef": "management",
        "url": "/api/open/cert",
        "auth": {
          "type": "api_key",
          "name": "X-SLCE-API-TOKEN",
          "in": "header",
          "credential": "{{credentials.credential}}"
        },
        "headers": {
          "Accept": "application/json"
        },
        "tls": {
          "verify": "{{connections.management.tls.verifyPeer}}",
          "sni": "{{connections.management.tls.serverName}}",
          "allowInsecure": true
        },
        "timeoutSeconds": 30,
        "maxResponseBytes": 4194304,
        "successStatusCodes": [
          200
        ]
      },
      "extract": [
        {
          "name": "certificates",
          "type": "jsonPath",
          "path": "$.data.nodes"
        }
      ],
      "assert": [
        {
          "type": "statusCode",
          "equals": 200
        }
      ]
    },
    {
      "name": "readCertificateDetails",
      "type": "foreach",
      "stage": "backup",
      "foreach": {
        "itemsPath": "steps.readCertificates.extracted.certificates",
        "itemVariable": "certificate",
        "maxItems": 1000,
        "steps": [
          {
            "name": "readCertificate",
            "type": "http",
            "request": {
              "method": "GET",
              "connectionRef": "management",
              "url": "/api/open/cert/{{certificate.id}}",
              "auth": {
                "type": "api_key",
                "name": "X-SLCE-API-TOKEN",
                "in": "header",
                "credential": "{{credentials.credential}}"
              },
              "headers": {
                "Accept": "application/json"
              },
              "tls": {
                "verify": "{{connections.management.tls.verifyPeer}}",
                "sni": "{{connections.management.tls.serverName}}",
                "allowInsecure": true
              },
              "timeoutSeconds": 30,
              "maxResponseBytes": 4194304,
              "successStatusCodes": [
                200
              ]
            },
            "extract": [
              {
                "name": "certificateId",
                "type": "jsonPath",
                "path": "$.data.id",
                "optional": true
              },
              {
                "name": "crt",
                "type": "jsonPath",
                "path": "$.data.manual.crt",
                "sensitive": true
              },
              {
                "name": "key",
                "type": "jsonPath",
                "path": "$.data.manual.key",
                "sensitive": true
              }
            ],
            "assert": [
              {
                "type": "statusCode",
                "equals": 200
              }
            ]
          }
        ]
      }
    },
    {
      "name": "readSites",
      "type": "http",
      "stage": "backup",
      "request": {
        "method": "GET",
        "connectionRef": "management",
        "url": "/api/open/site",
        "auth": {
          "type": "api_key",
          "name": "X-SLCE-API-TOKEN",
          "in": "header",
          "credential": "{{credentials.credential}}"
        },
        "headers": {
          "Accept": "application/json"
        },
        "tls": {
          "verify": "{{connections.management.tls.verifyPeer}}",
          "sni": "{{connections.management.tls.serverName}}",
          "allowInsecure": true
        },
        "timeoutSeconds": 30,
        "maxResponseBytes": 4194304,
        "successStatusCodes": [
          200
        ]
      },
      "extract": [
        {
          "name": "content",
          "type": "jsonPath",
          "path": "$.data.data"
        }
      ],
      "assert": [
        {
          "type": "statusCode",
          "equals": 200
        }
      ]
    },
    {
      "name": "selectTargets",
      "type": "transform",
      "stage": "backup",
      "transform": {
        "engine": "jsonata",
        "input": {
          "sites": "{{steps.readSites.extracted.content}}",
          "targets": "{{variables.targetSites}}",
          "system": "{{steps.readSystem.extracted.system}}"
        },
        "outputs": {
          "selected": {
            "expression": "($sites := $append([],sites); $ids := $map($append([],targets),function($target) { $string($target.metadata.safeLineSiteId ? $target.metadata.safeLineSiteId : $replace($string($target.targetKey),/^site:/,'')) }); $append([], $map($filter($sites,function($site) { $string($site.id) in $ids }),function($site) { {'siteId':$site.id,'oldCertificateId':$site.cert_id,'site':{'id':$site.id,'comment':$site.comment,'email':$site.email,'group_id':$site.group_id,'health_check':$site.health_check,'index':$site.index,'load_balance':$site.load_balance,'ports':$site.ports,'redirect_status_code':$site.redirect_status_code,'server_names':$site.server_names,'stat_enabled':$site.stat_enabled,'static_default':$site.static_default,'type':$site.type,'upstreams':$site.upstreams}} })))"
          },
          "hasTargets": {
            "expression": "($sites := $append([],sites); $targetList := $append([],targets); $ids := $map($targetList,function($target) { $string($target.metadata.safeLineSiteId ? $target.metadata.safeLineSiteId : $replace($string($target.targetKey),/^site:/,'')) }); $defaultTargets := $filter($targetList,function($target) { $boolean($target.metadata.abstract) or $string($target.targetKey) = 'Default' }); ($count($filter($sites,function($site) { $string($site.id) in $ids })) > 0) or ($count($defaultTargets) > 0 and $exists(system.cert_id) and $string(system.cert_id) != '') )"
          },
          "defaultTargetSelected": {
            "expression": "($targetList := $append([],targets); $count($filter($targetList,function($target) { $boolean($target.metadata.abstract) or $string($target.targetKey) = 'Default' })) > 0)"
          },
          "defaultCertificateId": {
            "expression": "system.cert_id"
          },
          "snapshot": {
            "expression": "{'bindings':($sites := $append([],sites); $ids := $map($append([],targets),function($target) { $string($target.metadata.safeLineSiteId ? $target.metadata.safeLineSiteId : $replace($string($target.targetKey),/^site:/,'')) }); $append([], $map($filter($sites,function($site) { $string($site.id) in $ids }),function($site) { {'siteId':$site.id,'oldCertificateId':$site.cert_id} })))}"
          }
        },
        "timeoutMs": 1000,
        "maxInputBytes": 1048576,
        "maxOutputBytes": 1048576
      }
    },
    {
      "name": "requireTargets",
      "type": "condition",
      "stage": "backup",
      "condition": {
        "variable": "steps.selectTargets.extracted.hasTargets",
        "equals": true
      },
      "description": "没有选中的 SafeLine 保护站点"
    },
    {
      "name": "readDefaultCertificate",
      "type": "http",
      "stage": "backup",
      "when": {
        "variable": "steps.selectTargets.extracted.defaultTargetSelected",
        "equals": true
      },
      "request": {
        "method": "GET",
        "connectionRef": "management",
        "url": "/api/open/cert/{{steps.selectTargets.extracted.defaultCertificateId}}",
        "auth": {
          "type": "api_key",
          "name": "X-SLCE-API-TOKEN",
          "in": "header",
          "credential": "{{credentials.credential}}"
        },
        "headers": {
          "Accept": "application/json"
        },
        "tls": {
          "verify": "{{connections.management.tls.verifyPeer}}",
          "sni": "{{connections.management.tls.serverName}}",
          "allowInsecure": true
        },
        "timeoutSeconds": 30,
        "maxResponseBytes": 4194304,
        "successStatusCodes": [
          200
        ]
      },
      "extract": [
        {
          "name": "certificateId",
          "type": "jsonPath",
          "path": "$.data.id",
          "optional": true
        },
        {
          "name": "crt",
          "type": "jsonPath",
          "path": "$.data.manual.crt",
          "sensitive": true
        },
        {
          "name": "key",
          "type": "jsonPath",
          "path": "$.data.manual.key",
          "sensitive": true
        }
      ],
      "assert": [
        {
          "type": "statusCode",
          "equals": 200
        }
      ]
    },
    {
      "name": "matchExistingCertificate",
      "type": "transform",
      "stage": "backup",
      "transform": {
        "engine": "jsonata",
        "input": {
          "certificates": "{{steps.readCertificates.extracted.certificates}}",
          "details": "{{steps.readCertificateDetails.output.iterations}}",
          "fingerprint": "{{artifacts.certificate.outputs.fingerprintSha256}}",
          "leaf": "{{artifacts.certificate.outputs.leafPem}}",
          "chain": "{{artifacts.certificate.outputs.orderedChainPem}}",
          "defaultCertificate": "{{steps.readDefaultCertificate.extracted}}",
          "defaultTargetSelected": "{{steps.selectTargets.extracted.defaultTargetSelected}}",
          "defaultCertificateId": "{{steps.selectTargets.extracted.defaultCertificateId}}"
        },
        "outputs": {
          "existingCertificateId": {
            "expression": "($certs := $append([],certificates); $details := $append([],details); $normalizeFingerprint := function($value) { $lowercase($replace($replace($string($value),/^sha256:/,''),/[^A-Fa-f0-9]/,'')) }; $normalizePem := function($value) { $replace($string($value),/\\s+/, '') }; $expectedFingerprint := $normalizeFingerprint(fingerprint); $expectedCrt := $normalizePem($string(leaf) & ($exists(chain) and $string(chain) != '' ? $string(chain) : '')); $defaultId := $string(defaultCertificateId); $shaMatch := $filter($certs,function($certificate) { ($candidate := $normalizeFingerprint($certificate.sha256); $candidate != '' and $candidate = $expectedFingerprint) }); $indexedDetails := $map($details,function($item,$index) { {'index':$index,'item':$item} }); $pemMatch := $filter($indexedDetails,function($entry) { ($candidate := $entry.item.outputs[name='readCertificate'][0].extracted; $candidate.crt and $normalizePem($candidate.crt) = $expectedCrt) }); $matchedId := defaultTargetSelected and $defaultId != '' ? defaultCertificateId : ($count($shaMatch) > 0 ? $shaMatch[0].id : ($count($pemMatch) > 0 ? $certs[$pemMatch[0].index].id : '')); $matchedId)"
          },
          "defaultCertificateChanged": {
            "expression": "($certs := $append([],certificates); $details := $append([],details); $defaultDetail := defaultCertificate; $normalizeFingerprint := function($value) { $lowercase($replace($replace($string($value),/^sha256:/,''),/[^A-Fa-f0-9]/,'')) }; $normalizePem := function($value) { $replace($string($value),/\\s+/, '') }; $expectedFingerprint := $normalizeFingerprint(fingerprint); $expectedCrt := $normalizePem($string(leaf) & ($exists(chain) and $string(chain) != '' ? $string(chain) : '')); $defaultId := $string(defaultCertificateId); $current := $certs[$string(id) = $defaultId][0]; $currentFingerprint := $normalizeFingerprint($current.sha256); $indexedDetails := $map($details,function($item,$index) { {'index':$index,'item':$item} }); $currentDetails := $filter($indexedDetails,function($entry) { $string($certs[$entry.index].id) = $defaultId }); $currentDetail := ($string($defaultDetail.crt) != '') ? $defaultDetail : ($count($currentDetails) > 0 ? $currentDetails[0].item.outputs[name='readCertificate'][0].extracted : {}); $currentCrt := $normalizePem($currentDetail.crt); $sameBySha := $expectedFingerprint != '' and $currentFingerprint != '' and $expectedFingerprint = $currentFingerprint; $sameByPem := $currentCrt != '' and $currentCrt = $expectedCrt; $boolean(defaultTargetSelected and $defaultId != '' and $not($sameBySha or $sameByPem)))"
          }
        },
        "timeoutMs": 1000,
        "maxInputBytes": 1048576,
        "maxOutputBytes": 1048576
      }
    },
    {
      "name": "buildCertificateSnapshot",
      "type": "transform",
      "stage": "backup",
      "transform": {
        "engine": "jsonata",
        "input": {
          "certificateId": "{{steps.matchExistingCertificate.extracted.existingCertificateId}}",
          "certificates": "{{steps.readCertificates.extracted.certificates}}",
          "details": "{{steps.readCertificateDetails.output.iterations}}",
          "defaultCertificate": "{{steps.readDefaultCertificate.extracted}}",
          "defaultTargetSelected": "{{steps.selectTargets.extracted.defaultTargetSelected}}",
          "defaultCertificateChanged": "{{steps.matchExistingCertificate.extracted.defaultCertificateChanged}}"
        },
        "outputs": {
          "reused": {
            "expression": "($string(certificateId) != '')"
          },
          "certificateSnapshot": {
            "expression": "($id := certificateId; $certificates := $append([],certificates); $direct := defaultCertificate; $indexedDetails := $map($append([],details),function($item,$index) { {'index':$index,'item':$item} }); $matches := $filter($indexedDetails,function($entry) { $string($certificates[$entry.index].id) = $string($id) }); $detail := ($string($direct.crt) != '') ? $direct : ($count($matches) > 0 ? $matches[0].item.outputs[name='readCertificate'][0].extracted : {}); $crt := $string($detail.crt); $key := $string($detail.key); $hasPrivateKey := $contains($key,'-----BEGIN') and $contains($key,'PRIVATE KEY-----') and $contains($key,'-----END'); {'id':$id,'crt':$detail.crt,'key':$detail.key,'restoreRequired':$string($id) != '' and $crt != '' and $hasPrivateKey})"
          },
          "defaultBackupAvailable": {
            "expression": "$boolean(defaultTargetSelected and defaultCertificateChanged and certificateSnapshot.restoreRequired)"
          },
          "createdCertificate": {
            "expression": "($string(certificateId) = '')"
          }
        },
        "timeoutMs": 1000,
        "maxInputBytes": 1048576,
        "maxOutputBytes": 1048576
      }
    },
    {
      "name": "deploymentCheckpoint",
      "type": "checkpoint",
      "stage": "backup",
      "checkpoint": {
        "name": "chaitin-safeline-waf-certificate-deployment",
        "capture": {
          "siteSnapshot": "steps.selectTargets.extracted.snapshot",
          "createdCertificate": "steps.buildCertificateSnapshot.extracted.createdCertificate",
          "defaultCertificateChanged": "steps.matchExistingCertificate.extracted.defaultCertificateChanged"
        },
        "normalizedHash": true,
        "requiredForRollback": true
      }
    },
    {
      "name": "backupDefaultCertificate",
      "type": "http",
      "stage": "install",
      "when": {
        "variable": "steps.buildCertificateSnapshot.extracted.defaultBackupAvailable",
        "equals": true
      },
      "request": {
        "method": "POST",
        "connectionRef": "management",
        "url": "/api/open/cert",
        "auth": {
          "type": "api_key",
          "name": "X-SLCE-API-TOKEN",
          "in": "header",
          "credential": "{{credentials.credential}}"
        },
        "headers": {
          "Accept": "application/json",
          "Content-Type": "application/json"
        },
        "bodyType": "json",
        "body": {
          "type": 2,
          "manual": {
            "crt": "{{steps.buildCertificateSnapshot.extracted.certificateSnapshot.crt}}",
            "key": "{{steps.buildCertificateSnapshot.extracted.certificateSnapshot.key}}"
          }
        },
        "tls": {
          "verify": "{{connections.management.tls.verifyPeer}}",
          "sni": "{{connections.management.tls.serverName}}",
          "allowInsecure": true
        },
        "timeoutSeconds": 60,
        "maxResponseBytes": 4194304,
        "successStatusCodes": [
          200
        ]
      },
      "extract": [
        {
          "name": "certificateId",
          "type": "jsonPath",
          "path": "$.data"
        },
        {
          "name": "backupCreated",
          "type": "literal",
          "value": true
        }
      ],
      "assert": [
        {
          "type": "statusCode",
          "equals": 200
        }
      ]
    },
    {
      "name": "normalizeCertificate",
      "type": "transform",
      "stage": "install",
      "transform": {
        "engine": "jsonata",
        "input": {
          "leaf": "{{artifacts.certificate.outputs.leafPem}}",
          "key": "{{artifacts.certificate.outputs.privateKeyPem}}",
          "chain": "{{artifacts.certificate.outputs.orderedChainPem}}"
        },
        "outputs": {
          "crt": {
            "expression": "$string(leaf) & ($exists(chain) and $string(chain) != '' ? ('\n' & $string(chain)) : '')"
          },
          "key": {
            "expression": "$string(key)"
          }
        },
        "timeoutMs": 1000,
        "maxInputBytes": 1048576,
        "maxOutputBytes": 1048576
      }
    },
    {
      "name": "buildCertificateRequest",
      "type": "transform",
      "stage": "install",
      "transform": {
        "engine": "jsonata",
        "input": {
          "existingCertificateId": "{{steps.matchExistingCertificate.extracted.existingCertificateId}}",
          "defaultTargetSelected": "{{steps.selectTargets.extracted.defaultTargetSelected}}",
          "crt": "{{steps.normalizeCertificate.extracted.crt}}",
          "key": "{{steps.normalizeCertificate.extracted.key}}"
        },
        "outputs": {
          "payload": {
            "expression": "($body := {'type':2,'manual':{'crt':crt,'key':key}}; $id := $string(existingCertificateId); $id != '' ? $merge([{'id':$number(existingCertificateId)},$body]) : $body)"
          },
          "createdCertificate": {
            "expression": "($string(existingCertificateId) = '') and $not(defaultTargetSelected)"
          }
        },
        "timeoutMs": 1000,
        "maxInputBytes": 1048576,
        "maxOutputBytes": 1048576
      }
    },
    {
      "name": "uploadCertificate",
      "type": "http",
      "stage": "install",
      "request": {
        "method": "POST",
        "connectionRef": "management",
        "url": "/api/open/cert",
        "auth": {
          "type": "api_key",
          "name": "X-SLCE-API-TOKEN",
          "in": "header",
          "credential": "{{credentials.credential}}"
        },
        "headers": {
          "Accept": "application/json",
          "Content-Type": "application/json"
        },
        "bodyType": "json",
        "body": "{{steps.buildCertificateRequest.extracted.payload}}",
        "tls": {
          "verify": "{{connections.management.tls.verifyPeer}}",
          "sni": "{{connections.management.tls.serverName}}",
          "allowInsecure": true
        },
        "timeoutSeconds": 60,
        "maxResponseBytes": 4194304,
        "successStatusCodes": [
          200
        ]
      },
      "extract": [
        {
          "name": "certificateId",
          "type": "jsonPath",
          "path": "$.data"
        }
      ],
      "assert": [
        {
          "type": "statusCode",
          "equals": 200
        }
      ]
    },
    {
      "name": "verifyUploadedCertificate",
      "type": "http",
      "stage": "verify",
      "request": {
        "method": "GET",
        "connectionRef": "management",
        "url": "/api/open/cert/{{steps.uploadCertificate.extracted.certificateId}}",
        "auth": {
          "type": "api_key",
          "name": "X-SLCE-API-TOKEN",
          "in": "header",
          "credential": "{{credentials.credential}}"
        },
        "headers": {
          "Accept": "application/json"
        },
        "tls": {
