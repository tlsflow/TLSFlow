{
  "apiVersion": "gcac.workflow/v1",
  "kind": "CurlSshWorkflow",
  "metadata": {
    "name": "chaitin-safeline-waf-identity-detect",
    "displayName": "SafeLine identity detection",
    "category": "device",
    "version": "0.1.8",
    "platforms": [
      "waf"
    ],
    "updateMethods": [
      "curl"
    ],
    "maintainer": "GCAC 用户插件"
  },
  "inputContract": {
    "apiVersion": "gcac.deployment-input/v1",
    "variables": {
      "allowInsecureTls": {
        "type": "boolean",
        "required": true,
        "configurationMode": "required",
        "source": {
          "kind": "binding"
        },
        "lifecycle": "pre_execution",
        "bindingPolicy": "required_binding",
        "descriptionKey": "deploymentInputs.allowInsecureTls.description",
        "ui": {
          "labelKey": "deploymentInputs.allowInsecureTls.label",
          "group": "security",
          "order": 10,
          "helpKey": "deploymentInputs.allowInsecureTls.help"
        }
      }
    },
    "connections": {
      "management": {
        "transport": "http",
        "allowedProtocols": [
          "http",
          "https"
        ],
        "host": {
          "type": "string",
          "required": true,
          "configurationMode": "required",
          "source": {
            "kind": "binding"
          },
          "lifecycle": "pre_execution",
          "bindingPolicy": "required_binding"
        },
        "port": {
          "type": "number",
          "required": true,
          "configurationMode": "advanced",
          "source": {
            "kind": "default"
          },
          "lifecycle": "pre_execution",
          "bindingPolicy": "default_overridable",
          "default": 9443
        },
        "credentialSlot": "credential",
        "tls": {
          "enabled": {
            "type": "boolean",
            "required": true,
            "configurationMode": "advanced",
            "source": {
              "kind": "default"
            },
            "lifecycle": "pre_execution",
            "bindingPolicy": "default_overridable",
            "default": true
          },
          "verifyPeer": {
            "type": "boolean",
            "required": true,
            "configurationMode": "advanced",
            "source": {
              "kind": "default"
            },
            "lifecycle": "pre_execution",
            "bindingPolicy": "default_overridable",
            "default": true
          },
          "serverName": {
            "type": "string",
            "required": false,
            "configurationMode": "advanced",
            "source": {
              "kind": "binding"
            },
            "lifecycle": "pre_execution",
            "bindingPolicy": "default_overridable",
            "default": ""
          }
        }
      }
    },
    "credentials": {
      "credential": {
        "allowedKinds": [
          "API_KEY"
        ],
        "required": true,
        "configurationMode": "required",
        "lifecycle": "pre_execution"
      }
    },
    "artifacts": {}
  },
  "steps": [
    {
      "name": "readSystem",
      "type": "http",
      "stage": "prepare",
      "request": {
        "method": "GET",
        "connectionRef": "management",
        "url": "/api/open/system",
        "auth": {
          "type": "api_key",
          "name": "X-SLCE-API-TOKEN",
          "in": "header",
          "credential": "{{credentials.credential}}"
        },
        "headers": {
          "Accept": "application/json"
        },
        "tls": {
          "verify": "{{connections.management.tls.verifyPeer}}",
          "sni": "{{connections.management.tls.serverName}}",
          "allowInsecure": true
        },
        "timeoutSeconds": 30,
        "maxResponseBytes": 1048576,
        "successStatusCodes": [
          200
        ]
      },
      "extract": [
        {
          "name": "system",
          "type": "outputPath",
          "path": "$.body"
        }
      ],
      "assert": [
        {
          "type": "statusCode",
          "equals": 200
        }
      ]
    },
    {
      "name": "readEdition",
      "type": "http",
      "stage": "prepare",
      "request": {
        "method": "GET",
        "connectionRef": "management",
        "url": "/api/open/system/edition",
        "auth": {
          "type": "api_key",
          "name": "X-SLCE-API-TOKEN",
          "in": "header",
          "credential": "{{credentials.credential}}"
        },
        "headers": {
          "Accept": "application/json"
        },
        "tls": {
          "verify": "{{connections.management.tls.verifyPeer}}",
          "sni": "{{connections.management.tls.serverName}}",
          "allowInsecure": true
        },
        "timeoutSeconds": 30,
        "maxResponseBytes": 1048576,
        "successStatusCodes": [
          200
        ]
      },
      "extract": [
        {
          "name": "edition",
          "type": "outputPath",
          "path": "$.body"
        }
      ],
      "assert": [
        {
          "type": "statusCode",
          "equals": 200
        }
      ]
    },
    {
      "name": "readArchitecture",
      "type": "http",
      "stage": "prepare",
      "request": {
        "method": "GET",
        "connectionRef": "management",
        "url": "/api/open/system/arch",
        "auth": {
          "type": "api_key",
          "name": "X-SLCE-API-TOKEN",
          "in": "header",
          "credential": "{{credentials.credential}}"
        },
        "headers": {
          "Accept": "application/json"
        },
        "tls": {
          "verify": "{{connections.management.tls.verifyPeer}}",
          "sni": "{{connections.management.tls.serverName}}",
          "allowInsecure": true
        },
        "timeoutSeconds": 30,
        "maxResponseBytes": 1048576,
        "successStatusCodes": [
          200
        ]
      },
      "extract": [
        {
          "name": "architecture",
          "type": "jsonPath",
          "path": "$.data"
        }
      ],
      "assert": [
        {
          "type": "statusCode",
          "equals": 200
        }
      ]
    },
    {
      "name": "identity",
      "type": "transform",
      "stage": "verify",
      "transform": {
        "engine": "jsonata",
        "input": {
          "system": "{{steps.readSystem.extracted.system}}",
          "edition": "{{steps.readEdition.extracted.edition}}",
          "architecture": "{{steps.readArchitecture.extracted.architecture}}"
        },
        "outputs": {
          "productFamily": {
            "expression": "'device.chaitin-safeline-waf'"
          },
          "version": {
            "expression": "system.data.version"
          },
          "architecture": {
            "expression": "architecture"
          },
          "edition": {
            "expression": "edition.data.version"
          }
        },
        "timeoutMs": 1000
      }
    }
  ]
}
