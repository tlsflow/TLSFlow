{
  "apiVersion": "gcac.workflow/v1",
  "kind": "CurlSshWorkflow",
  "metadata": {
    "name": "chaitin-safeline-waf-certificate-verify",
    "displayName": "SafeLine certificate control-plane verification",
    "category": "certificate",
    "version": "0.1.10",
    "platforms": [
      "waf"
    ],
    "updateMethods": [
      "curl"
    ],
    "maintainer": "GCAC 用户插件"
  },
  "inputContract": {
    "apiVersion": "gcac.deployment-input/v1",
    "variables": {
      "targetSites": {
        "type": "array",
        "required": true,
        "configurationMode": "runtime",
        "source": {
          "kind": "asset",
          "path": "deployment.targets"
        },
        "lifecycle": "pre_execution",
        "bindingPolicy": "fixed"
      },
      "allowInsecureTls": {
        "type": "boolean",
        "required": true,
        "configurationMode": "required",
        "source": {
          "kind": "binding"
        },
        "lifecycle": "pre_execution",
        "bindingPolicy": "required_binding",
        "descriptionKey": "deploymentInputs.allowInsecureTls.description",
        "ui": {
          "labelKey": "deploymentInputs.allowInsecureTls.label",
          "group": "security",
          "order": 10,
          "helpKey": "deploymentInputs.allowInsecureTls.help"
        }
      }
    },
    "connections": {
      "management": {
        "transport": "http",
        "allowedProtocols": [
          "http",
          "https"
        ],
        "host": {
          "type": "string",
          "required": true,
          "configurationMode": "required",
          "source": {
            "kind": "binding"
          },
          "lifecycle": "pre_execution",
          "bindingPolicy": "required_binding"
        },
        "port": {
          "type": "number",
          "required": true,
          "configurationMode": "advanced",
          "source": {
            "kind": "default"
          },
          "lifecycle": "pre_execution",
          "bindingPolicy": "default_overridable",
          "default": 9443
        },
        "credentialSlot": "credential",
        "tls": {
          "enabled": {
            "type": "boolean",
            "required": true,
            "configurationMode": "advanced",
            "source": {
              "kind": "default"
            },
            "lifecycle": "pre_execution",
            "bindingPolicy": "default_overridable",
            "default": true
          },
          "verifyPeer": {
            "type": "boolean",
            "required": true,
            "configurationMode": "advanced",
            "source": {
              "kind": "default"
            },
            "lifecycle": "pre_execution",
            "bindingPolicy": "default_overridable",
            "default": true
          },
          "serverName": {
            "type": "string",
            "required": false,
            "configurationMode": "advanced",
            "source": {
              "kind": "binding"
            },
            "lifecycle": "pre_execution",
            "bindingPolicy": "default_overridable",
            "default": ""
          }
        }
      }
    },
    "credentials": {
      "credential": {
        "allowedKinds": [
          "API_KEY"
        ],
        "required": true,
        "configurationMode": "required",
        "lifecycle": "pre_execution"
      }
    },
    "artifacts": {}
  },
  "steps": [
    {
      "name": "readSites",
      "type": "http",
      "stage": "prepare",
      "request": {
        "method": "GET",
        "connectionRef": "management",
        "url": "/api/open/site",
        "auth": {
          "type": "api_key",
          "name": "X-SLCE-API-TOKEN",
          "in": "header",
          "credential": "{{credentials.credential}}"
        },
        "headers": {
          "Accept": "application/json"
        },
        "tls": {
          "verify": "{{connections.management.tls.verifyPeer}}",
          "sni": "{{connections.management.tls.serverName}}",
          "allowInsecure": true
        },
        "timeoutSeconds": 30,
        "maxResponseBytes": 4194304,
        "successStatusCodes": [
          200
        ]
      },
      "extract": [
        {
          "name": "content",
          "type": "jsonPath",
          "path": "$.data.data"
        }
      ],
      "assert": [
        {
          "type": "statusCode",
          "equals": 200
        }
      ]
    },
    {
      "name": "readCertificates",
      "type": "http",
      "stage": "prepare",
      "request": {
        "method": "GET",
        "connectionRef": "management",
        "url": "/api/open/cert",
        "auth": {
          "type": "api_key",
          "name": "X-SLCE-API-TOKEN",
          "in": "header",
          "credential": "{{credentials.credential}}"
        },
        "headers": {
          "Accept": "application/json"
        },
        "tls": {
          "verify": "{{connections.management.tls.verifyPeer}}",
          "sni": "{{connections.management.tls.serverName}}",
          "allowInsecure": true
        },
        "timeoutSeconds": 30,
        "maxResponseBytes": 4194304,
        "successStatusCodes": [
          200
        ]
      },
      "extract": [
        {
          "name": "certificates",
          "type": "jsonPath",
          "path": "$.data.nodes"
        }
      ],
      "assert": [
        {
          "type": "statusCode",
          "equals": 200
        }
      ]
    },
    {
      "name": "verifyControlPlaneBinding",
      "type": "transform",
      "stage": "verify",
      "transform": {
        "engine": "jsonata",
        "input": {
          "sites": "{{steps.readSites.extracted.content}}",
          "certificates": "{{steps.readCertificates.extracted.certificates}}",
          "targets": "{{variables.targetSites}}"
        },
        "outputs": {
          "verification": {
            "expression": "($sites := $append([],sites); $certs := $append([],certificates); $targetList := $append([],targets); $siteIds := $map($filter($targetList,function($target) { $not($boolean($target.metadata.abstract) or $string($target.targetKey) = 'Default') }),function($target) { $string($target.metadata.safeLineSiteId ? $target.metadata.safeLineSiteId : $replace($string($target.targetKey),/^site:/,'')) }); $selected := $filter($sites,function($site) { $string($site.id) in $siteIds }); $defaultTargets := $filter($targetList,function($target) { $boolean($target.metadata.abstract) or $string($target.targetKey) = 'Default' }); $defaultVerified := $count($filter($defaultTargets,function($target) { ($id := $target.metadata.safeLineCertificateId ? $target.metadata.safeLineCertificateId : $target.metadata.certificateId; $count($certs[id=$id]) > 0) })) = $count($defaultTargets); {'apiVersion':'gcac.certificate-verify-result/v1','controlPlaneVerified':($count($selected) = $count($siteIds)) and $defaultVerified,'bindings':$append($map($selected,function($site) { {'siteId':$site.id,'certificateId':$site.cert_id,'certificateKnown':$count($certs[id=$site.cert_id]) > 0,'title':$site.title,'comment':$site.comment} }),$map($defaultTargets,function($target) { ($id := $target.metadata.safeLineCertificateId ? $target.metadata.safeLineCertificateId : $target.metadata.certificateId; {'siteId':'default','certificateId':$id,'certificateKnown':$count($certs[id=$id]) > 0,'title':'Default','comment':'Default'}) }))})"
          }
        },
        "timeoutMs": 1000,
        "maxInputBytes": 1048576,
        "maxOutputBytes": 1048576
      }
    }
  ]
}
