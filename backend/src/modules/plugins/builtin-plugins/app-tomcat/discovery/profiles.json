{
  "apiVersion": "gcac.plugin-discovery/v1",
  "kind": "AgentFactProfileSet",
  "pluginId": "app.tomcat",
  "version": "1.0.9",
  "profiles": [
    {
      "id": "linux.agent_plan.pkcs12",
      "pluginId": "app.tomcat",
      "version": "1.0.9",
      "sources": [
        "linux"
      ],
      "pathMode": "explicit",
      "targetPaths": [
        "/opt/tomcat/conf/keystore.p12"
      ],
      "configPaths": [
        "/opt/tomcat/conf/server.xml"
      ],
      "processExecutables": [
        "/usr/lib/jvm/java/bin/java",
        "java",
        "tomcat",
        "prunsrv"
      ],
      "serviceNames": [
        "tomcat",
        "Tomcat",
        "Tomcat9",
        "Tomcat10",
        "prunsrv"
      ],
      "commandLineContains": [
        "org.apache.catalina"
      ],
      "rootArgKeys": [
        "-Dcatalina.base",
        "-Dcatalina.home"
      ],
      "defaultConfigRelativePaths": [
        "conf/server.xml"
      ],
      "configFileNames": [
        "server.xml"
      ],
      "certificateFileExtensions": [
        ".cer",
        ".crt",
        ".der",
        ".jks",
        ".keystore",
        ".p12",
        ".pem",
        ".pfx"
      ],
      "listeningPorts": [
        8080,
        8443
      ],
      "frameworkType": "app.tomcat",
      "defaultPort": 8443
    },
    {
      "id": "windows.agent_plan.pkcs12",
      "pluginId": "app.tomcat",
      "version": "1.0.9",
      "sources": [
        "windows"
      ],
      "pathMode": "explicit",
      "targetPaths": [
        "C:/Tomcat/conf/keystore.p12"
      ],
      "configPaths": [
        "C:/Tomcat/conf/server.xml"
      ],
      "processExecutables": [
        "C:/Program Files/Java/bin/java.exe",
        "java.exe",
        "tomcat.exe",
        "tomcat9.exe",
        "tomcat10.exe",
        "prunsrv.exe",
        "java",
        "tomcat",
        "tomcat9",
        "tomcat10",
        "prunsrv"
      ],
      "serviceNames": [
        "Tomcat",
        "Tomcat9",
        "Tomcat10",
        "prunsrv"
      ],
      "commandLineContains": [
        "org.apache.catalina"
      ],
      "rootArgKeys": [
        "-Dcatalina.base",
        "-Dcatalina.home"
      ],
      "defaultConfigRelativePaths": [
        "conf/server.xml"
      ],
      "configFileNames": [
        "server.xml"
      ],
      "certificateFileExtensions": [
        ".cer",
        ".crt",
        ".der",
        ".jks",
        ".keystore",
        ".p12",
        ".pem",
        ".pfx"
      ],
      "listeningPorts": [
        8080,
        8443
      ],
      "frameworkType": "app.tomcat",
      "defaultPort": 8443
    }
  ]
}
