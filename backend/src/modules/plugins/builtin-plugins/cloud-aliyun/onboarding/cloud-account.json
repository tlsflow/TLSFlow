  "assetKind": "CLOUD_ACCOUNT",
  "providerKey": "cloud.aliyun",
  "display": {
    "nameKey": "plugin.cloud.aliyun.name",
    "descriptionKey": "plugin.cloud.aliyun.description",
    "logoResource": "logos/logo-square.svg"
  },
  "formResource": "forms/cloud-account.json",
