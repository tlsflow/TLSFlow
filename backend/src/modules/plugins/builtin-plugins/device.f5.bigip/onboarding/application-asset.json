{
  "protocol": "gcac.application-onboarding/v1",
  "platformKey": "device.f5.bigip",
  "displayNameKey": "plugin.f5Bigip.name",
  "platformMetadata": {
    "capabilityVersion": "v1",
    "compatibilityKeys": ["plugin.f5Bigip.onboarding.compatibility"],
    "requiredInformationKeys": ["plugin.f5Bigip.onboarding.requiredAddress", "plugin.f5Bigip.onboarding.requiredCredential"]
  },
  "supportStatus": "SUPPORTED",
  "deploymentMode": "MANAGED_TARGET",
  "deviceResourceType": "device.f5.bigip",
  "deviceSelection": "EXISTING_OR_NEW",
  "newDeviceOnboarding": { "kind": "PLUGIN_MANAGED", "pluginId": "device.f5.bigip" },
  "forms": { "device": "forms/device.json" },
  "capabilities": {
    "connectionTest": "device.connection.test",
    "identity": "device.identity.detect",
    "discovery": "device.discover"
  },
  "targetProjection": {
    "targetType": "tls.binding",
    "displayFields": ["displayName", "endpoint.port", "frameworkType", "metadata.profilePath"],
    "identityFields": ["managedTargetId", "configFingerprint"],
    "selectableWhen": "selectable"
  },
  "deploymentDefaults": {
    "capabilityKey": "certificate.deploy",
    "variables": { "allowInsecureTls": true },
    "certificateFormat": { "format": "PEM", "configName": "宿主默认 PEM Bundle" }
  },
  "certificate": {
    "acceptedFormats": ["PEM"],
    "requiredArtifacts": ["leaf", "privateKey"],
    "defaultVersion": "LATEST_VALID"
  },
  "commit": { "executionSource": "PLUGIN", "inputContract": "certificate.deploy.v1" }
}
