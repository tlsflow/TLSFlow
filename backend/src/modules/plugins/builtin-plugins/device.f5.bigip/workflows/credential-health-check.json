{
  "apiVersion": "gcac.workflow/v1",
  "kind": "CurlSshWorkflow",
  "metadata": { "name": "f5-bigip-credential-health-check", "displayName": "F5 BIG-IP credential health check", "category": "device", "version": "1.0.7", "platforms": ["appliance"], "updateMethods": ["curl"], "maintainer": "GCAC" },
  "inputContract": {
    "apiVersion": "gcac.deployment-input/v1",
    "variables": {
      "allowInsecureTls": { "type": "boolean", "required": true, "configurationMode": "required", "source": { "kind": "binding" }, "lifecycle": "pre_execution", "bindingPolicy": "required_binding", "descriptionKey": "deploymentInputs.allowInsecureTls.description", "ui": { "labelKey": "deploymentInputs.allowInsecureTls.label", "group": "security", "order": 10, "helpKey": "deploymentInputs.allowInsecureTls.help" } }
    },
    "connections": { "management": { "transport": "http", "allowedProtocols": ["https"], "host": { "type": "string", "required": true, "configurationMode": "required", "source": { "kind": "binding" }, "lifecycle": "pre_execution", "bindingPolicy": "required_binding" }, "port": { "type": "number", "required": true, "configurationMode": "advanced", "source": { "kind": "default" }, "lifecycle": "pre_execution", "bindingPolicy": "default_overridable", "default": 443 }, "credentialSlot": "credential", "tls": { "enabled": { "type": "boolean", "required": true, "configurationMode": "advanced", "source": { "kind": "default" }, "lifecycle": "pre_execution", "bindingPolicy": "default_overridable", "default": true }, "verifyPeer": { "type": "boolean", "required": true, "configurationMode": "advanced", "source": { "kind": "default" }, "lifecycle": "pre_execution", "bindingPolicy": "default_overridable", "default": false } } } },
    "credentials": { "credential": { "allowedKinds": ["USERNAME_PASSWORD"], "required": true, "configurationMode": "required", "lifecycle": "pre_execution" } },
    "artifacts": {}
  },
  "steps": [
    { "name": "authenticate", "type": "http", "stage": "prepare", "request": { "method": "GET", "connectionRef": "management", "url": "/mgmt/tm/sys/version", "auth": { "type": "basic", "username": "{{credentials.credential.username}}", "credential": "{{credentials.credential}}" }, "headers": { "Accept": "application/json" }, "tls": { "verify": "{{connections.management.tls.verifyPeer}}", "allowInsecure": true }, "timeoutSeconds": 30, "maxResponseBytes": 1048576, "successStatusCodes": [200, 401, 403] }, "extract": [{ "name": "authStatusCode", "type": "statusCode" }] },
    { "name": "classifyAuthentication", "type": "transform", "stage": "verify", "transform": { "engine": "jsonata", "input": { "statusCode": "{{steps.authenticate.extracted.authStatusCode}}" }, "outputs": { "credentialHealth": { "expression": "statusCode = 200 ? {'apiVersion':'gcac.credential-health-result/v1','status':'VALID','summary':'设备认证成功','evidence':{'protocol':'F5_ICONTROL_REST'}} : {'apiVersion':'gcac.credential-health-result/v1','status':'ERROR','reasonCode':'PASSWORD_INVALID','summary':'设备拒绝凭据认证','evidence':{'protocol':'F5_ICONTROL_REST','httpStatus':statusCode}}" } }, "timeoutMs": 1000, "maxInputBytes": 1048576, "maxOutputBytes": 65536 } }
  ]
}
