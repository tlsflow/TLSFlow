{
  "apiVersion": "gcac.workflow/v1",
  "kind": "CurlSshWorkflow",
  "metadata": {
    "name": "web.apache.linux-certificate-deploy",
    "displayName": "Linux Apache 证书更新",
    "description": "只消费 Agent 已确认事实并编排可回滚证书更新。",
    "category": "application",
    "tags": [
      "certificate",
      "deploy"
    ],
    "version": "1.0.1",
    "platforms": [
      "linux"
    ],
    "maintainer": "GCAC"
  },
  "inputContract": {
    "apiVersion": "gcac.deployment-input/v1",
    "variables": {
      "certificatePath": {
        "type": "file",
        "required": true,
        "configurationMode": "required",
        "source": {
          "kind": "asset",
          "path": "target.certificateLocation.certificatePath"
        },
        "lifecycle": "pre_execution",
        "bindingPolicy": "fixed"
      },
      "privateKeyPath": {
        "type": "file",
        "required": true,
        "configurationMode": "required",
        "source": {
          "kind": "asset",
          "path": "target.certificateLocation.privateKeyPath"
        },
        "lifecycle": "pre_execution",
        "bindingPolicy": "fixed"
      },
      "chainPath": {
        "type": "file",
        "required": false,
        "configurationMode": "advanced",
        "source": {
          "kind": "asset",
          "path": "target.certificateLocation.chainPath"
        },
        "lifecycle": "pre_execution",
        "bindingPolicy": "fixed"
      },
      "configPath": {
        "type": "string",
        "required": true,
        "configurationMode": "required",
        "source": {
          "kind": "asset",
          "path": "target.certificateLocation.sourceConfigPath"
        },
        "lifecycle": "pre_execution",
        "bindingPolicy": "fixed"
      },
      "serviceName": {
        "type": "string",
        "required": true,
        "configurationMode": "required",
        "source": {
          "kind": "asset",
          "path": "target.certificateLocation.serviceName"
        },
        "lifecycle": "pre_execution",
        "bindingPolicy": "fixed"
      },
      "programPath": {
        "type": "string",
        "required": true,
        "configurationMode": "required",
        "source": {
          "kind": "asset",
          "path": "target.certificateLocation.programPath"
        },
        "lifecycle": "pre_execution",
        "bindingPolicy": "fixed"
      },
      "configFingerprint": {
        "type": "string",
        "required": true,
        "configurationMode": "required",
        "source": {
          "kind": "asset",
          "path": "target.certificateLocation.configFingerprint"
        },
        "lifecycle": "pre_execution",
        "bindingPolicy": "fixed"
      }
    },
    "connections": {},
    "credentials": {},
    "artifacts": {
      "certificateArtifact": {
        "kind": "certificate",
        "required": true,
        "configurationMode": "required",
        "lifecycle": "pre_execution",
        "artifactContract": {
          "outputs": {
            "leafPem": {
              "role": "public_certificate",
              "required": true,
              "format": "PEM",
              "encoding": "base64"
            },
            "privateKeyPem": {
              "role": "private_key",
              "required": true,
              "format": "PEM",
              "encoding": "base64",
              "sensitive": true
            },
            "orderedChainPem": {
              "role": "certificate_chain",
              "required": false,
              "format": "PEM",
              "encoding": "base64"
            }
          }
        }
      }
    }
  },
  "steps": [
    {
      "name": "prepareFacts",
      "type": "transform",
      "stage": "prepare",
      "transform": {
        "engine": "jsonata",
        "input": {
          "targetPath": "{{variables.certificatePath}}",
          "configPath": "{{variables.configPath}}",
          "configFingerprint": "{{variables.configFingerprint}}"
        },
        "outputs": {
          "targetPath": {
            "expression": "targetPath"
          },
          "configPath": {
            "expression": "configPath"
          },
          "configFingerprint": {
            "expression": "configFingerprint"
          }
        },
        "timeoutMs": 1000,
        "maxInputBytes": 65536,
        "maxOutputBytes": 65536
      }
    },
    {
      "name": "backupLedger",
      "type": "checkpoint",
      "stage": "backup",
      "checkpoint": {
        "name": "certificate-update-before-change",
        "capture": {
          "targetPath": "variables.certificatePath",
          "configPath": "variables.configPath"
        },
        "normalizedHash": true,
        "requiredForRollback": true
      }
    },
    {
      "name": "installArtifact",
      "type": "transform",
      "stage": "install",
      "transform": {
        "engine": "jsonata",
        "input": {
          "targetPath": "{{variables.certificatePath}}",
          "artifact": "{{artifacts.certificateArtifact}}"
        },
        "outputs": {
          "targetPath": {
            "expression": "targetPath"
          },
          "artifactBound": {
            "expression": "$exists(artifact)"
          }
        },
        "timeoutMs": 1000,
        "maxInputBytes": 65536,
        "maxOutputBytes": 65536
      }
    },
    {
      "name": "refreshService",
      "type": "transform",
      "stage": "refresh",
      "transform": {
        "engine": "jsonata",
        "input": {
          "serviceName": "{{variables.serviceName}}",
          "programPath": "{{variables.programPath}}"
        },
        "outputs": {
          "serviceName": {
            "expression": "serviceName"
          },
          "programPath": {
            "expression": "programPath"
          }
        },
        "timeoutMs": 1000,
        "maxInputBytes": 65536,
        "maxOutputBytes": 65536
      }
    },
    {
      "name": "verifySameTarget",
      "type": "transform",
      "stage": "verify",
      "transform": {
        "engine": "jsonata",
        "input": {
          "targetPath": "{{variables.certificatePath}}",
          "configFingerprint": "{{variables.configFingerprint}}"
        },
        "outputs": {
          "targetPath": {
            "expression": "targetPath"
          },
          "configFingerprint": {
            "expression": "configFingerprint"
          }
        },
        "timeoutMs": 1000,
        "maxInputBytes": 65536,
        "maxOutputBytes": 65536
      }
    }
  ],
  "rollback": [
    {
      "name": "prepareFacts",
      "type": "transform",
      "stage": "prepare",
      "transform": {
        "engine": "jsonata",
        "input": {
          "targetPath": "{{variables.certificatePath}}",
          "configPath": "{{variables.configPath}}",
          "configFingerprint": "{{variables.configFingerprint}}"
        },
        "outputs": {
          "targetPath": {
            "expression": "targetPath"
          },
          "configPath": {
            "expression": "configPath"
          },
          "configFingerprint": {
            "expression": "configFingerprint"
          }
        },
        "timeoutMs": 1000,
        "maxInputBytes": 65536,
        "maxOutputBytes": 65536
      }
    },
    {
      "name": "verifySameTarget",
      "type": "transform",
      "stage": "verify",
      "transform": {
        "engine": "jsonata",
        "input": {
          "targetPath": "{{variables.certificatePath}}",
          "configFingerprint": "{{variables.configFingerprint}}"
        },
        "outputs": {
          "targetPath": {
            "expression": "targetPath"
          },
          "configFingerprint": {
            "expression": "configFingerprint"
          }
        },
        "timeoutMs": 1000,
        "maxInputBytes": 65536,
        "maxOutputBytes": 65536
      }
    }
  ]
}
