{
  "apiVersion": "gcac.certificate-update-input/v1",
  "pluginId": "web.apache.linux",
  "frameworkType": "web.apache",
  "platform": "linux",
  "artifactKind": "PEM_FILES",
  "requiredFacts": [
    "frameworkType",
    "site",
    "tls.binding",
    "certificateLocation",
    "configFingerprint",
    "serviceName",
    "programPath"
  ],
  "deploymentInputContract": {
    "apiVersion": "gcac.deployment-input/v1",
    "variables": {
      "certificatePath": {
        "type": "file",
        "required": true,
        "configurationMode": "required",
        "source": {
          "kind": "asset",
          "path": "target.certificateLocation.certificatePath"
        },
        "lifecycle": "pre_execution",
        "bindingPolicy": "fixed"
      },
      "privateKeyPath": {
        "type": "file",
        "required": true,
        "configurationMode": "required",
        "source": {
          "kind": "asset",
          "path": "target.certificateLocation.privateKeyPath"
        },
        "lifecycle": "pre_execution",
        "bindingPolicy": "fixed"
      },
      "chainPath": {
        "type": "file",
        "required": false,
        "configurationMode": "advanced",
        "source": {
          "kind": "asset",
          "path": "target.certificateLocation.chainPath"
        },
        "lifecycle": "pre_execution",
        "bindingPolicy": "fixed"
      },
      "configPath": {
        "type": "string",
        "required": true,
        "configurationMode": "required",
        "source": {
          "kind": "asset",
          "path": "target.certificateLocation.sourceConfigPath"
        },
        "lifecycle": "pre_execution",
        "bindingPolicy": "fixed"
      },
      "serviceName": {
        "type": "string",
        "required": true,
        "configurationMode": "required",
        "source": {
          "kind": "asset",
          "path": "target.certificateLocation.serviceName"
        },
        "lifecycle": "pre_execution",
        "bindingPolicy": "fixed"
      },
      "programPath": {
        "type": "string",
        "required": true,
        "configurationMode": "required",
        "source": {
          "kind": "asset",
          "path": "target.certificateLocation.programPath"
        },
        "lifecycle": "pre_execution",
        "bindingPolicy": "fixed"
      },
      "configFingerprint": {
        "type": "string",
        "required": true,
        "configurationMode": "required",
        "source": {
          "kind": "asset",
          "path": "target.certificateLocation.configFingerprint"
        },
        "lifecycle": "pre_execution",
        "bindingPolicy": "fixed"
      }
    },
    "connections": {},
    "credentials": {},
    "artifacts": {
      "certificateArtifact": {
        "kind": "certificate",
        "required": true,
        "configurationMode": "required",
        "lifecycle": "pre_execution",
        "artifactContract": {
          "outputs": {
            "leafPem": {
              "role": "public_certificate",
              "required": true,
              "format": "PEM",
              "encoding": "base64"
            },
            "privateKeyPem": {
              "role": "private_key",
              "required": true,
              "format": "PEM",
              "encoding": "base64",
              "sensitive": true
            },
            "orderedChainPem": {
              "role": "certificate_chain",
              "required": false,
              "format": "PEM",
              "encoding": "base64"
            }
          }
        }
      }
    }
  }
}
