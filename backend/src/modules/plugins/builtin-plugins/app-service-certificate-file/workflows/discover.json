{
  "apiVersion": "gcac.workflow/v1",
  "kind": "CurlSshWorkflow",
  "metadata": {
    "name": "app-service-certificate-file-application-discover",
    "displayName": "Service Certificate File 应用发现",
    "description": "Service Certificate File 插件通过固定 Agent 事实和受授权执行绑定完成应用发现。",
    "category": "application",
    "tags": [
      "plugin",
      "app-service-certificate-file",
      "discover",
      "facts"
    ],
    "version": "1.0.6",
    "platforms": [
      "linux",
      "windows"
    ],
    "maintainer": "GCAC"
  },
  "inputContract": {
    "apiVersion": "gcac.deployment-input/v1",
    "variables": {
      "certificatePath": {
        "type": "string",
        "required": true,
        "configurationMode": "required",
        "source": {
          "kind": "asset",
          "path": "target.certificateLocation.certificatePath"
        },
        "lifecycle": "pre_execution",
        "bindingPolicy": "fixed"
      },
      "configPath": {
        "type": "string",
        "required": true,
        "configurationMode": "required",
        "source": {
          "kind": "asset",
          "path": "target.certificateLocation.sourceConfigPath"
        },
        "lifecycle": "pre_execution",
        "bindingPolicy": "fixed"
      },
      "serviceName": {
        "type": "string",
        "required": false,
        "configurationMode": "advanced",
        "source": {
          "kind": "asset",
          "path": "target.certificateLocation.serviceName"
        },
        "lifecycle": "pre_execution",
        "bindingPolicy": "fixed"
      }
    },
    "connections": {},
    "credentials": {},
    "artifacts": {}
  },
  "steps": [
    {
      "name": "bindFactTarget",
      "type": "transform",
      "stage": "prepare",
      "transform": {
        "engine": "jsonata",
        "input": {
          "certificatePath": "{{variables.certificatePath}}",
          "configPath": "{{variables.configPath}}",
          "serviceName": "{{variables.serviceName}}"
        },
        "outputs": {
          "targetPath": {
            "expression": "certificatePath"
          },
          "configPath": {
            "expression": "configPath"
          },
          "serviceName": {
            "expression": "serviceName"
          }
        },
        "timeoutMs": 1000,
        "maxInputBytes": 65536,
        "maxOutputBytes": 65536
      }
    },
    {
      "name": "requireFactBoundTarget",
      "type": "condition",
      "stage": "verify",
      "condition": {
        "variable": "steps.bindFactTarget.extracted.targetPath",
        "exists": true
      },
      "description": "只有明确绑定的事实路径才能进入插件识别结果"
    },
    {
      "name": "projectDiscoveryBinding",
      "type": "transform",
      "stage": "verify",
      "transform": {
        "engine": "jsonata",
        "input": {
          "targetPath": "{{steps.bindFactTarget.extracted.targetPath}}",
          "configPath": "{{steps.bindFactTarget.extracted.configPath}}"
        },
        "outputs": {
          "targetPath": {
            "expression": "targetPath"
          },
          "configPath": {
            "expression": "configPath"
          }
        },
        "timeoutMs": 1000,
        "maxInputBytes": 65536,
        "maxOutputBytes": 65536
      }
    }
  ]
}
