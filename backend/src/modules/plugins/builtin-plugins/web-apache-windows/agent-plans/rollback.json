{
  "apiVersion": "gcac.certificate-update-plan/v1",
  "pluginId": "web.apache.windows",
  "capability": "certificate.rollback",
  "planId": "certificate.rollback",
  "writeEffect": true,
  "operations": [
    {
      "operationId": "restore-target",
      "operationType": "filesystem.restore",
      "stage": "prepare",
      "input": {
        "path": {
          "$ref": "paths.current"
        },
        "ledgerRef": "execution-recovery-ledger",
        "storageKind": "PEM_FILES"
      },
      "expandPathRef": "paths"
    },
    {
      "operationId": "config-check",
      "operationType": "command.execute_allowlisted",
      "stage": "execute",
      "input": {
        "executablePath": {
          "$ref": "programPath"
        },
        "executableSha256": {
          "$ref": "programSha256"
        },
        "args": {
          "$ref": "configCheckArgs"
        },
        "argumentTemplate": {
          "$ref": "configCheckArgsTemplate"
        },
        "environmentAllowlist": [],
        "workingDirectory": {
          "$ref": "workingDirectory"
        },
        "networkScopes": [],
        "childProcessPolicy": "deny",
        "timeoutSeconds": 60,
        "outputLimitBytes": 65536,
        "artifactDigest": {
          "$ref": "artifactDigest"
        }
      }
    },
    {
      "operationId": "restart-service",
      "operationType": "service.restart",
      "stage": "execute",
      "timeoutSeconds": 300,
      "input": {
        "serviceName": {
          "$ref": "serviceName"
        }
      }
    },
    {
      "operationId": "verify-service",
      "operationType": "service.status",
      "stage": "verify",
      "input": {
        "serviceName": {
          "$ref": "serviceName"
        }
      }
    }
  ]
}
