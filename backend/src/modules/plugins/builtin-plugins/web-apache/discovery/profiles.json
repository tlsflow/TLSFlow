{
  "apiVersion": "gcac.plugin-discovery/v1",
  "kind": "AgentFactProfileSet",
  "pluginId": "web.apache",
  "version": "1.0.2",
  "profiles": [
    {
      "id": "linux.agent_plan.pem",
      "pluginId": "web.apache",
      "version": "1.0.2",
      "sources": [
        "linux"
      ],
      "pathMode": "explicit",
      "targetPaths": [
        "/etc/apache2/tls/server.pem"
      ],
      "configPaths": [
        "/etc/apache2/apache2.conf"
      ],
      "processExecutables": [
        "/usr/sbin/apache2",
        "/usr/sbin/httpd",
        "apache2",
        "httpd",
        "apache"
      ],
      "serviceNames": [
        "apache2",
        "httpd",
        "apache"
      ],
      "configArgKeys": [
        "-f"
      ],
      "rootArgKeys": [
        "-d"
      ],
      "defaultConfigRelativePaths": [
        "conf/httpd.conf",
        "conf/apache2.conf"
      ],
      "configFileNames": [
        "httpd.conf",
        "apache2.conf",
        "*.conf"
      ],
      "certificateFileExtensions": [
        ".cer",
        ".crt",
        ".der",
        ".pem"
      ],
      "listeningPorts": [
        80,
        443
      ],
      "frameworkType": "web.apache",
      "defaultPort": 443
    },
    {
      "id": "windows.agent_plan.pem",
      "pluginId": "web.apache",
      "version": "1.0.2",
      "sources": [
        "windows"
      ],
      "pathMode": "explicit",
      "targetPaths": [
        "C:/Apache24/conf/certs/server.pem"
      ],
      "configPaths": [
        "C:/Apache24/conf/httpd.conf"
      ],
      "processExecutables": [
        "C:/Apache24/bin/httpd.exe",
        "httpd.exe",
        "apache.exe",
        "apache2.exe",
        "httpd",
        "apache",
        "apache2"
      ],
      "serviceNames": [
        "Apache2.4",
        "apache",
        "httpd"
      ],
      "configArgKeys": [
        "-f"
      ],
      "rootArgKeys": [
        "-d"
      ],
      "defaultConfigRelativePaths": [
        "conf/httpd.conf",
        "conf/apache2.conf"
      ],
      "configFileNames": [
        "httpd.conf",
        "apache2.conf",
        "*.conf"
      ],
      "certificateFileExtensions": [
        ".cer",
        ".crt",
        ".der",
        ".pem"
      ],
      "listeningPorts": [
        80,
        443
      ],
      "frameworkType": "web.apache",
      "defaultPort": 443
    }
  ]
}
