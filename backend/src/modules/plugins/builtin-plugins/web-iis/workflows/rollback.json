{
  "apiVersion": "gcac.workflow/v1",
  "kind": "CurlSshWorkflow",
  "metadata": { "name": "web-iis-certificate-rollback", "displayName": "IIS certificate rollback", "category": "certificate", "version": "1.0.24", "platforms": ["windows"], "maintainer": "GCAC" },
  "inputContract": {
    "apiVersion": "gcac.deployment-input/v1",
    "variables": {
      "target": { "type": "string", "required": true, "configurationMode": "runtime", "source": { "kind": "derived", "resolver": "deployment_target_name" }, "lifecycle": "pre_execution", "bindingPolicy": "fixed" },
      "siteName": { "type": "string", "required": true, "configurationMode": "runtime", "source": { "kind": "derived", "resolver": "deployment_target_name" }, "lifecycle": "pre_execution", "bindingPolicy": "fixed" },
      "bindingInformation": { "type": "string", "required": true, "configurationMode": "runtime", "source": { "kind": "derived", "resolver": "binding_information" }, "lifecycle": "pre_execution", "bindingPolicy": "fixed" },
      "previousBinding": { "type": "object", "required": true, "configurationMode": "runtime", "source": { "kind": "system", "key": "execution.rollback.previousBinding" }, "lifecycle": "runtime_injected", "bindingPolicy": "fixed", "sensitive": false }
    },
    "connections": {},
    "credentials": {},
    "artifacts": {}
  },
  "steps": [
    { "name": "verifyRollbackInput", "type": "checkpoint_verify", "stage": "backup", "checkpointVerify": { "valuePath": "variables.previousBinding", "expectedHash": "{{variables.previousBinding.digest}}" } },
    {
      "name": "restoreBinding",
      "type": "transform",
      "stage": "verify",
      "transform": {
        "engine": "jsonata",
        "input": { "pluginId": "web.iis", "pluginVersion": "1.0.23", "operation": "rollback-binding", "siteName": "{{variables.siteName}}", "bindingInformation": "{{variables.bindingInformation}}", "previousBinding": "{{variables.previousBinding}}" },
        "outputs": { "agentSideRequest": { "expression": "$" } },
        "timeoutMs": 1000,
        "maxInputBytes": 131072,
        "maxOutputBytes": 262144
      }
    }
  ]
}
