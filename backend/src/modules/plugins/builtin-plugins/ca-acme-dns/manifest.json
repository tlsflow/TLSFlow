{
  "apiVersion": "gcac.plugin-manifest/v1",
  "kind": "GcacPlugin",
  "pluginId": "ca.acme-dns",
  "version": "1.0.0",
  "displayNameKey": "plugin.ca.acmeDns.name",
  "descriptionKey": "plugin.ca.acmeDns.description",
  "defaultLocale": "zh-CN",
  "publisher": "GCAC",
  "runtime": "WORKFLOW_DSL",
  "source": "BUILTIN",
  "scope": "MANAGED",
  "trust": "UNSIGNED",
  "support": "SELF_MANAGED",
  "capabilities": [
    { "key": "ca.challenge.dns-solver", "contractVersion": "v1", "actionContractId": "ca.challenge.dns-solver.v1", "riskLevel": "HIGH", "executionLocations": ["CONTROL_PLANE"] }
  ],
  "permissions": [
    "secret.resolve", "audit.append"
  ],
  "compatibility": {
    "productFamilies": ["certificate-authority"],
    "frameworkTypes": ["acme-dns-solver"],
    "targetTypes": ["dns-challenge-record"],
    "executionLocations": ["CONTROL_PLANE"]
  },
  "resources": {
    "runtimeEntrypoint": "runtime/index.js",
    "workflows": { "ca.challenge.dns-solver": "workflows/solve.json" },
    "locales": { "zh-CN": "locales/zh-CN.json", "zh-TW": "locales/zh-CN.json", "en-US": "locales/en-US.json", "ja-JP": "locales/en-US.json", "ko-KR": "locales/en-US.json", "fr-FR": "locales/en-US.json", "ru-RU": "locales/en-US.json", "pt-BR": "locales/en-US.json" },
    "presentations": { "dnsChallenge": "presentations/dns-challenge.json" },
    "forms": { "dnsSolver": "forms/dns-solver.json" }
  }
}
