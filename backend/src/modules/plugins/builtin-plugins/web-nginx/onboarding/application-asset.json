    "compatibilityKeys": ["plugin.webNginx.onboarding.compatibility"],
    "requiredInformationKeys": ["plugin.webNginx.onboarding.requiredTarget"]
  },
  "supportStatus": "SUPPORTED",
  "deploymentMode": "MANAGED_TARGET",
  "deviceResourceType": "agent.host",
  "deviceSelection": "EXISTING_OR_NEW",
