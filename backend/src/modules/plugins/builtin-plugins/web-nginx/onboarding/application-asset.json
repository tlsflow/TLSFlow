    "kind": "AGENT_INSTALL",
    "platformKeys": ["linux", "windows-server-2016-plus"]
  },
  "forms": {},
  "capabilities": {
    "connectionTest": "application.discover",
    "discovery": "application.discover"
  },
  "targetProjection": {
    "targetType": "tls.binding",
