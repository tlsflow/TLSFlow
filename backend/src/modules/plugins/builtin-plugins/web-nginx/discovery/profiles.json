      "configArgKeys": ["-c"],
      "rootArgKeys": ["-p"],
      "configFileNames": ["nginx.conf", "*.conf"],
      "certificateFileExtensions": [".cer", ".crt", ".der", ".pem"],
      "listeningPorts": [80, 443],
      "frameworkType": "web.nginx",
      "parserKind": "nginx"
