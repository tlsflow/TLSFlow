{
  "apiVersion": "gcac.workflow/v1",
  "kind": "CurlSshWorkflow",
  "metadata": {
    "name": "web-nginx-application-discover",
    "displayName": "Nginx 应用发现",
    "description": "只读取 Agent 已确认的运行时事实，并把目标交给统一 ManagedTarget 接入流程。",
    "category": "application",
    "tags": ["plugin", "web-nginx", "discover", "agent"],
    "version": "1.0.16",
    "platforms": ["linux", "windows"],
    "maintainer": "GCAC"
  },
  "inputContract": {
    "apiVersion": "gcac.deployment-input/v1",
    "variables": {},
    "connections": {},
    "credentials": {},
    "artifacts": {}
  },
  "steps": [
    {
      "name": "declareAgentFactDiscovery",
      "type": "transform",
      "stage": "prepare",
      "transform": {
        "engine": "jsonata",
        "input": {
          "pluginId": "web.nginx",
          "operation": "application.discover",
          "factSource": "agent.standard-discovery"
        },
        "outputs": {
          "discoveryRequest": { "expression": "$" }
        },
        "timeoutMs": 1000,
        "maxInputBytes": 65536,
        "maxOutputBytes": 65536
      }
    }
  ]
}
