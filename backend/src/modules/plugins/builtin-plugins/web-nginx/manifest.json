{
  "apiVersion": "gcac.plugin-manifest/v1",
  "kind": "GcacPlugin",
  "pluginId": "web.nginx",
  "version": "1.0.0",
  "displayNameKey": "plugin.webNginx.name",
  "descriptionKey": "plugin.webNginx.description",
  "defaultLocale": "zh-CN",
  "publisher": "GCAC",
  "runtime": "WORKFLOW_DSL",
  "source": "BUILTIN",
  "scope": "BOTH",
  "trust": "OFFICIAL_SIGNED",
  "support": "OFFICIAL",
  "capabilities": [
    { "key": "application.discover", "contractVersion": "v1", "actionContractId": "application.discover.v1", "riskLevel": "LOW", "executionLocations": ["CONTROL_PLANE", "AGENT"] },
    { "key": "certificate.deploy", "contractVersion": "v1", "actionContractId": "certificate.deploy.v1", "riskLevel": "HIGH", "executionLocations": ["CONTROL_PLANE", "AGENT"] },
    { "key": "certificate.verify", "contractVersion": "v1", "actionContractId": "certificate.verify.v1", "riskLevel": "MEDIUM", "executionLocations": ["CONTROL_PLANE", "AGENT"] },
    { "key": "certificate.rollback", "contractVersion": "v1", "actionContractId": "certificate.rollback.v1", "riskLevel": "HIGH", "executionLocations": ["CONTROL_PLANE", "AGENT"] }
  ],
  "permissions": ["artifact.read", "execution.checkpoint", "execution.progress", "resource.lock", "audit.append"],
  "compatibility": {
    "productFamilies": ["web.nginx"],
    "frameworkTypes": ["web.nginx"],
    "targetTypes": ["tls.binding"],
    "managementMethods": ["AGENT", "PLUGIN"],
    "executionLocations": ["CONTROL_PLANE", "AGENT"],
    "artifactContracts": ["certificate.deploy.v1"]
  },
  "resources": {
    "runtimeEntrypoint": "runtime/index.js",
    "workflows": {
      "application.discover": "workflows/discover.json",
      "certificate.deploy": "workflows/deploy.json",
      "certificate.verify": "workflows/verify.json",
      "certificate.rollback": "workflows/rollback.json"
    },
    "locales": {
      "zh-CN": "locales/zh-CN.json",
      "en-US": "locales/en-US.json"
    },
    "discoveryMappings": {
      "profiles": "discovery/profiles.json"
    },
    "presentations": {
      "application": "presentations/application.json",
      "certificateBinding": "presentations/certificate-binding.json"
    }
  }
}
