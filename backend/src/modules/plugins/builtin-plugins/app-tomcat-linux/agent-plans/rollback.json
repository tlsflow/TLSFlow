{
  "apiVersion": "gcac.certificate-update-plan/v1",
  "pluginId": "app.tomcat.linux",
  "capability": "certificate.rollback",
  "planId": "certificate.rollback",
  "writeEffect": true,
  "operations": [
    {
      "operationId": "restore-target",
      "operationType": "filesystem.restore",
      "stage": "prepare",
      "input": {
        "path": {
          "$ref": "paths.current"
        },
        "ledgerRef": "execution-recovery-ledger",
        "storageKind": "KEYSTORE"
      },
      "expandPathRef": "paths"
    },
    {
      "operationId": "stop-service",
      "operationType": "service.stop",
      "stage": "execute",
      "input": {
        "serviceName": {
          "$ref": "serviceName"
        }
      }
    },
    {
      "operationId": "start-service",
      "operationType": "service.start",
      "stage": "execute",
      "input": {
        "serviceName": {
          "$ref": "serviceName"
        }
      }
    },
    {
      "operationId": "verify-service",
      "operationType": "service.status",
      "stage": "verify",
      "input": {
        "serviceName": {
          "$ref": "serviceName"
        }
      }
    }
  ]
}
