{
  "apiVersion": "gcac.certificate-update-plan/v1",
  "pluginId": "web.nginx.windows",
  "capability": "certificate.verify",
  "planId": "certificate.verify",
  "writeEffect": false,
  "operations": [
    {
      "operationId": "verify-material",
      "operationType": "certificate.material.validate",
      "stage": "verify",
      "input": {
