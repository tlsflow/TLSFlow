{
  "apiVersion": "gcac.workflow/v1",
  "kind": "CurlSshWorkflow",
  "metadata": { "name": "citrix-adc-credential-health-check", "displayName": "Citrix ADC credential health check", "category": "device", "version": "2.0.23", "platforms": ["appliance"], "updateMethods": ["curl"], "maintainer": "GCAC" },
  "inputContract": {
    "apiVersion": "gcac.deployment-input/v1",
    "variables": {
      "allowInsecureTls": { "type": "boolean", "required": true, "configurationMode": "required", "source": { "kind": "binding" }, "lifecycle": "pre_execution", "bindingPolicy": "required_binding", "descriptionKey": "deploymentInputs.allowInsecureTls.description", "ui": { "labelKey": "deploymentInputs.allowInsecureTls.label", "group": "security", "order": 10, "helpKey": "deploymentInputs.allowInsecureTls.help" } }
    },
    "connections": {
      "management": {
        "transport": "http",
        "host": { "type": "string", "required": true, "configurationMode": "required", "source": { "kind": "binding" }, "lifecycle": "pre_execution", "bindingPolicy": "required_binding" },
        "port": { "type": "number", "required": true, "configurationMode": "advanced", "source": { "kind": "default" }, "lifecycle": "pre_execution", "bindingPolicy": "default_overridable", "default": 443 },
        "credentialSlot": "credential",
        "tls": { "verifyPeer": { "type": "boolean", "required": true, "configurationMode": "advanced", "source": { "kind": "default" }, "lifecycle": "pre_execution", "bindingPolicy": "default_overridable", "default": true } }
      }
    },
    "credentials": { "credential": { "allowedKinds": ["USERNAME_PASSWORD"], "required": true, "configurationMode": "required", "lifecycle": "pre_execution" } },
    "artifacts": {}
  },
  "steps": [
    {
      "name": "authenticate",
      "type": "http",
      "stage": "prepare",
      "request": { "method": "GET", "connectionRef": "management", "url": "/nitro/v1/config/nsversion", "headers": { "Accept": "application/json", "X-NITRO-USER": "{{credentials.credential.username}}", "X-NITRO-PASS": "{{credentials.credential.secretRefs.password}}" }, "tls": { "verify": "{{connections.management.tls.verifyPeer}}", "allowInsecure": true }, "timeoutSeconds": 30, "maxResponseBytes": 1048576, "failOnNon2xx": false },
      "extract": [
        { "name": "authStatusCode", "type": "statusCode" },
        { "name": "nitroErrorCode", "type": "jsonPath", "path": "$.errorcode", "optional": true }
      ]
    },
    {
      "name": "classifyAuthentication",
      "type": "transform",
      "stage": "verify",
      "transform": {
        "engine": "jsonata",
        "input": { "statusCode": "{{steps.authenticate.extracted.authStatusCode}}", "nitroErrorCode": "{{steps.authenticate.extracted.nitroErrorCode}}" },
        "outputs": {
          "credentialHealth": {
            "expression": "statusCode = 200 and nitroErrorCode = 0 ? {'apiVersion':'gcac.credential-health-result/v1','status':'VALID','summary':'设备认证成功','evidence':{'protocol':'NITRO','httpStatus':statusCode}} : (statusCode = 401 or statusCode = 403 or (statusCode = 200 and nitroErrorCode != 0) ? {'apiVersion':'gcac.credential-health-result/v1','status':'ERROR','reasonCode':'PASSWORD_INVALID','summary':'设备拒绝凭据认证','evidence':{'protocol':'NITRO','httpStatus':statusCode,'nitroErrorCode':nitroErrorCode}} : (statusCode >= 500 and statusCode <= 599 ? {'apiVersion':'gcac.credential-health-result/v1','status':'UNREACHABLE','reasonCode':'REMOTE_SERVICE_ERROR','summary':'设备远端服务暂时不可用','evidence':{'protocol':'NITRO','httpStatus':statusCode}} : {'apiVersion':'gcac.credential-health-result/v1','status':'UNREACHABLE','reasonCode':'NETWORK_UNREACHABLE','summary':'设备网络暂时不可达','evidence':{'protocol':'NITRO','httpStatus':statusCode}}))"
          }
        },
        "timeoutMs": 1000,
        "maxInputBytes": 1048576,
        "maxOutputBytes": 65536
      }
    }
  ]
}
