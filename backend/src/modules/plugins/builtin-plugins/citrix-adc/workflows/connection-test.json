{
  "apiVersion": "gcac.workflow/v1",
  "kind": "CurlSshWorkflow",
  "metadata": { "name": "citrix-adc-connection-test", "displayName": "Citrix ADC connection test", "category": "device", "version": "1.0.1", "platforms": ["appliance"], "updateMethods": ["curl"], "maintainer": "GCAC" },
  "variables": {
    "deviceHost": { "type": "string", "required": true },
    "managementPort": { "type": "number", "required": true, "default": 443 },
    "credential": { "type": "credential", "required": true, "sensitive": true },
    "tlsVerify": { "type": "boolean", "required": true, "default": true }
  },
  "steps": [
    {
      "name": "readVersion",
      "type": "http",
      "stage": "prepare",
      "request": {
        "method": "GET",
        "url": "https://{{deviceHost}}:{{managementPort}}/nitro/v1/config/nsversion",
        "headers": { "Accept": "application/json", "X-NITRO-USER": "{{credential.username}}", "X-NITRO-PASS": "{{credential.secretRefs.password}}" },
        "tls": { "verify": "{{tlsVerify}}", "allowInsecure": true },
        "timeoutSeconds": 30,
        "maxResponseBytes": 1048576,
        "successStatusCodes": [200]
      },
      "extract": [
        { "name": "productVersion", "type": "jsonPath", "path": "$.nsversion.version" },
        { "name": "nitroErrorCode", "type": "jsonPath", "path": "$.errorcode" }
      ],
      "assert": [
        { "type": "statusCode", "equals": 200 },
        { "type": "jsonPath", "path": "$.errorcode", "equals": 0 }
      ]
    }
  ]
}
