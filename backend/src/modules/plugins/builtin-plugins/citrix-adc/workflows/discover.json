{
  "apiVersion": "gcac.workflow/v1",
  "kind": "CurlSshWorkflow",
  "metadata": { "name": "citrix-adc-discover", "displayName": "Citrix ADC discovery", "category": "device", "version": "2.0.14", "platforms": ["appliance"], "updateMethods": ["curl"], "maintainer": "GCAC" },
  "inputContract": {
    "apiVersion": "gcac.deployment-input/v1",
    "variables": {},
    "connections": {
      "management": {
        "transport": "http",
        "host": { "type": "string", "required": true, "configurationMode": "required", "source": { "kind": "binding" }, "lifecycle": "pre_execution", "bindingPolicy": "required_binding" },
        "port": { "type": "number", "required": true, "configurationMode": "advanced", "source": { "kind": "default" }, "lifecycle": "pre_execution", "bindingPolicy": "default_overridable", "default": 443 },
        "credentialSlot": "credential",
        "tls": {
          "verifyPeer": { "type": "boolean", "required": true, "configurationMode": "advanced", "source": { "kind": "default" }, "lifecycle": "pre_execution", "bindingPolicy": "default_overridable", "default": true }
        }
      }
    },
    "credentials": {
      "credential": { "allowedKinds": ["USERNAME_PASSWORD"], "required": true, "configurationMode": "required", "lifecycle": "pre_execution" }
    },
    "artifacts": {}
  },
  "steps": [
    { "name": "readVersion", "type": "http", "stage": "prepare", "request": { "method": "GET", "connectionRef": "management", "url": "https://{{connections.management.host}}:{{connections.management.port}}/nitro/v1/config/nsversion", "headers": { "Accept": "application/json", "X-NITRO-USER": "{{credentials.credential.username}}", "X-NITRO-PASS": "{{credentials.credential.secretRefs.password}}" }, "tls": { "verify": "{{connections.management.tls.verifyPeer}}", "allowInsecure": true }, "successStatusCodes": [200] }, "extract": [{ "name": "versionResponse", "type": "outputPath", "path": "$.body" }], "assert": [{ "type": "jsonPath", "path": "$.errorcode", "equals": 0 }] },
    { "name": "readLbVirtualServers", "type": "http", "stage": "prepare", "request": { "method": "GET", "connectionRef": "management", "url": "https://{{connections.management.host}}:{{connections.management.port}}/nitro/v1/config/lbvserver", "headers": { "Accept": "application/json", "X-NITRO-USER": "{{credentials.credential.username}}", "X-NITRO-PASS": "{{credentials.credential.secretRefs.password}}" }, "tls": { "verify": "{{connections.management.tls.verifyPeer}}", "allowInsecure": true }, "successStatusCodes": [200] }, "extract": [{ "name": "lbResponse", "type": "outputPath", "path": "$.body" }], "assert": [{ "type": "jsonPath", "path": "$.errorcode", "equals": 0 }] },
    { "name": "readVpnVirtualServers", "type": "http", "stage": "prepare", "request": { "method": "GET", "connectionRef": "management", "url": "https://{{connections.management.host}}:{{connections.management.port}}/nitro/v1/config/vpnvserver", "headers": { "Accept": "application/json", "X-NITRO-USER": "{{credentials.credential.username}}", "X-NITRO-PASS": "{{credentials.credential.secretRefs.password}}" }, "tls": { "verify": "{{connections.management.tls.verifyPeer}}", "allowInsecure": true }, "successStatusCodes": [200] }, "extract": [{ "name": "vpnResponse", "type": "outputPath", "path": "$.body" }], "assert": [{ "type": "jsonPath", "path": "$.errorcode", "equals": 0 }] },
    { "name": "readCsVirtualServers", "type": "http", "stage": "prepare", "request": { "method": "GET", "connectionRef": "management", "url": "https://{{connections.management.host}}:{{connections.management.port}}/nitro/v1/config/csvserver", "headers": { "Accept": "application/json", "X-NITRO-USER": "{{credentials.credential.username}}", "X-NITRO-PASS": "{{credentials.credential.secretRefs.password}}" }, "tls": { "verify": "{{connections.management.tls.verifyPeer}}", "allowInsecure": true }, "successStatusCodes": [200] }, "extract": [{ "name": "csResponse", "type": "outputPath", "path": "$.body" }], "assert": [{ "type": "jsonPath", "path": "$.errorcode", "equals": 0 }] },
    { "name": "readGslbVirtualServers", "type": "http", "stage": "prepare", "request": { "method": "GET", "connectionRef": "management", "url": "https://{{connections.management.host}}:{{connections.management.port}}/nitro/v1/config/gslbvserver", "headers": { "Accept": "application/json", "X-NITRO-USER": "{{credentials.credential.username}}", "X-NITRO-PASS": "{{credentials.credential.secretRefs.password}}" }, "tls": { "verify": "{{connections.management.tls.verifyPeer}}", "allowInsecure": true }, "successStatusCodes": [200] }, "extract": [{ "name": "gslbResponse", "type": "outputPath", "path": "$.body" }], "assert": [{ "type": "jsonPath", "path": "$.errorcode", "equals": 0 }] },
    { "name": "readCertificateBindings", "type": "http", "stage": "prepare", "request": { "method": "GET", "connectionRef": "management", "url": "https://{{connections.management.host}}:{{connections.management.port}}/nitro/v1/config/sslvserver_sslcertkey_binding", "query": { "bulkbindings": "yes" }, "headers": { "Accept": "application/json", "X-NITRO-USER": "{{credentials.credential.username}}", "X-NITRO-PASS": "{{credentials.credential.secretRefs.password}}" }, "tls": { "verify": "{{connections.management.tls.verifyPeer}}", "allowInsecure": true }, "successStatusCodes": [200] }, "extract": [{ "name": "bindingResponse", "type": "outputPath", "path": "$.body" }], "assert": [{ "type": "jsonPath", "path": "$.errorcode", "equals": 0 }] },
    { "name": "readCertificates", "type": "http", "stage": "prepare", "request": { "method": "GET", "connectionRef": "management", "url": "https://{{connections.management.host}}:{{connections.management.port}}/nitro/v1/config/sslcertkey", "headers": { "Accept": "application/json", "X-NITRO-USER": "{{credentials.credential.username}}", "X-NITRO-PASS": "{{credentials.credential.secretRefs.password}}" }, "tls": { "verify": "{{connections.management.tls.verifyPeer}}", "allowInsecure": true }, "successStatusCodes": [200] }, "extract": [{ "name": "certificateResponse", "type": "outputPath", "path": "$.body" }], "assert": [{ "type": "jsonPath", "path": "$.errorcode", "equals": 0 }] },
    { "name": "normalizeCertificateFiles", "type": "transform", "stage": "prepare", "transform": { "engine": "jsonata", "input": { "certificates": "{{steps.readCertificates.extracted.certificateResponse.sslcertkey}}" }, "outputs": { "certificateFiles": { "expression": "$append([], $map($filter(certificates,function($c){($format := $c.inform ? $uppercase($c.inform) : ''; $isPkcs12Path := $match($lowercase($c.cert),/\\.(pfx|p12)$/); $c.cert and $format != 'PFX' and $format != 'PKCS12' and ($isPkcs12Path ? false : true))}), function($c){($path := $replace($c.cert,'\\\\','/'); $filename := $replace($path,/^.*\\//,''); $hasDirectory := $contains($path,'/'); $location := $hasDirectory ? $replace($path,/\\/[^\\/]*$/,'') : '/nsconfig/ssl'; {'certkey':$c.certkey,'filename':$encodeUrlComponent($filename),'filelocation':$encodeUrlComponent($location)})}))" } }, "timeoutMs": 1000, "maxInputBytes": 1048576, "maxOutputBytes": 1048576 } },
    { "name": "readCertificateFiles", "type": "foreach", "stage": "prepare", "foreach": { "itemsPath": "steps.normalizeCertificateFiles.extracted.certificateFiles", "itemVariable": "certificateFile", "maxItems": 512, "continueOnError": true, "steps": [
      { "name": "readCertificateFile", "type": "http", "request": { "method": "GET", "connectionRef": "management", "url": "https://{{connections.management.host}}:{{connections.management.port}}/nitro/v1/config/systemfile?args=filename:{{certificateFile.filename}},filelocation:{{certificateFile.filelocation}}", "headers": { "Accept": "application/json", "X-NITRO-USER": "{{credentials.credential.username}}", "X-NITRO-PASS": "{{credentials.credential.secretRefs.password}}" }, "tls": { "verify": "{{connections.management.tls.verifyPeer}}", "allowInsecure": true }, "successStatusCodes": [200] } },
      { "name": "fingerprintCertificateFile", "type": "transform", "transform": { "engine": "jsonata", "input": { "certkey": "{{certificateFile.certkey}}", "systemfile": "{{steps.readCertificateFile.output.body.systemfile}}" }, "outputs": { "certificateFingerprint": { "expression": "{'certkey':certkey,'sha256Fingerprint':$x509Sha256(systemfile[0].filecontent)}" } }, "timeoutMs": 1000, "maxInputBytes": 1048576, "maxOutputBytes": 65536 } }
    ] } },
    { "name": "collectCertificateFingerprints", "type": "transform", "stage": "prepare", "transform": { "engine": "jsonata", "input": { "iterations": "{{steps.readCertificateFiles.output.iterations}}" }, "outputs": { "certificateFingerprints": { "expression": "$append([], $map(iterations, function($iteration){$iteration.outputs[name='fingerprintCertificateFile'][0].output.body.outputs.certificateFingerprint}))" } }, "timeoutMs": 1000, "maxInputBytes": 1048576, "maxOutputBytes": 1048576 } },
    {
      "name": "projectDiscovery",
      "type": "transform",
      "stage": "verify",
      "transform": {
        "engine": "jsonata",
        "input": { "deviceHost": "{{connections.management.host}}", "version": "{{steps.readVersion.extracted.versionResponse}}", "lb": "{{steps.readLbVirtualServers.extracted.lbResponse}}", "vpn": "{{steps.readVpnVirtualServers.extracted.vpnResponse}}", "cs": "{{steps.readCsVirtualServers.extracted.csResponse}}", "gslb": "{{steps.readGslbVirtualServers.extracted.gslbResponse}}", "bindings": "{{steps.readCertificateBindings.extracted.bindingResponse}}", "certificates": "{{steps.readCertificates.extracted.certificateResponse}}", "certificateFingerprints": "{{steps.collectCertificateFingerprints.extracted.certificateFingerprints}}" },
        "outputs": {
          "discovery": { "expression": "($lbNames := $append([],lb.lbvserver.name); $vpnNames := $append([],vpn.vpnvserver.name); $csNames := $append([],cs.csvserver.name); $siteKey := function($name){($name in $lbNames ? 'LB:' : ($name in $vpnNames ? 'VPN:' : ($name in $csNames ? 'CS:' : 'GSLB:'))) & $name}; $fingerprint := function($name){$string(certificateFingerprints[certkey=$name].sha256Fingerprint)}; $lbSites := $append([],$map(lb.lbvserver[servicetype='SSL' or servicetype='SSL_TCP'],function($v){{'stableKey':'LB:' & $v.name,'frameworkStableKey':'framework:lbserver','siteType':'network.virtual-server','displayName':$v.name,'addresses':[$v.ipv46],'port':$v.port,'protocol':'HTTPS','metadata':{'virtualServerType':'LB'}}})); $vpnSites := $append([],$map(vpn.vpnvserver,function($v){{'stableKey':'VPN:' & $v.name,'frameworkStableKey':'framework:vpnserver','siteType':'network.virtual-server','displayName':$v.name,'addresses':[$v.ipv46],'port':$v.port,'protocol':'HTTPS','metadata':{'virtualServerType':'VPN'}}})); $csSites := $append([],$map(cs.csvserver[servicetype='SSL' or servicetype='SSL_TCP'],function($v){{'stableKey':'CS:' & $v.name,'frameworkStableKey':'framework:csserver','siteType':'network.virtual-server','displayName':$v.name,'addresses':[$v.ipv46],'port':$v.port,'protocol':'HTTPS','metadata':{'virtualServerType':'CS'}}})); $gslbSites := $append([],$map(gslb.gslbvserver,function($v){{'stableKey':'GSLB:' & $v.name,'frameworkStableKey':'framework:gslbserver','siteType':'network.virtual-server','displayName':$v.name,'addresses':[$v.ipv46],'port':$v.port,'protocol':'HTTPS','metadata':{'virtualServerType':'GSLB'}}})); $sites := $append($append($lbSites,$vpnSites),$append($csSites,$gslbSites)); $frameworks := $append($append($count($lbSites)>0 ? [{'stableKey':'framework:lbserver','frameworkType':'citrix.lb-server','displayName':'LBServer'}] : [],$count($vpnSites)>0 ? [{'stableKey':'framework:vpnserver','frameworkType':'citrix.vpn-server','displayName':'VPNServer'}] : []),$append($count($csSites)>0 ? [{'stableKey':'framework:csserver','frameworkType':'citrix.cs-server','displayName':'CSServer'}] : [],$count($gslbSites)>0 ? [{'stableKey':'framework:gslbserver','frameworkType':'citrix.gslb-server','displayName':'GSLBServer'}] : [])); {'apiVersion':'gcac.device-discovery/v2','device':{'stableKey':'citrix-adc:' & deviceHost,'displayName':deviceHost,'productFamily':'citrix.netscaler-adc','softwareVersion':version.nsversion.version,'managementAddress':deviceHost},'capabilities':[{'key':'device.discover','available':true},{'key':'certificate.deploy','available':true}],'frameworks':$frameworks,'sites':$sites,'managedTargets':[$map($sites,function($site){{'stableKey':'TARGET:' & $site.stableKey,'frameworkStableKey':$site.frameworkStableKey,'siteStableKey':$site.stableKey,'targetType':'tls.binding','targetKey':$site.stableKey,'supportedCapabilities':['certificate.deploy','certificate.verify','certificate.rollback'],'executionLocations':['CONTROL_PLANE','GATEWAY']}})],'certificates':[$map(certificates.sslcertkey,function($c){{'stableKey':'CERT:' & $c.certkey,'sha256Fingerprint':$fingerprint($c.certkey),'subject':$c.subject,'issuer':$c.issuer,'notBefore':$c.clientcertnotbefore,'notAfter':$c.clientcertnotafter,'metadata':{'certkey':$c.certkey,'certificatePath':$c.cert,'linkCertKeyName':$c.linkcertkeyname}}})],'certificateBindings':[$map(bindings.sslvserver_sslcertkey_binding,function($b){{'stableKey':'BINDING:' & $b.vservername & ':' & $b.certkeyname,'managedTargetStableKey':'TARGET:' & $siteKey($b.vservername),'certificateStableKey':'CERT:' & $b.certkeyname,'bindingName':$b.vservername,'metadata':{'sniCertificate':$b.snicert,'priority':$b.priority}}})],'warnings':[]})" }
        },
        "timeoutMs": 1000,
        "maxInputBytes": 1048576,
        "maxOutputBytes": 1048576
      }
    },
    {
      "name": "normalizeDiscovery",
      "type": "transform",
      "stage": "verify",
      "transform": {
        "engine": "jsonata",
        "input": { "discovery": "{{steps.projectDiscovery.extracted.discovery}}" },
        "outputs": {
          "discovery": {
            "expression": "($stable := function($value){($text := $string($value); $match($text,/^[A-Za-z0-9][A-Za-z0-9._:\\/-]{0,255}$/) ? $text : 'encoded:' & $replace($replace($replace($base64encode($text),'+','-'),'/','_'),'=',''))}; {'apiVersion':discovery.apiVersion,'device':$merge([discovery.device,{'metadata':$merge([discovery.device.metadata,{'managementProtocol':'NITRO API'}])}]),'capabilities':discovery.capabilities,'frameworks':$append([],$map(discovery.frameworks,function($framework){$merge([$framework,{'stableKey':$stable($framework.stableKey)}])})),'sites':$append([],$map(discovery.sites,function($site){$merge([$site,{'stableKey':$stable($site.stableKey),'frameworkStableKey':$stable($site.frameworkStableKey)}])})),'managedTargets':$append([],$map(discovery.managedTargets,function($target){$merge([$target,{'stableKey':$stable($target.stableKey),'frameworkStableKey':$stable($target.frameworkStableKey),'siteStableKey':$stable($target.siteStableKey),'targetKey':$stable($target.targetKey)}])})),'certificates':$append([],$map(discovery.certificates,function($certificate){$merge([$certificate,{'stableKey':$stable($certificate.stableKey)}])})),'certificateBindings':$append([],$map(discovery.certificateBindings,function($binding){$merge([$binding,{'stableKey':$stable($binding.stableKey),'managedTargetStableKey':$stable($binding.managedTargetStableKey),'certificateStableKey':$stable($binding.certificateStableKey)}])})),'warnings':discovery.warnings})"
          }
        },
        "timeoutMs": 1000,
        "maxInputBytes": 1048576,
        "maxOutputBytes": 1048576
      }
    }
  ]
}
