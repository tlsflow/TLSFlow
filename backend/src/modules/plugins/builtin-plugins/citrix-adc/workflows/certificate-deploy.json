{
  "apiVersion": "gcac.workflow/v1",
  "kind": "CurlSshWorkflow",
  "metadata": {
    "name": "citrix-adc-certificate-deploy",
    "displayName": "Citrix ADC certificate deployment",
    "category": "certificate",
    "version": "1.1.3",
    "platforms": ["appliance"],
    "updateMethods": ["curl"],
    "maintainer": "GCAC"
  },
  "inputContract": {
    "apiVersion": "gcac.deployment-input/v1",
    "variables": {
      "targetVirtualServers": { "type": "array", "required": true, "configurationMode": "runtime", "source": { "kind": "asset", "path": "deployment.targets" }, "lifecycle": "runtime_injected", "bindingPolicy": "fixed" },
      "certificateKeyName": { "type": "string", "required": true, "configurationMode": "runtime", "source": { "kind": "derived", "resolver": "certificate_resource_name" }, "lifecycle": "runtime_injected", "bindingPolicy": "fixed" }
    },
    "connections": {
      "management": {
        "transport": "http",
        "host": { "type": "string", "required": true, "configurationMode": "required", "source": { "kind": "binding" }, "lifecycle": "pre_execution", "bindingPolicy": "required_binding" },
        "port": { "type": "number", "required": true, "configurationMode": "advanced", "source": { "kind": "default" }, "lifecycle": "pre_execution", "bindingPolicy": "default_overridable", "default": 443 },
        "credentialSlot": "credential",
        "tls": {
          "verifyPeer": { "type": "boolean", "required": true, "configurationMode": "advanced", "source": { "kind": "default" }, "lifecycle": "pre_execution", "bindingPolicy": "default_overridable", "default": true }
        }
      }
    },
    "credentials": {
      "credential": { "allowedKinds": ["USERNAME_PASSWORD"], "required": true, "configurationMode": "required", "lifecycle": "pre_execution" }
    },
    "artifacts": {
      "certificate": {
        "kind": "certificate",
        "required": true,
        "configurationMode": "required",
        "lifecycle": "pre_execution",
        "artifactContract": {
          "outputs": {
            "leafPemBase64": { "role": "public_certificate", "required": true, "format": "PEM_BASE64", "encoding": "Base64" },
            "privateKeyPemBase64": { "role": "private_key", "required": true, "format": "PEM_BASE64", "encoding": "Base64", "sensitive": true },
            "orderedIntermediates": { "role": "certificate_chain", "required": false, "format": "PEM_BASE64_ARRAY", "encoding": "Base64" },
            "fingerprintSha256": { "role": "fingerprint_sha256", "required": true, "format": "HEX", "encoding": "UTF-8" }
          }
        }
      }
    }
  },
  "variables": {
    "targetVirtualServers": { "type": "array", "required": true },
    "certificateKeyName": { "type": "string", "required": true }
  },
  "steps": [
    {
      "name": "preflight",
      "type": "http",
      "stage": "prepare",
      "request": {
        "method": "GET",
        "connectionRef": "management",
        "url": "https://{{connections.management.host}}:{{connections.management.port}}/nitro/v1/config/nsversion",
        "headers": { "Accept": "application/json", "X-NITRO-USER": "{{credentials.credential.username}}", "X-NITRO-PASS": "{{credentials.credential.secretRefs.password}}" },
        "tls": { "verify": "{{connections.management.tls.verifyPeer}}", "allowInsecure": true },
        "successStatusCodes": [200]
      },
      "extract": {
        "deviceVersion": { "type": "firstOf", "paths": ["$.body.nsversion.version", "$.body.nsversion[0].version"], "optional": false }
      },
      "assert": [{ "type": "jsonPath", "path": "$.errorcode", "equals": 0 }]
    },
    {
      "name": "readOldBindings",
      "type": "http",
      "stage": "backup",
      "request": {
        "method": "GET",
        "connectionRef": "management",
        "url": "https://{{connections.management.host}}:{{connections.management.port}}/nitro/v1/config/sslvserver_sslcertkey_binding",
        "query": { "bulkbindings": "yes" },
        "headers": { "Accept": "application/json", "X-NITRO-USER": "{{credentials.credential.username}}", "X-NITRO-PASS": "{{credentials.credential.secretRefs.password}}" },
        "tls": { "verify": "{{connections.management.tls.verifyPeer}}", "allowInsecure": true },
        "successStatusCodes": [200]
      },
      "assert": [{ "type": "jsonPath", "path": "$.errorcode", "equals": 0 }]
    },
    {
      "name": "selectLiveBindings",
      "type": "transform",
      "stage": "backup",
      "transform": {
        "engine": "jsonata",
        "input": {
          "bindings": "{{steps.readOldBindings.output.body.sslvserver_sslcertkey_binding}}",
          "targets": "{{variables.targetVirtualServers}}",
          "newCertificateKeyName": "{{variables.certificateKeyName}}"
        },
        "outputs": {
          "targetBindings": { "expression": "$append([], $filter(bindings, function($binding) { $binding.vservername in targets.name }))" },
          "oldCertificateKeys": { "expression": "$append([], $map($distinct($filter(bindings, function($binding) { $binding.vservername in targets.name and $binding.certkeyname != newCertificateKeyName }).certkeyname), function($name) { {'name': $name} }))" }
        },
        "timeoutMs": 1000
      }
    },
    {
      "name": "readOldCertKeys",
      "type": "foreach",
      "stage": "backup",
      "foreach": {
        "itemsPath": "steps.selectLiveBindings.extracted.oldCertificateKeys",
        "itemVariable": "oldCertificateKey",
        "maxItems": 256,
        "steps": [
          {
            "name": "readOldCertKey",
            "type": "http",
            "request": {
              "method": "GET",
              "connectionRef": "management",
              "url": "https://{{connections.management.host}}:{{connections.management.port}}/nitro/v1/config/sslcertkey/{{oldCertificateKey.name}}",
              "headers": { "Accept": "application/json", "X-NITRO-USER": "{{credentials.credential.username}}", "X-NITRO-PASS": "{{credentials.credential.secretRefs.password}}" },
              "tls": { "verify": "{{connections.management.tls.verifyPeer}}", "allowInsecure": true },
              "successStatusCodes": [200]
            },
            "assert": [{ "type": "jsonPath", "path": "$.errorcode", "equals": 0 }]
          }
        ]
      }
    },
    {
      "name": "buildDeploymentSnapshot",
      "type": "transform",
      "stage": "backup",
      "transform": {
        "engine": "jsonata",
        "input": {
          "version": "{{steps.preflight.extracted.deviceVersion}}",
          "versionResponse": "{{steps.preflight.output.body}}",
          "allBindings": "{{steps.readOldBindings.output.body.sslvserver_sslcertkey_binding}}",
          "bindings": "{{steps.selectLiveBindings.extracted.targetBindings}}",
          "certkeyIterations": "{{steps.readOldCertKeys.output.iterations}}",
          "targets": "{{variables.targetVirtualServers}}",
          "newCertificateKeyName": "{{variables.certificateKeyName}}",
          "targetFingerprintSha256": "{{artifacts.certificate.outputs.fingerprintSha256}}"
        },
        "outputs": {
          "deploymentSnapshot": {
            "expression": "{'deviceVersion': version, 'versionResponse': versionResponse, 'bindings': bindings, 'certkeys': $append([], $map(certkeyIterations, function($iteration) { {'resource': $iteration.outputs[0].output.body.sslcertkey, 'sharedBindings': $filter(allBindings, function($binding) { $binding.certkeyname in $iteration.outputs[0].output.body.sslcertkey.certkey })} })), 'targets': targets, 'newCertificateKeyName': newCertificateKeyName, 'targetFingerprintSha256': targetFingerprintSha256}"
          }
        },
        "timeoutMs": 1000
      }
    },
    {
      "name": "deploymentCheckpoint",
      "type": "checkpoint",
      "stage": "backup",
      "checkpoint": {
        "name": "citrix-adc-certificate-deployment",
        "capture": {
          "snapshot": "steps.buildDeploymentSnapshot.extracted.deploymentSnapshot"
        },
        "normalizedHash": true,
        "requiredForRollback": true
      }
    },
    {
      "name": "uploadLeafCertificate",
      "type": "http",
      "stage": "install",
      "request": {
        "method": "POST",
        "connectionRef": "management",
        "url": "https://{{connections.management.host}}:{{connections.management.port}}/nitro/v1/config/systemfile",
        "headers": { "Content-Type": "application/json", "X-NITRO-USER": "{{credentials.credential.username}}", "X-NITRO-PASS": "{{credentials.credential.secretRefs.password}}" },
        "bodyType": "json",
        "body": { "systemfile": { "filename": "{{variables.certificateKeyName}}.pem", "filelocation": "/nsconfig/ssl", "filecontent": "{{artifacts.certificate.outputs.leafPemBase64}}", "fileencoding": "BASE64" } },
        "tls": { "verify": "{{connections.management.tls.verifyPeer}}", "allowInsecure": true },
        "successStatusCodes": [200, 201]
      }
    },
    {
      "name": "uploadPrivateKey",
      "type": "http",
      "stage": "install",
      "request": {
        "method": "POST",
        "connectionRef": "management",
        "url": "https://{{connections.management.host}}:{{connections.management.port}}/nitro/v1/config/systemfile",
        "headers": { "Content-Type": "application/json", "X-NITRO-USER": "{{credentials.credential.username}}", "X-NITRO-PASS": "{{credentials.credential.secretRefs.password}}" },
        "bodyType": "json",
        "body": { "systemfile": { "filename": "{{variables.certificateKeyName}}.key", "filelocation": "/nsconfig/ssl", "filecontent": "{{artifacts.certificate.outputs.privateKeyPemBase64}}", "fileencoding": "BASE64" } },
        "tls": { "verify": "{{connections.management.tls.verifyPeer}}", "allowInsecure": true },
        "successStatusCodes": [200, 201]
      }
    },
    {
      "name": "installIntermediates",
      "type": "foreach",
      "stage": "install",
      "foreach": {
        "itemsPath": "artifacts.certificate.outputs.orderedIntermediates",
        "itemVariable": "intermediate",
        "maxItems": 16,
        "steps": [
          {
            "name": "uploadIntermediate",
            "type": "http",
            "request": {
              "method": "POST",
              "connectionRef": "management",
              "url": "https://{{connections.management.host}}:{{connections.management.port}}/nitro/v1/config/systemfile",
              "headers": { "Content-Type": "application/json", "X-NITRO-USER": "{{credentials.credential.username}}", "X-NITRO-PASS": "{{credentials.credential.secretRefs.password}}" },
              "bodyType": "json",
              "body": { "systemfile": { "filename": "{{variables.certificateKeyName}}-ca-{{intermediate.sequence}}.pem", "filelocation": "/nsconfig/ssl", "filecontent": "{{intermediate.pemBase64}}", "fileencoding": "BASE64" } },
              "tls": { "verify": "{{connections.management.tls.verifyPeer}}", "allowInsecure": true },
              "successStatusCodes": [200, 201]
            }
          },
          {
            "name": "createIntermediateCertKey",
            "type": "http",
            "request": {
              "method": "POST",
              "connectionRef": "management",
              "url": "https://{{connections.management.host}}:{{connections.management.port}}/nitro/v1/config/sslcertkey",
              "headers": { "Content-Type": "application/json", "X-NITRO-USER": "{{credentials.credential.username}}", "X-NITRO-PASS": "{{credentials.credential.secretRefs.password}}" },
              "bodyType": "json",
              "body": { "sslcertkey": { "certkey": "{{variables.certificateKeyName}}-ca-{{intermediate.sequence}}", "cert": "/nsconfig/ssl/{{variables.certificateKeyName}}-ca-{{intermediate.sequence}}.pem" } },
              "tls": { "verify": "{{connections.management.tls.verifyPeer}}", "allowInsecure": true },
              "successStatusCodes": [200, 201]
            }
          },
          {
            "name": "linkIntermediateCertKey",
            "type": "http",
            "when": { "variable": "intermediate.hasNext", "equals": true },
            "request": {
              "method": "POST",
              "connectionRef": "management",
              "url": "https://{{connections.management.host}}:{{connections.management.port}}/nitro/v1/config/sslcertkey",
              "query": { "action": "link" },
              "headers": { "Content-Type": "application/json", "X-NITRO-USER": "{{credentials.credential.username}}", "X-NITRO-PASS": "{{credentials.credential.secretRefs.password}}" },
              "bodyType": "json",
              "body": { "sslcertkey": { "certkey": "{{variables.certificateKeyName}}-ca-{{intermediate.sequence}}", "linkcertkeyname": "{{variables.certificateKeyName}}-ca-{{intermediate.nextSequence}}" } },
              "tls": { "verify": "{{connections.management.tls.verifyPeer}}", "allowInsecure": true },
              "successStatusCodes": [200, 201]
            }
          }
        ]
      }
    },
    {
      "name": "createLeafCertKey",
      "type": "http",
      "stage": "install",
      "request": {
        "method": "POST",
        "connectionRef": "management",
        "url": "https://{{connections.management.host}}:{{connections.management.port}}/nitro/v1/config/sslcertkey",
        "headers": { "Content-Type": "application/json", "X-NITRO-USER": "{{credentials.credential.username}}", "X-NITRO-PASS": "{{credentials.credential.secretRefs.password}}" },
        "bodyType": "json",
        "body": { "sslcertkey": { "certkey": "{{variables.certificateKeyName}}", "cert": "/nsconfig/ssl/{{variables.certificateKeyName}}.pem", "key": "/nsconfig/ssl/{{variables.certificateKeyName}}.key" } },
        "tls": { "verify": "{{connections.management.tls.verifyPeer}}", "allowInsecure": true },
        "successStatusCodes": [200, 201]
      }
    },
    {
      "name": "linkLeafCertKey",
      "type": "http",
      "stage": "install",
      "when": { "variable": "artifacts.certificate.outputs.orderedIntermediates.0.sequence", "exists": true },
      "request": {
        "method": "POST",
        "connectionRef": "management",
        "url": "https://{{connections.management.host}}:{{connections.management.port}}/nitro/v1/config/sslcertkey",
        "query": { "action": "link" },
        "headers": { "Content-Type": "application/json", "X-NITRO-USER": "{{credentials.credential.username}}", "X-NITRO-PASS": "{{credentials.credential.secretRefs.password}}" },
        "bodyType": "json",
        "body": { "sslcertkey": { "certkey": "{{variables.certificateKeyName}}", "linkcertkeyname": "{{variables.certificateKeyName}}-ca-1" } },
        "tls": { "verify": "{{connections.management.tls.verifyPeer}}", "allowInsecure": true },
        "successStatusCodes": [200, 201]
      }
    },
    {
      "name": "bindTargets",
      "type": "foreach",
      "stage": "refresh",
      "foreach": {
        "itemsPath": "variables.targetVirtualServers",
        "itemVariable": "target",
        "maxItems": 1000,
        "steps": [
          {
            "name": "bindNewCertificate",
            "type": "http",
            "request": {
              "method": "POST",
              "connectionRef": "management",
              "url": "https://{{connections.management.host}}:{{connections.management.port}}/nitro/v1/config/sslvserver_sslcertkey_binding",
              "headers": { "Content-Type": "application/json", "X-NITRO-USER": "{{credentials.credential.username}}", "X-NITRO-PASS": "{{credentials.credential.secretRefs.password}}" },
              "bodyType": "json",
              "body": { "sslvserver_sslcertkey_binding": { "vservername": "{{target.name}}", "certkeyname": "{{variables.certificateKeyName}}", "snicert": "{{target.sniCertificate}}" } },
              "tls": { "verify": "{{connections.management.tls.verifyPeer}}", "allowInsecure": true },
              "successStatusCodes": [200, 201]
            }
          },
          {
            "name": "verifyNewBinding",
            "type": "http",
            "request": {
              "method": "GET",
              "connectionRef": "management",
              "url": "https://{{connections.management.host}}:{{connections.management.port}}/nitro/v1/config/sslvserver_sslcertkey_binding/{{target.name}}",
              "headers": { "Accept": "application/json", "X-NITRO-USER": "{{credentials.credential.username}}", "X-NITRO-PASS": "{{credentials.credential.secretRefs.password}}" },
              "tls": { "verify": "{{connections.management.tls.verifyPeer}}", "allowInsecure": true },
              "successStatusCodes": [200]
            },
            "assert": [
              { "type": "jsonPath", "path": "$.errorcode", "equals": 0 },
              { "type": "contains", "value": "{{variables.certificateKeyName}}" }
            ]
          }
        ]
      }
    },
    {
      "name": "removeOldBindings",
      "type": "foreach",
      "stage": "refresh",
      "foreach": {
        "itemsPath": "steps.selectLiveBindings.extracted.targetBindings",
        "itemVariable": "oldBinding",
        "maxItems": 1000,
        "steps": [
          {
            "name": "removeOldBinding",
            "type": "http",
            "when": { "variable": "oldBinding.certkeyname", "notEquals": "{{variables.certificateKeyName}}" },
            "request": {
              "method": "DELETE",
              "connectionRef": "management",
              "url": "https://{{connections.management.host}}:{{connections.management.port}}/nitro/v1/config/sslvserver_sslcertkey_binding/{{oldBinding.vservername}}?args=certkeyname:{{oldBinding.certkeyname}}",
              "headers": { "Accept": "application/json", "X-NITRO-USER": "{{credentials.credential.username}}", "X-NITRO-PASS": "{{credentials.credential.secretRefs.password}}" },
              "tls": { "verify": "{{connections.management.tls.verifyPeer}}", "allowInsecure": true },
              "successStatusCodes": [200, 201]
            }
          }
        ]
      }
    },
    {
      "name": "saveConfiguration",
      "type": "http",
      "stage": "refresh",
      "request": {
        "method": "POST",
        "connectionRef": "management",
        "url": "https://{{connections.management.host}}:{{connections.management.port}}/nitro/v1/config/nsconfig",
        "query": { "action": "save" },
        "headers": { "Content-Type": "application/json", "X-NITRO-USER": "{{credentials.credential.username}}", "X-NITRO-PASS": "{{credentials.credential.secretRefs.password}}" },
        "bodyType": "json",
        "body": { "nsconfig": {} },
        "tls": { "verify": "{{connections.management.tls.verifyPeer}}", "allowInsecure": true },
        "successStatusCodes": [200]
      },
      "assert": [{ "type": "jsonPath", "path": "$.errorcode", "equals": 0 }]
    },
    {
      "name": "verifyCertificateControlPlane",
      "type": "http",
      "stage": "verify",
      "request": {
        "method": "GET",
        "connectionRef": "management",
        "url": "https://{{connections.management.host}}:{{connections.management.port}}/nitro/v1/config/sslcertkey/{{variables.certificateKeyName}}",
        "headers": { "Accept": "application/json", "X-NITRO-USER": "{{credentials.credential.username}}", "X-NITRO-PASS": "{{credentials.credential.secretRefs.password}}" },
        "tls": { "verify": "{{connections.management.tls.verifyPeer}}", "allowInsecure": true },
        "successStatusCodes": [200]
      },
      "assert": [
        { "type": "jsonPath", "path": "$.errorcode", "equals": 0 },
        { "type": "contains", "value": "Valid" }
      ]
    }
  ],
  "rollback": [
    {
      "name": "rollbackReadCurrentVersion",
      "type": "http",
      "stage": "prepare",
      "request": {
        "method": "GET",
        "connectionRef": "management",
        "url": "https://{{connections.management.host}}:{{connections.management.port}}/nitro/v1/config/nsversion",
        "headers": { "Accept": "application/json", "X-NITRO-USER": "{{credentials.credential.username}}", "X-NITRO-PASS": "{{credentials.credential.secretRefs.password}}" },
        "tls": { "verify": "{{connections.management.tls.verifyPeer}}", "allowInsecure": true },
        "successStatusCodes": [200]
      },
      "extract": { "rollbackDeviceVersion": { "type": "firstOf", "paths": ["$.body.nsversion.version", "$.body.nsversion[0].version"] } },
      "assert": [{ "type": "jsonPath", "path": "$.errorcode", "equals": 0 }]
    },
    {
      "name": "rollbackVerifyDeviceVersion",
      "type": "condition",
      "stage": "prepare",
      "condition": { "variable": "steps.rollbackReadCurrentVersion.extracted.rollbackDeviceVersion", "equals": "{{steps.buildDeploymentSnapshot.extracted.deploymentSnapshot.deviceVersion}}" },
      "description": "设备版本或 Build 漂移时停止自动回滚"
    },
    {
      "name": "rollbackRestoreOldBindings",
      "type": "foreach",
      "stage": "refresh",
      "foreach": {
        "itemsPath": "steps.buildDeploymentSnapshot.extracted.deploymentSnapshot.bindings",
        "itemVariable": "rollbackOldBinding",
        "maxItems": 1000,
        "steps": [
          {
            "name": "rollbackRestoreOldBinding",
            "type": "http",
            "request": {
              "method": "POST",
              "connectionRef": "management",
              "url": "https://{{connections.management.host}}:{{connections.management.port}}/nitro/v1/config/sslvserver_sslcertkey_binding",
              "headers": { "Content-Type": "application/json", "X-NITRO-USER": "{{credentials.credential.username}}", "X-NITRO-PASS": "{{credentials.credential.secretRefs.password}}" },
              "bodyType": "json",
              "body": { "sslvserver_sslcertkey_binding": "{{rollbackOldBinding}}" },
              "tls": { "verify": "{{connections.management.tls.verifyPeer}}", "allowInsecure": true },
              "successStatusCodes": [200, 201]
            }
          }
        ]
      }
    },
    {
      "name": "rollbackReadBindingsAfterRestore",
      "type": "http",
      "stage": "refresh",
      "request": {
        "method": "GET",
        "connectionRef": "management",
        "url": "https://{{connections.management.host}}:{{connections.management.port}}/nitro/v1/config/sslvserver_sslcertkey_binding",
        "query": { "bulkbindings": "yes" },
        "headers": { "Accept": "application/json", "X-NITRO-USER": "{{credentials.credential.username}}", "X-NITRO-PASS": "{{credentials.credential.secretRefs.password}}" },
        "tls": { "verify": "{{connections.management.tls.verifyPeer}}", "allowInsecure": true },
        "successStatusCodes": [200]
      },
      "assert": [{ "type": "jsonPath", "path": "$.errorcode", "equals": 0 }]
    },
    {
      "name": "rollbackCompareRestoredBindings",
      "type": "transform",
      "stage": "refresh",
      "transform": {
        "engine": "jsonata",
        "input": { "expected": "{{steps.buildDeploymentSnapshot.extracted.deploymentSnapshot.bindings}}", "actual": "{{steps.rollbackReadBindingsAfterRestore.output.body.sslvserver_sslcertkey_binding}}" },
        "outputs": {
          "rollbackOldBindingsRestored": { "expression": "$count($filter(expected, function($item) { $count($filter(actual, function($candidate) { $candidate.vservername = $item.vservername and $candidate.certkeyname = $item.certkeyname and $candidate.snicert = $item.snicert and $candidate.priority = $item.priority })) = 1 })) = $count(expected)" }
        },
        "timeoutMs": 1000
      }
    },
    {
      "name": "rollbackRequireOldBindingsRestored",
      "type": "condition",
      "stage": "refresh",
      "condition": { "variable": "steps.rollbackCompareRestoredBindings.extracted.rollbackOldBindingsRestored", "equals": true }
    },
    {
      "name": "rollbackRemoveNewBindings",
      "type": "foreach",
      "stage": "refresh",
      "foreach": {
        "itemsPath": "steps.buildDeploymentSnapshot.extracted.deploymentSnapshot.targets",
        "itemVariable": "rollbackTarget",
        "maxItems": 1000,
        "steps": [
          {
            "name": "rollbackRemoveNewBinding",
            "type": "http",
            "request": {
              "method": "DELETE",
              "connectionRef": "management",
              "url": "https://{{connections.management.host}}:{{connections.management.port}}/nitro/v1/config/sslvserver_sslcertkey_binding/{{rollbackTarget.name}}?args=certkeyname:{{steps.buildDeploymentSnapshot.extracted.deploymentSnapshot.newCertificateKeyName}}",
              "headers": { "Accept": "application/json", "X-NITRO-USER": "{{credentials.credential.username}}", "X-NITRO-PASS": "{{credentials.credential.secretRefs.password}}" },
              "tls": { "verify": "{{connections.management.tls.verifyPeer}}", "allowInsecure": true },
              "successStatusCodes": [200, 201]
            }
          }
        ]
      }
    },
    {
      "name": "rollbackReadFinalBindings",
      "type": "http",
      "stage": "verify",
      "request": {
        "method": "GET",
        "connectionRef": "management",
        "url": "https://{{connections.management.host}}:{{connections.management.port}}/nitro/v1/config/sslvserver_sslcertkey_binding",
        "query": { "bulkbindings": "yes" },
        "headers": { "Accept": "application/json", "X-NITRO-USER": "{{credentials.credential.username}}", "X-NITRO-PASS": "{{credentials.credential.secretRefs.password}}" },
        "tls": { "verify": "{{connections.management.tls.verifyPeer}}", "allowInsecure": true },
        "successStatusCodes": [200]
      },
      "assert": [{ "type": "jsonPath", "path": "$.errorcode", "equals": 0 }]
    },
    {
      "name": "rollbackCompareFinalBindings",
      "type": "transform",
      "stage": "verify",
      "transform": {
        "engine": "jsonata",
        "input": { "expected": "{{steps.buildDeploymentSnapshot.extracted.deploymentSnapshot.bindings}}", "actual": "{{steps.rollbackReadFinalBindings.output.body.sslvserver_sslcertkey_binding}}", "targets": "{{steps.buildDeploymentSnapshot.extracted.deploymentSnapshot.targets}}" },
        "outputs": {
          "rollbackFinalBindingsEquivalent": { "expression": "$count($filter(actual, function($item) { $item.vservername in targets.name })) = $count(expected) and $count($filter(expected, function($item) { $count($filter(actual, function($candidate) { $candidate.vservername = $item.vservername and $candidate.certkeyname = $item.certkeyname and $candidate.snicert = $item.snicert and $candidate.priority = $item.priority })) = 1 })) = $count(expected)" }
        },
        "timeoutMs": 1000
      }
    },
    {
      "name": "rollbackRequireFinalBindingsEquivalent",
      "type": "condition",
      "stage": "verify",
      "condition": { "variable": "steps.rollbackCompareFinalBindings.extracted.rollbackFinalBindingsEquivalent", "equals": true }
    },
    {
      "name": "rollbackSaveConfiguration",
      "type": "http",
      "stage": "verify",
      "request": {
        "method": "POST",
        "connectionRef": "management",
        "url": "https://{{connections.management.host}}:{{connections.management.port}}/nitro/v1/config/nsconfig",
        "query": { "action": "save" },
        "headers": { "Content-Type": "application/json", "X-NITRO-USER": "{{credentials.credential.username}}", "X-NITRO-PASS": "{{credentials.credential.secretRefs.password}}" },
        "bodyType": "json",
        "body": { "nsconfig": {} },
        "tls": { "verify": "{{connections.management.tls.verifyPeer}}", "allowInsecure": true },
        "successStatusCodes": [200]
      },
      "assert": [{ "type": "jsonPath", "path": "$.errorcode", "equals": 0 }]
    }
  ]
}
