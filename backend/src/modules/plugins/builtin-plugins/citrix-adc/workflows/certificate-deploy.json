{
  "apiVersion": "gcac.workflow/v1",
  "kind": "CurlSshWorkflow",
  "metadata": {
    "name": "citrix-adc-certificate-deploy",
    "displayName": "Citrix ADC certificate deployment",
    "category": "certificate",
    "version": "2.0.4",
    "platforms": ["appliance"],
    "updateMethods": ["curl"],
    "maintainer": "GCAC"
  },
  "inputContract": {
    "apiVersion": "gcac.deployment-input/v1",
    "variables": {
      "targetVirtualServers": { "type": "array", "required": true, "configurationMode": "runtime", "source": { "kind": "asset", "path": "deployment.targets" }, "lifecycle": "pre_execution", "bindingPolicy": "fixed" },
      "certificateKeyName": { "type": "string", "required": true, "configurationMode": "runtime", "source": { "kind": "derived", "resolver": "certificate_resource_name" }, "lifecycle": "pre_execution", "bindingPolicy": "fixed" },
      "allowInsecureTls": {
        "type": "boolean",
        "required": true,
        "configurationMode": "required",
        "source": { "kind": "binding" },
        "lifecycle": "pre_execution",
        "bindingPolicy": "required_binding",
        "descriptionKey": "deploymentInputs.allowInsecureTls.description",
        "ui": {
          "labelKey": "deploymentInputs.allowInsecureTls.label",
          "group": "security",
          "order": 10,
          "helpKey": "deploymentInputs.allowInsecureTls.help"
        }
      },
      "recoverySnapshot": { "type": "object", "required": false, "configurationMode": "advanced", "source": { "kind": "binding" }, "lifecycle": "pre_execution", "bindingPolicy": "default_overridable", "sensitive": true },
      "recoverySnapshotHash": { "type": "string", "required": false, "configurationMode": "advanced", "source": { "kind": "binding" }, "lifecycle": "pre_execution", "bindingPolicy": "default_overridable" }
    },
    "connections": {
      "management": {
        "transport": "http",
        "host": { "type": "string", "required": true, "configurationMode": "required", "source": { "kind": "binding" }, "lifecycle": "pre_execution", "bindingPolicy": "required_binding" },
        "port": { "type": "number", "required": true, "configurationMode": "advanced", "source": { "kind": "default" }, "lifecycle": "pre_execution", "bindingPolicy": "default_overridable", "default": 443 },
        "credentialSlot": "credential",
        "tls": {
          "verifyPeer": { "type": "boolean", "required": true, "configurationMode": "advanced", "source": { "kind": "default" }, "lifecycle": "pre_execution", "bindingPolicy": "default_overridable", "default": true }
        }
      }
    },
    "credentials": {
      "credential": { "allowedKinds": ["USERNAME_PASSWORD"], "required": true, "configurationMode": "required", "lifecycle": "pre_execution" }
    },
    "artifacts": {
      "certificate": {
        "kind": "certificate",
        "required": true,
        "configurationMode": "required",
        "lifecycle": "pre_execution",
        "artifactContract": {
          "outputs": {
            "leafPemBase64": { "role": "public_certificate", "required": true, "format": "PEM_BASE64", "encoding": "Base64" },
            "privateKeyPemBase64": { "role": "private_key", "required": true, "format": "PEM_BASE64", "encoding": "Base64", "sensitive": true },
            "orderedIntermediates": { "role": "certificate_chain", "required": false, "format": "PEM_BASE64_ARRAY", "encoding": "Base64" },
            "fingerprintSha256": { "role": "fingerprint_sha256", "required": true, "format": "HEX", "encoding": "UTF-8" }
          }
        }
      }
    }
  },
  "steps": [
    {
      "name": "preflight",
      "type": "http",
      "stage": "prepare",
      "request": {
        "method": "GET",
        "connectionRef": "management",
        "url": "https://{{connections.management.host}}:{{connections.management.port}}/nitro/v1/config/nsversion",
        "headers": { "Accept": "application/json", "X-NITRO-USER": "{{credentials.credential.username}}", "X-NITRO-PASS": "{{credentials.credential.secretRefs.password}}" },
        "tls": { "verify": "{{connections.management.tls.verifyPeer}}", "allowInsecure": true },
        "successStatusCodes": [200]
      },
      "extract": {
        "deviceVersion": { "type": "firstOf", "paths": ["$.body.nsversion.version", "$.body.nsversion[0].version"], "optional": false }
      },
      "assert": [{ "type": "jsonPath", "path": "$.errorcode", "equals": 0 }]
    },
    {
      "name": "readOldBindings",
      "type": "http",
      "stage": "backup",
      "request": {
        "method": "GET",
        "connectionRef": "management",
        "url": "https://{{connections.management.host}}:{{connections.management.port}}/nitro/v1/config/sslvserver_sslcertkey_binding",
        "query": { "bulkbindings": "yes" },
        "headers": { "Accept": "application/json", "X-NITRO-USER": "{{credentials.credential.username}}", "X-NITRO-PASS": "{{credentials.credential.secretRefs.password}}" },
        "tls": { "verify": "{{connections.management.tls.verifyPeer}}", "allowInsecure": true },
        "successStatusCodes": [200]
      },
      "assert": [{ "type": "jsonPath", "path": "$.errorcode", "equals": 0 }]
    },
    {
      "name": "deriveCitrixNames",
      "type": "transform",
      "stage": "backup",
      "transform": {
        "engine": "jsonata",
        "input": {
          "certificateFingerprint": "{{artifacts.certificate.outputs.fingerprintSha256}}"
        },
        "outputs": {
          "citrixCertificateKeyName": {
            "expression": "'gcac-' & $substring($replace($lowercase($string(certificateFingerprint)), /[^0-9a-f]/, ''), 0, 16)"
          }
        },
        "timeoutMs": 1000
      }
    },
    {
      "name": "selectLiveBindings",
      "type": "transform",
      "stage": "backup",
      "transform": {
        "engine": "jsonata",
        "input": {
          "bindings": "{{steps.readOldBindings.output.body.sslvserver_sslcertkey_binding}}",
          "targets": "{{variables.targetVirtualServers}}",
          "newCertificateKeyName": "{{steps.deriveCitrixNames.extracted.citrixCertificateKeyName}}"
        },
        "outputs": {
          "targetBindings": { "expression": "$append([], $filter(bindings, function($binding) { $binding.vservername in targets.name }))" },
          "oldCertificateKeys": { "expression": "$append([], $map($distinct($filter(bindings, function($binding) { $binding.vservername in targets.name and $binding.certkeyname != newCertificateKeyName }).certkeyname), function($name) { {'name': $name} }))" },
          "deploymentTargets": { "expression": "$append([], $map(targets, function($target) { $merge([$target, {'metadata': $merge([{}, $target.metadata, {'sniCertificate': $exists($target.metadata.sniCertificate) ? $boolean($target.metadata.sniCertificate) : $count($filter(bindings, function($binding) { $binding.vservername = $target.name and $binding.snicert = true })) > 0}])}]) }))" }
        },
        "timeoutMs": 1000
      }
    },
    {
      "name": "readExistingCertKeys",
      "type": "http",
      "stage": "backup",
      "request": {
        "method": "GET",
        "connectionRef": "management",
        "url": "https://{{connections.management.host}}:{{connections.management.port}}/nitro/v1/config/sslcertkey",
        "headers": { "Accept": "application/json", "X-NITRO-USER": "{{credentials.credential.username}}", "X-NITRO-PASS": "{{credentials.credential.secretRefs.password}}" },
        "tls": { "verify": "{{connections.management.tls.verifyPeer}}", "allowInsecure": true },
        "successStatusCodes": [200]
      },
      "assert": [{ "type": "jsonPath", "path": "$.errorcode", "equals": 0 }]
    },
    {
      "name": "prepareCertificateResources",
      "type": "transform",
      "stage": "backup",
      "transform": {
        "engine": "jsonata",
        "input": {
          "leafName": "{{steps.deriveCitrixNames.extracted.citrixCertificateKeyName}}",
          "existingCertkeys": "{{steps.readExistingCertKeys.output.body.sslcertkey}}"
        },
        "outputs": {
          "leafCertKeyExists": {
            "expression": "$count($filter(existingCertkeys, function($certkey) { $certkey.certkey = leafName })) > 0"
          }
        },
        "timeoutMs": 1000
      }
    },
    {
      "name": "readOldCertKeys",
      "type": "foreach",
      "stage": "backup",
      "foreach": {
        "itemsPath": "steps.selectLiveBindings.extracted.oldCertificateKeys",
        "itemVariable": "oldCertificateKey",
        "maxItems": 256,
        "steps": [
          {
            "name": "readOldCertKey",
            "type": "http",
            "request": {
              "method": "GET",
              "connectionRef": "management",
              "url": "https://{{connections.management.host}}:{{connections.management.port}}/nitro/v1/config/sslcertkey/{{oldCertificateKey.name}}",
              "headers": { "Accept": "application/json", "X-NITRO-USER": "{{credentials.credential.username}}", "X-NITRO-PASS": "{{credentials.credential.secretRefs.password}}" },
              "tls": { "verify": "{{connections.management.tls.verifyPeer}}", "allowInsecure": true },
              "successStatusCodes": [200]
            },
            "assert": [{ "type": "jsonPath", "path": "$.errorcode", "equals": 0 }]
          }
        ]
      }
    },
    {
      "name": "buildDeploymentSnapshot",
      "type": "transform",
      "stage": "backup",
      "transform": {
        "engine": "jsonata",
        "input": {
          "version": "{{steps.preflight.extracted.deviceVersion}}",
          "versionResponse": "{{steps.preflight.output.body}}",
          "allBindings": "{{steps.readOldBindings.output.body.sslvserver_sslcertkey_binding}}",
          "bindings": "{{steps.selectLiveBindings.extracted.targetBindings}}",
          "certkeyIterations": "{{steps.readOldCertKeys.output.iterations}}",
          "targets": "{{steps.selectLiveBindings.extracted.deploymentTargets}}",
          "newCertificateKeyName": "{{steps.deriveCitrixNames.extracted.citrixCertificateKeyName}}",
          "targetFingerprintSha256": "{{artifacts.certificate.outputs.fingerprintSha256}}"
        },
        "outputs": {
          "deploymentSnapshot": {
            "expression": "{'deviceVersion': version, 'versionResponse': versionResponse, 'bindings': bindings, 'certkeys': $append([], $map(certkeyIterations, function($iteration) { {'resource': $iteration.outputs[0].output.body.sslcertkey, 'sharedBindings': $filter(allBindings, function($binding) { $binding.certkeyname in $iteration.outputs[0].output.body.sslcertkey.certkey })} })), 'targets': targets, 'newCertificateKeyName': newCertificateKeyName, 'targetFingerprintSha256': targetFingerprintSha256}"
          }
        },
        "timeoutMs": 1000
      }
    },
    {
      "name": "deploymentCheckpoint",
      "type": "checkpoint",
      "stage": "backup",
      "checkpoint": {
        "name": "citrix-adc-certificate-deployment",
        "capture": {
          "snapshot": "steps.buildDeploymentSnapshot.extracted.deploymentSnapshot"
        },
        "normalizedHash": true,
        "requiredForRollback": true
      }
    },
    {
      "name": "uploadLeafCertificate",
      "type": "http",
      "stage": "install",
      "request": {
        "method": "POST",
        "connectionRef": "management",
        "url": "https://{{connections.management.host}}:{{connections.management.port}}/nitro/v1/config/systemfile",
        "query": { "override": "yes" },
        "headers": { "Content-Type": "application/json", "X-NITRO-USER": "{{credentials.credential.username}}", "X-NITRO-PASS": "{{credentials.credential.secretRefs.password}}" },
      "bodyType": "json",
      "body": { "systemfile": { "filename": "{{steps.deriveCitrixNames.extracted.citrixCertificateKeyName}}.pem", "filelocation": "/nsconfig/ssl", "filecontent": "{{artifacts.certificate.outputs.leafPemBase64}}", "fileencoding": "BASE64" } },
      "tls": { "verify": "{{connections.management.tls.verifyPeer}}", "allowInsecure": true },
      "successStatusCodes": [200, 201, 209]
      },
      "when": { "variable": "steps.prepareCertificateResources.extracted.leafCertKeyExists", "equals": false }
    },
    {
      "name": "uploadPrivateKey",
      "type": "http",
      "stage": "install",
      "request": {
        "method": "POST",
        "connectionRef": "management",
        "url": "https://{{connections.management.host}}:{{connections.management.port}}/nitro/v1/config/systemfile",
        "query": { "override": "yes" },
        "headers": { "Content-Type": "application/json", "X-NITRO-USER": "{{credentials.credential.username}}", "X-NITRO-PASS": "{{credentials.credential.secretRefs.password}}" },
      "bodyType": "json",
      "body": { "systemfile": { "filename": "{{steps.deriveCitrixNames.extracted.citrixCertificateKeyName}}.key", "filelocation": "/nsconfig/ssl", "filecontent": "{{artifacts.certificate.outputs.privateKeyPemBase64}}", "fileencoding": "BASE64" } },
      "tls": { "verify": "{{connections.management.tls.verifyPeer}}", "allowInsecure": true },
      "successStatusCodes": [200, 201, 209]
      },
      "when": { "variable": "steps.prepareCertificateResources.extracted.leafCertKeyExists", "equals": false }
    },
    {
      "name": "installIntermediates",
      "type": "foreach",
      "stage": "install",
      "foreach": {
        "itemsPath": "artifacts.certificate.outputs.orderedIntermediates",
        "itemVariable": "intermediate",
        "maxItems": 16,
        "steps": [
          {
            "name": "uploadIntermediate",
            "type": "http",
            "request": {
              "method": "POST",
              "connectionRef": "management",
              "url": "https://{{connections.management.host}}:{{connections.management.port}}/nitro/v1/config/systemfile",
              "query": { "override": "yes" },
              "headers": { "Content-Type": "application/json", "X-NITRO-USER": "{{credentials.credential.username}}", "X-NITRO-PASS": "{{credentials.credential.secretRefs.password}}" },
              "bodyType": "json",
              "body": { "systemfile": { "filename": "{{steps.deriveCitrixNames.extracted.citrixCertificateKeyName}}-ca-{{intermediate.sequence}}.pem", "filelocation": "/nsconfig/ssl", "filecontent": "{{intermediate.pemBase64}}", "fileencoding": "BASE64" } },
              "tls": { "verify": "{{connections.management.tls.verifyPeer}}", "allowInsecure": true },
              "successStatusCodes": [200, 201, 209]
            }
          },
          {
            "name": "createIntermediateCertKey",
            "type": "http",
            "request": {
              "method": "POST",
              "connectionRef": "management",
              "url": "https://{{connections.management.host}}:{{connections.management.port}}/nitro/v1/config/sslcertkey",
              "headers": { "Content-Type": "application/json", "X-NITRO-USER": "{{credentials.credential.username}}", "X-NITRO-PASS": "{{credentials.credential.secretRefs.password}}" },
              "bodyType": "json",
              "body": { "sslcertkey": { "certkey": "{{steps.deriveCitrixNames.extracted.citrixCertificateKeyName}}-ca-{{intermediate.sequence}}", "cert": "/nsconfig/ssl/{{steps.deriveCitrixNames.extracted.citrixCertificateKeyName}}-ca-{{intermediate.sequence}}.pem" } },
              "tls": { "verify": "{{connections.management.tls.verifyPeer}}", "allowInsecure": true },
              "successStatusCodes": [200, 201, 209, 400, 409, 500, 599]
            },
            "extract": {
              "statusCode": { "type": "statusCode", "optional": true },
              "nitroErrorCode": { "type": "jsonPath", "path": "$.errorcode", "optional": true },
              "nitroMessage": { "type": "jsonPath", "path": "$.message", "optional": true }
            }
          }
        ]
      }
    },
    {
      "name": "resolveIntermediateCertKeyNames",
      "type": "transform",
      "stage": "install",
      "transform": {
        "engine": "jsonata",
        "input": {
          "intermediates": "{{artifacts.certificate.outputs.orderedIntermediates}}",
          "iterations": "{{steps.installIntermediates.output.iterations}}",
          "newCertificateKeyName": "{{steps.deriveCitrixNames.extracted.citrixCertificateKeyName}}"
        },
        "outputs": {
          "effectiveIntermediates": {
            "expression": "($requests := $append([], $map(intermediates, function($item) { $merge([$item, {'requestedCertkeyName': newCertificateKeyName & '-ca-' & $string($item.sequence)}]) })); $names := $append([], $map($requests, function($item, $index) { ($create := $filter(iterations[$index].outputs, function($output) { $output.name = 'createIntermediateCertKey' })[0]; $message := $string($create.output.body.message); $candidate := $replace($message, /^.*certkeyName Contents,\\s*([^\\]]+)\\].*$/, '$1'); $contains($message, 'Resource already exists [certkeyName Contents,') and $candidate != $message ? $candidate : $item.requestedCertkeyName) })); $append([], $map($requests, function($item, $index) { $merge([$item, {'certkeyName': $names[$index], 'nextCertkeyName': $names[$index + 1]}]) })))"
          }
        },
        "timeoutMs": 1000
      }
    },
    {
      "name": "linkIntermediates",
      "type": "foreach",
      "stage": "install",
      "foreach": {
        "itemsPath": "steps.resolveIntermediateCertKeyNames.extracted.effectiveIntermediates",
        "itemVariable": "intermediate",
        "maxItems": 16,
        "steps": [
          {
            "name": "linkIntermediateCertKey",
            "type": "http",
            "when": { "variable": "intermediate.hasNext", "equals": true },
            "request": {
              "method": "POST",
              "connectionRef": "management",
              "url": "https://{{connections.management.host}}:{{connections.management.port}}/nitro/v1/config/sslcertkey",
              "query": { "action": "link" },
              "headers": { "Content-Type": "application/json", "X-NITRO-USER": "{{credentials.credential.username}}", "X-NITRO-PASS": "{{credentials.credential.secretRefs.password}}" },
              "bodyType": "json",
              "body": { "sslcertkey": { "certkey": "{{intermediate.certkeyName}}", "linkcertkeyname": "{{intermediate.nextCertkeyName}}" } },
              "tls": { "verify": "{{connections.management.tls.verifyPeer}}", "allowInsecure": true },
              "successStatusCodes": [200, 201, 209, 400, 409, 500, 599]
            },
            "extract": {
              "statusCode": { "type": "statusCode", "optional": true },
              "nitroErrorCode": { "type": "jsonPath", "path": "$.errorcode", "optional": true },
              "nitroMessage": { "type": "jsonPath", "path": "$.message", "optional": true }
            }
          },
          {
            "name": "verifyIntermediateLink",
            "type": "http",
            "when": { "variable": "intermediate.hasNext", "equals": true },
            "request": {
              "method": "GET",
              "connectionRef": "management",
              "url": "https://{{connections.management.host}}:{{connections.management.port}}/nitro/v1/config/sslcertchain_sslcertkey_binding/{{intermediate.certkeyName}}",
              "headers": { "Accept": "application/json", "X-NITRO-USER": "{{credentials.credential.username}}", "X-NITRO-PASS": "{{credentials.credential.secretRefs.password}}" },
              "tls": { "verify": "{{connections.management.tls.verifyPeer}}", "allowInsecure": true },
              "successStatusCodes": [200]
            },
            "assert": [
              { "type": "jsonPath", "path": "$.errorcode", "equals": 0 },
              { "type": "contains", "value": "{{intermediate.nextCertkeyName}}" }
            ]
          }
        ]
      }
    },
    {
      "name": "createLeafCertKey",
      "type": "http",
      "stage": "install",
      "request": {
        "method": "POST",
        "connectionRef": "management",
        "url": "https://{{connections.management.host}}:{{connections.management.port}}/nitro/v1/config/sslcertkey",
        "headers": { "Content-Type": "application/json", "X-NITRO-USER": "{{credentials.credential.username}}", "X-NITRO-PASS": "{{credentials.credential.secretRefs.password}}" },
        "bodyType": "json",
        "body": { "sslcertkey": { "certkey": "{{steps.deriveCitrixNames.extracted.citrixCertificateKeyName}}", "cert": "/nsconfig/ssl/{{steps.deriveCitrixNames.extracted.citrixCertificateKeyName}}.pem", "key": "/nsconfig/ssl/{{steps.deriveCitrixNames.extracted.citrixCertificateKeyName}}.key" } },
        "tls": { "verify": "{{connections.management.tls.verifyPeer}}", "allowInsecure": true },
        "successStatusCodes": [200, 201, 209, 409]
      },
      "extract": {
        "statusCode": { "type": "statusCode", "optional": true },
        "nitroErrorCode": { "type": "jsonPath", "path": "$.errorcode", "optional": true },
        "nitroMessage": { "type": "jsonPath", "path": "$.message", "optional": true }
      }
    },
    {
      "name": "resolveLeafCertKeyName",
      "type": "transform",
      "stage": "install",
      "transform": {
        "engine": "jsonata",
        "input": {
          "requestedName": "{{steps.deriveCitrixNames.extracted.citrixCertificateKeyName}}",
          "existingCertkeys": "{{steps.readExistingCertKeys.output.body.sslcertkey}}",
          "createResponse": "{{steps.createLeafCertKey.output.body}}"
        },
        "outputs": {
          "effectiveLeafCertKeyName": {
            "expression": "($existing := $filter(existingCertkeys, function($certkey) { $certkey.certkey = requestedName }); $message := $string(createResponse.message); $candidate := $replace($message, /^.*certkeyName Contents,\\s*([^\\]]+)\\].*$/, '$1'); $contains($message, 'Resource already exists [certkeyName Contents,') and $candidate != $message ? $candidate : ($count($existing) > 0 ? $existing[0].certkey : requestedName))"
          }
        },
        "timeoutMs": 1000
      }
    },
    {
      "name": "readLeafCertKey",
      "type": "http",
      "stage": "install",
      "request": {
        "method": "GET",
        "connectionRef": "management",
        "url": "https://{{connections.management.host}}:{{connections.management.port}}/nitro/v1/config/sslcertkey/{{steps.resolveLeafCertKeyName.extracted.effectiveLeafCertKeyName}}",
        "headers": { "Accept": "application/json", "X-NITRO-USER": "{{credentials.credential.username}}", "X-NITRO-PASS": "{{credentials.credential.secretRefs.password}}" },
        "tls": { "verify": "{{connections.management.tls.verifyPeer}}", "allowInsecure": true },
        "successStatusCodes": [200]
      },
      "assert": [
        { "type": "jsonPath", "path": "$.errorcode", "equals": 0 },
        { "type": "contains", "value": "Valid" }
      ]
    },
    {
      "name": "inspectLeafChainState",
      "type": "transform",
      "stage": "install",
      "transform": {
        "engine": "jsonata",
        "input": {
          "leafCertkeyResource": "{{steps.readLeafCertKey.output.body.sslcertkey}}",
          "firstIntermediateCertkeyName": "{{steps.resolveIntermediateCertKeyNames.extracted.effectiveIntermediates.0.certkeyName}}"
        },
        "outputs": {
          "leafAlreadyLinkedToTargetIntermediate": {
            "expression": "($leaf := $type(leafCertkeyResource) = 'array' ? leafCertkeyResource[0] : leafCertkeyResource; $target := $string(firstIntermediateCertkeyName); $target != '' and $string($leaf.linkcertkeyname) = $target)"
          },
          "shouldLinkLeafCertKey": {
            "expression": "($leaf := $type(leafCertkeyResource) = 'array' ? leafCertkeyResource[0] : leafCertkeyResource; $target := $string(firstIntermediateCertkeyName); $target != '' and $string($leaf.linkcertkeyname) != $target)"
          }
        },
        "timeoutMs": 1000
      }
    },
    {
      "name": "linkLeafCertKey",
      "type": "http",
      "stage": "install",
      "when": { "variable": "steps.inspectLeafChainState.extracted.shouldLinkLeafCertKey", "equals": true },
      "request": {
        "method": "POST",
        "connectionRef": "management",
        "url": "https://{{connections.management.host}}:{{connections.management.port}}/nitro/v1/config/sslcertkey",
        "query": { "action": "link" },
        "headers": { "Content-Type": "application/json", "X-NITRO-USER": "{{credentials.credential.username}}", "X-NITRO-PASS": "{{credentials.credential.secretRefs.password}}" },
        "bodyType": "json",
        "body": { "sslcertkey": { "certkey": "{{steps.resolveLeafCertKeyName.extracted.effectiveLeafCertKeyName}}", "linkcertkeyname": "{{steps.resolveIntermediateCertKeyNames.extracted.effectiveIntermediates.0.certkeyName}}" } },
        "tls": { "verify": "{{connections.management.tls.verifyPeer}}", "allowInsecure": true },
        "successStatusCodes": [200, 201, 209, 409]
      },
      "extract": {
        "statusCode": { "type": "statusCode", "optional": true },
        "nitroErrorCode": { "type": "jsonPath", "path": "$.errorcode", "optional": true },
        "nitroMessage": { "type": "jsonPath", "path": "$.message", "optional": true }
      }
    },
    {
      "name": "verifyLeafChainLink",
      "type": "http",
      "stage": "install",
      "when": { "variable": "steps.resolveIntermediateCertKeyNames.extracted.effectiveIntermediates.0.certkeyName", "exists": true },
      "request": {
        "method": "GET",
        "connectionRef": "management",
        "url": "https://{{connections.management.host}}:{{connections.management.port}}/nitro/v1/config/sslcertchain_sslcertkey_binding/{{steps.resolveLeafCertKeyName.extracted.effectiveLeafCertKeyName}}",
        "headers": { "Accept": "application/json", "X-NITRO-USER": "{{credentials.credential.username}}", "X-NITRO-PASS": "{{credentials.credential.secretRefs.password}}" },
        "tls": { "verify": "{{connections.management.tls.verifyPeer}}", "allowInsecure": true },
        "successStatusCodes": [200]
      },
      "retry": { "count": 4, "intervalSeconds": 1, "retryOnStatus": [404, 409, 429, 500, 502, 503, 504, 599] },
      "assert": [
        { "type": "jsonPath", "path": "$.errorcode", "equals": 0 },
        { "type": "contains", "value": "{{steps.resolveIntermediateCertKeyNames.extracted.effectiveIntermediates.0.certkeyName}}" }
      ]
    },
    {
      "name": "bindTargets",
      "type": "foreach",
      "stage": "refresh",
      "foreach": {
        "itemsPath": "steps.selectLiveBindings.extracted.deploymentTargets",
        "itemVariable": "target",
        "maxItems": 1000,
        "steps": [
          {
            "name": "bindNewCertificate",
            "type": "http",
            "request": {
              "method": "POST",
              "connectionRef": "management",
              "url": "https://{{connections.management.host}}:{{connections.management.port}}/nitro/v1/config/sslvserver_sslcertkey_binding",
              "headers": { "Content-Type": "application/json", "X-NITRO-USER": "{{credentials.credential.username}}", "X-NITRO-PASS": "{{credentials.credential.secretRefs.password}}" },
              "bodyType": "json",
              "body": { "sslvserver_sslcertkey_binding": { "vservername": "{{target.name}}", "certkeyname": "{{steps.resolveLeafCertKeyName.extracted.effectiveLeafCertKeyName}}", "snicert": "{{target.metadata.sniCertificate}}" } },
              "tls": { "verify": "{{connections.management.tls.verifyPeer}}", "allowInsecure": true },
              "successStatusCodes": [200, 201, 209, 409, 599]
            }
          },
          {
            "name": "verifyNewBinding",
            "type": "http",
            "request": {
              "method": "GET",
              "connectionRef": "management",
              "url": "https://{{connections.management.host}}:{{connections.management.port}}/nitro/v1/config/sslvserver_sslcertkey_binding/{{target.name}}",
              "headers": { "Accept": "application/json", "X-NITRO-USER": "{{credentials.credential.username}}", "X-NITRO-PASS": "{{credentials.credential.secretRefs.password}}" },
              "tls": { "verify": "{{connections.management.tls.verifyPeer}}", "allowInsecure": true },
              "successStatusCodes": [200]
            },
            "assert": [
              { "type": "jsonPath", "path": "$.errorcode", "equals": 0 },
              { "type": "contains", "value": "{{steps.resolveLeafCertKeyName.extracted.effectiveLeafCertKeyName}}" }
            ]
          }
        ]
      }
    },
    {
      "name": "prepareOldBindingRemoval",
      "type": "http",
      "stage": "refresh",
      "request": {
        "method": "GET",
        "connectionRef": "management",
        "url": "https://{{connections.management.host}}:{{connections.management.port}}/nitro/v1/config/sslvserver_sslcertkey_binding",
        "query": { "bulkbindings": "yes" },
        "headers": { "Accept": "application/json", "X-NITRO-USER": "{{credentials.credential.username}}", "X-NITRO-PASS": "{{credentials.credential.secretRefs.password}}" },
        "tls": { "verify": "{{connections.management.tls.verifyPeer}}", "allowInsecure": true },
        "successStatusCodes": [200]
      },
      "assert": [{ "type": "jsonPath", "path": "$.errorcode", "equals": 0 }]
    },
    {
      "name": "selectOldBindingsToRemove",
      "type": "transform",
      "stage": "refresh",
      "transform": {
        "engine": "jsonata",
        "input": {
          "bindings": "{{steps.prepareOldBindingRemoval.output.body.sslvserver_sslcertkey_binding}}",
          "targets": "{{steps.selectLiveBindings.extracted.deploymentTargets}}",
          "newCertificateKeyName": "{{steps.resolveLeafCertKeyName.extracted.effectiveLeafCertKeyName}}"
        },
        "outputs": {
          "oldBindingsToRemove": {
            "expression": "($encode := function($value) { ($v := $string($value); $replace($replace($replace($replace($replace($replace($replace($replace($replace($replace($replace($v, /%/, '%25'), / /, '%20'), /\\*/, '%2A'), /,/, '%2C'), /#/, '%23'), /\\?/, '%3F'), /&/, '%26'), /=/, '%3D'), /\\+/, '%2B'), /\\//, '%2F'), /:/, '%3A')) }; $append([], $map($filter(bindings, function($binding) { $binding.vservername in targets.name and $binding.certkeyname != newCertificateKeyName }), function($binding) { $merge([$binding, {'encodedVserverName': $encode($binding.vservername), 'encodedCertkeyName': $encode($binding.certkeyname)}]) })))"
          }
        },
        "timeoutMs": 1000
      }
    },
    {
      "name": "removeOldBindings",
      "type": "foreach",
      "stage": "refresh",
      "foreach": {
        "itemsPath": "steps.selectOldBindingsToRemove.extracted.oldBindingsToRemove",
        "itemVariable": "oldBinding",
        "maxItems": 1000,
        "steps": [
          {
            "name": "removeOldBinding",
            "type": "http",
            "when": { "variable": "oldBinding.certkeyname", "notEquals": "{{steps.resolveLeafCertKeyName.extracted.effectiveLeafCertKeyName}}" },
            "request": {
              "method": "DELETE",
              "connectionRef": "management",
              "url": "https://{{connections.management.host}}:{{connections.management.port}}/nitro/v1/config/sslvserver_sslcertkey_binding/{{oldBinding.encodedVserverName}}?args=certkeyname:{{oldBinding.encodedCertkeyName}}",
              "headers": { "Accept": "application/json", "X-NITRO-USER": "{{credentials.credential.username}}", "X-NITRO-PASS": "{{credentials.credential.secretRefs.password}}" },
              "tls": { "verify": "{{connections.management.tls.verifyPeer}}", "allowInsecure": true },
              "successStatusCodes": [200, 201]
            }
          }
        ]
      }
    },
    {
      "name": "saveConfiguration",
      "type": "http",
      "stage": "refresh",
      "request": {
        "method": "POST",
        "connectionRef": "management",
        "url": "https://{{connections.management.host}}:{{connections.management.port}}/nitro/v1/config/nsconfig",
        "query": { "action": "save" },
        "headers": { "Content-Type": "application/json", "X-NITRO-USER": "{{credentials.credential.username}}", "X-NITRO-PASS": "{{credentials.credential.secretRefs.password}}" },
        "bodyType": "json",
        "body": { "nsconfig": {} },
        "tls": { "verify": "{{connections.management.tls.verifyPeer}}", "allowInsecure": true },
        "successStatusCodes": [200]
      }
    },
    {
      "name": "verifyCertificateControlPlane",
      "type": "http",
      "stage": "verify",
      "request": {
        "method": "GET",
        "connectionRef": "management",
        "url": "https://{{connections.management.host}}:{{connections.management.port}}/nitro/v1/config/sslcertkey/{{steps.resolveLeafCertKeyName.extracted.effectiveLeafCertKeyName}}",
        "headers": { "Accept": "application/json", "X-NITRO-USER": "{{credentials.credential.username}}", "X-NITRO-PASS": "{{credentials.credential.secretRefs.password}}" },
        "tls": { "verify": "{{connections.management.tls.verifyPeer}}", "allowInsecure": true },
        "successStatusCodes": [200]
      },
      "assert": [
        { "type": "jsonPath", "path": "$.errorcode", "equals": 0 },
        { "type": "contains", "value": "Valid" }
      ]
    }
  ],
  "rollback": [
    {
      "name": "verifyRecoverySnapshot",
      "type": "checkpoint_verify",
      "stage": "prepare",
      "when": { "variable": "variables.recoverySnapshot", "exists": true },
      "checkpointVerify": { "valuePath": "variables.recoverySnapshot", "expectedHash": "{{variables.recoverySnapshotHash}}" }
    },
    {
      "name": "readCurrentVersion",
      "type": "http",
      "stage": "prepare",
      "request": {
        "method": "GET",
        "connectionRef": "management",
        "url": "https://{{connections.management.host}}:{{connections.management.port}}/nitro/v1/config/nsversion",
        "headers": { "Accept": "application/json", "X-NITRO-USER": "{{credentials.credential.username}}", "X-NITRO-PASS": "{{credentials.credential.secretRefs.password}}" },
        "tls": { "verify": "{{connections.management.tls.verifyPeer}}", "allowInsecure": true },
        "successStatusCodes": [200]
      },
      "extract": { "currentDeviceVersion": { "type": "firstOf", "paths": ["$.body.nsversion.version", "$.body.nsversion[0].version"] } },
      "assert": [{ "type": "jsonPath", "path": "$.errorcode", "equals": 0 }]
    },
    {
      "name": "verifyDeviceVersion",
      "type": "condition",
      "stage": "prepare",
      "condition": { "variable": "steps.readCurrentVersion.extracted.currentDeviceVersion", "equals": "{{steps.buildDeploymentSnapshot.extracted.deploymentSnapshot.deviceVersion}}" },
      "description": "设备版本或 Build 漂移时停止自动回滚"
    },
    {
      "name": "readBindingsBeforeRestore",
      "type": "http",
      "stage": "refresh",
      "request": {
        "method": "GET",
        "connectionRef": "management",
        "url": "https://{{connections.management.host}}:{{connections.management.port}}/nitro/v1/config/sslvserver_sslcertkey_binding",
        "query": { "bulkbindings": "yes" },
        "headers": { "Accept": "application/json", "X-NITRO-USER": "{{credentials.credential.username}}", "X-NITRO-PASS": "{{credentials.credential.secretRefs.password}}" },
        "tls": { "verify": "{{connections.management.tls.verifyPeer}}", "allowInsecure": true },
        "successStatusCodes": [200]
      },
      "assert": [{ "type": "jsonPath", "path": "$.errorcode", "equals": 0 }]
    },
    {
      "name": "selectMissingOldBindings",
      "type": "transform",
      "stage": "refresh",
      "transform": {
        "engine": "jsonata",
        "input": {
          "expected": "{{steps.buildDeploymentSnapshot.extracted.deploymentSnapshot.bindings}}",
          "actual": "{{steps.readBindingsBeforeRestore.output.body.sslvserver_sslcertkey_binding}}"
        },
        "outputs": {
          "missingOldBindings": { "expression": "($bindable := function($b){$merge([{'vservername':$b.vservername,'certkeyname':$b.certkeyname,'snicert':$exists($b.snicert) ? $boolean($b.snicert) : false}, $exists($b.priority) ? {'priority':$b.priority} : {}])}; $append([], $map($filter(expected, function($item) { $count($filter(actual, function($candidate) { $candidate.vservername = $item.vservername and $candidate.certkeyname = $item.certkeyname and $candidate.snicert = $item.snicert and ($exists($item.priority) and $exists($candidate.priority) ? $candidate.priority = $item.priority : true) })) = 0 }), $bindable)))" }
        },
        "timeoutMs": 1000
      }
    },
    {
      "name": "restoreOldBindings",
      "type": "foreach",
      "stage": "refresh",
      "foreach": {
        "itemsPath": "steps.selectMissingOldBindings.extracted.missingOldBindings",
        "itemVariable": "oldBinding",
        "maxItems": 1000,
        "steps": [
          {
            "name": "restoreOldBinding",
            "type": "http",
            "request": {
              "method": "POST",
              "connectionRef": "management",
              "url": "https://{{connections.management.host}}:{{connections.management.port}}/nitro/v1/config/sslvserver_sslcertkey_binding",
              "headers": { "Content-Type": "application/json", "X-NITRO-USER": "{{credentials.credential.username}}", "X-NITRO-PASS": "{{credentials.credential.secretRefs.password}}" },
              "bodyType": "json",
              "body": { "sslvserver_sslcertkey_binding": "{{oldBinding}}" },
              "tls": { "verify": "{{connections.management.tls.verifyPeer}}", "allowInsecure": true },
              "successStatusCodes": [200, 201]
            }
          }
        ]
      }
    },
    {
      "name": "readBindingsAfterRestore",
      "type": "http",
      "stage": "refresh",
      "request": {
        "method": "GET",
        "connectionRef": "management",
        "url": "https://{{connections.management.host}}:{{connections.management.port}}/nitro/v1/config/sslvserver_sslcertkey_binding",
        "query": { "bulkbindings": "yes" },
        "headers": { "Accept": "application/json", "X-NITRO-USER": "{{credentials.credential.username}}", "X-NITRO-PASS": "{{credentials.credential.secretRefs.password}}" },
        "tls": { "verify": "{{connections.management.tls.verifyPeer}}", "allowInsecure": true },
        "successStatusCodes": [200]
      },
      "assert": [{ "type": "jsonPath", "path": "$.errorcode", "equals": 0 }]
    },
    {
      "name": "compareRestoredBindings",
      "type": "transform",
      "stage": "refresh",
      "transform": {
        "engine": "jsonata",
        "input": {
          "expected": "{{steps.buildDeploymentSnapshot.extracted.deploymentSnapshot.bindings}}",
          "actual": "{{steps.readBindingsAfterRestore.output.body.sslvserver_sslcertkey_binding}}"
        },
        "outputs": {
          "oldBindingsRestored": { "expression": "$count($filter(expected, function($item) { $count($filter(actual, function($candidate) { $candidate.vservername = $item.vservername and $candidate.certkeyname = $item.certkeyname and $candidate.snicert = $item.snicert and ($exists($item.priority) and $exists($candidate.priority) ? $candidate.priority = $item.priority : true) })) = 1 })) = $count(expected)" }
        },
        "timeoutMs": 1000
      }
    },
    {
      "name": "requireOldBindingsRestored",
      "type": "condition",
      "stage": "refresh",
      "condition": { "variable": "steps.compareRestoredBindings.extracted.oldBindingsRestored", "equals": true },
      "description": "旧绑定未完整恢复时停止自动回滚"
    },
    {
      "name": "selectNewBindingsAfterRestore",
      "type": "transform",
      "stage": "refresh",
      "transform": {
        "engine": "jsonata",
        "input": {
          "actual": "{{steps.readBindingsAfterRestore.output.body.sslvserver_sslcertkey_binding}}",
          "expected": "{{steps.buildDeploymentSnapshot.extracted.deploymentSnapshot.bindings}}",
          "targets": "{{steps.buildDeploymentSnapshot.extracted.deploymentSnapshot.targets}}"
        },
        "outputs": {
          "newBindings": {
            "expression": "$append([], $map($filter(actual, function($binding) { $binding.vservername in targets.name and $count($filter(expected, function($item) { $item.vservername = $binding.vservername and $item.certkeyname = $binding.certkeyname and $item.snicert = $binding.snicert and ($exists($item.priority) and $exists($binding.priority) ? $item.priority = $binding.priority : true) })) = 0 }), function($binding) { {'vservername':$binding.vservername,'certkeyname':$binding.certkeyname} }))"
          }
        },
        "timeoutMs": 1000
      }
    },
    {
      "name": "removeNewBindings",
      "type": "foreach",
      "stage": "refresh",
      "foreach": {
        "itemsPath": "steps.selectNewBindingsAfterRestore.extracted.newBindings",
        "itemVariable": "newBinding",
        "maxItems": 1000,
        "steps": [
          {
            "name": "removeNewBinding",
            "type": "http",
            "request": {
              "method": "DELETE",
              "connectionRef": "management",
              "url": "https://{{connections.management.host}}:{{connections.management.port}}/nitro/v1/config/sslvserver_sslcertkey_binding/{{newBinding.vservername}}?args=certkeyname:{{newBinding.certkeyname}}",
              "headers": { "Accept": "application/json", "X-NITRO-USER": "{{credentials.credential.username}}", "X-NITRO-PASS": "{{credentials.credential.secretRefs.password}}" },
              "tls": { "verify": "{{connections.management.tls.verifyPeer}}", "allowInsecure": true },
              "successStatusCodes": [200, 201]
            }
          }
        ]
      }
    },
    {
      "name": "readFinalBindings",
      "type": "http",
      "stage": "verify",
      "request": {
        "method": "GET",
        "connectionRef": "management",
        "url": "https://{{connections.management.host}}:{{connections.management.port}}/nitro/v1/config/sslvserver_sslcertkey_binding",
        "query": { "bulkbindings": "yes" },
        "headers": { "Accept": "application/json", "X-NITRO-USER": "{{credentials.credential.username}}", "X-NITRO-PASS": "{{credentials.credential.secretRefs.password}}" },
        "tls": { "verify": "{{connections.management.tls.verifyPeer}}", "allowInsecure": true },
        "successStatusCodes": [200]
      },
      "assert": [{ "type": "jsonPath", "path": "$.errorcode", "equals": 0 }]
    },
    {
      "name": "compareFinalBindings",
      "type": "transform",
      "stage": "verify",
      "transform": {
        "engine": "jsonata",
        "input": {
          "expected": "{{steps.buildDeploymentSnapshot.extracted.deploymentSnapshot.bindings}}",
          "actual": "{{steps.readFinalBindings.output.body.sslvserver_sslcertkey_binding}}",
          "targets": "{{steps.buildDeploymentSnapshot.extracted.deploymentSnapshot.targets}}"
        },
        "outputs": {
          "finalBindingsEquivalent": { "expression": "$count($filter(actual, function($item) { $item.vservername in targets.name })) = $count(expected) and $count($filter(expected, function($item) { $count($filter(actual, function($candidate) { $candidate.vservername = $item.vservername and $candidate.certkeyname = $item.certkeyname and $candidate.snicert = $item.snicert and ($exists($item.priority) and $exists($candidate.priority) ? $candidate.priority = $item.priority : true) })) = 1 })) = $count(expected)" }
        },
        "timeoutMs": 1000
      }
    },
    {
      "name": "requireFinalBindingsEquivalent",
      "type": "condition",
      "stage": "verify",
      "condition": { "variable": "steps.compareFinalBindings.extracted.finalBindingsEquivalent", "equals": true },
      "description": "最终绑定集合与回滚快照不等价时停止并进入人工介入"
    },
    {
      "name": "decideRollbackPersistence",
      "type": "transform",
      "stage": "verify",
      "transform": {
        "engine": "jsonata",
        "input": {
          "missingOldBindings": "{{steps.selectMissingOldBindings.extracted.missingOldBindings}}",
          "newBindings": "{{steps.selectNewBindingsAfterRestore.extracted.newBindings}}"
        },
        "outputs": {
          "bindingMutationCount": { "expression": "$count(missingOldBindings) + $count(newBindings)" }
        },
        "timeoutMs": 1000
      }
    },
    {
      "name": "saveConfiguration",
      "type": "http",
      "stage": "verify",
      "when": { "variable": "steps.decideRollbackPersistence.extracted.bindingMutationCount", "notEquals": 0 },
      "request": {
        "method": "POST",
        "connectionRef": "management",
        "url": "https://{{connections.management.host}}:{{connections.management.port}}/nitro/v1/config/nsconfig",
        "query": { "action": "save" },
        "headers": { "Content-Type": "application/json", "X-NITRO-USER": "{{credentials.credential.username}}", "X-NITRO-PASS": "{{credentials.credential.secretRefs.password}}" },
        "bodyType": "json",
        "body": { "nsconfig": {} },
        "tls": { "verify": "{{connections.management.tls.verifyPeer}}", "allowInsecure": true },
        "successStatusCodes": [200]
      }
    }
  ]
}
