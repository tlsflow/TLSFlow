{
  "apiVersion": "gcac.workflow/v1",
  "kind": "CurlSshWorkflow",
  "metadata": {
    "name": "citrix-adc-certificate-deploy",
    "displayName": "Citrix ADC certificate deployment",
    "category": "certificate",
    "version": "1.1.1",
    "platforms": ["appliance"],
    "updateMethods": ["curl"],
    "maintainer": "GCAC"
  },
  "variables": {
    "deviceHost": { "type": "string", "required": true },
    "managementPort": { "type": "number", "required": true, "default": 443 },
    "credential": { "type": "credential", "required": true, "sensitive": true },
    "tlsVerify": { "type": "boolean", "required": true, "default": true },
    "certificate": {
      "type": "certificate",
      "required": true,
      "sensitive": true,
      "artifactContract": {
        "outputs": {
          "leafPem": { "role": "public_certificate", "required": true, "format": "PEM", "encoding": "UTF-8" },
          "privateKeyPem": { "role": "private_key", "required": true, "format": "PEM", "encoding": "UTF-8" },
          "orderedChainPem": { "role": "certificate_chain", "required": false, "format": "PEM", "encoding": "UTF-8" },
          "fingerprintSha256": { "role": "fingerprint_sha256", "required": true, "format": "HEX", "encoding": "UTF-8" }
        }
      }
    },
    "targetVirtualServers": { "type": "array", "required": true },
    "certificateKeyName": { "type": "string", "required": true }
  },
  "steps": [
    {
      "name": "preflight",
      "type": "http",
      "stage": "prepare",
      "request": {
        "method": "GET",
        "url": "https://{{deviceHost}}:{{managementPort}}/nitro/v1/config/nsversion",
        "headers": { "Accept": "application/json", "X-NITRO-USER": "{{credential.username}}", "X-NITRO-PASS": "{{credential.secretRefs.password}}" },
        "tls": { "verify": "{{tlsVerify}}", "allowInsecure": true },
        "successStatusCodes": [200]
      },
      "extract": {
        "deviceVersion": { "type": "firstOf", "paths": ["$.body.nsversion.version", "$.body.nsversion[0].version"], "optional": false }
      },
      "assert": [{ "type": "jsonPath", "path": "$.errorcode", "equals": 0 }]
    },
    {
      "name": "readOldBindings",
      "type": "http",
      "stage": "backup",
      "request": {
        "method": "GET",
        "url": "https://{{deviceHost}}:{{managementPort}}/nitro/v1/config/sslvserver_sslcertkey_binding",
        "query": { "bulkbindings": "yes" },
        "headers": { "Accept": "application/json", "X-NITRO-USER": "{{credential.username}}", "X-NITRO-PASS": "{{credential.secretRefs.password}}" },
        "tls": { "verify": "{{tlsVerify}}", "allowInsecure": true },
        "successStatusCodes": [200]
      },
      "assert": [{ "type": "jsonPath", "path": "$.errorcode", "equals": 0 }]
    },
    {
      "name": "selectLiveBindings",
      "type": "transform",
      "stage": "backup",
      "transform": {
        "engine": "jsonata",
        "input": {
          "bindings": "{{steps.readOldBindings.output.body.sslvserver_sslcertkey_binding}}",
          "targets": "{{targetVirtualServers}}",
          "newCertificateKeyName": "{{certificateKeyName}}"
        },
        "outputs": {
          "targetBindings": { "expression": "$append([], $filter(bindings, function($binding) { $binding.vservername in targets.name }))" },
          "oldCertificateKeys": { "expression": "$append([], $map($distinct($filter(bindings, function($binding) { $binding.vservername in targets.name and $binding.certkeyname != newCertificateKeyName }).certkeyname), function($name) { {'name': $name} }))" }
        }
      }
    },
    {
      "name": "readOldCertKeys",
      "type": "foreach",
      "stage": "backup",
      "foreach": {
        "itemsPath": "oldCertificateKeys",
        "itemVariable": "oldCertificateKey",
        "maxItems": 256,
        "steps": [
          {
            "name": "readOldCertKey",
            "type": "http",
            "request": {
              "method": "GET",
              "url": "https://{{deviceHost}}:{{managementPort}}/nitro/v1/config/sslcertkey/{{oldCertificateKey.name}}",
              "headers": { "Accept": "application/json", "X-NITRO-USER": "{{credential.username}}", "X-NITRO-PASS": "{{credential.secretRefs.password}}" },
              "tls": { "verify": "{{tlsVerify}}", "allowInsecure": true },
              "successStatusCodes": [200]
            },
            "assert": [{ "type": "jsonPath", "path": "$.errorcode", "equals": 0 }]
          }
        ]
      }
    },
    {
      "name": "buildDeploymentSnapshot",
      "type": "transform",
      "stage": "backup",
      "transform": {
        "engine": "jsonata",
        "input": {
          "version": "{{deviceVersion}}",
          "versionResponse": "{{steps.preflight.output.body}}",
          "allBindings": "{{steps.readOldBindings.output.body.sslvserver_sslcertkey_binding}}",
          "bindings": "{{targetBindings}}",
          "certkeyIterations": "{{steps.readOldCertKeys.output.iterations}}",
          "targets": "{{targetVirtualServers}}",
          "newCertificateKeyName": "{{certificateKeyName}}",
          "targetFingerprintSha256": "{{certificate.fingerprintSha256}}"
        },
        "outputs": {
          "deploymentSnapshot": {
            "expression": "{'deviceVersion': version, 'versionResponse': versionResponse, 'bindings': bindings, 'certkeys': $append([], $map(certkeyIterations, function($iteration) { {'resource': $iteration.outputs[0].output.body.sslcertkey, 'sharedBindings': $filter(allBindings, function($binding) { $binding.certkeyname in $iteration.outputs[0].output.body.sslcertkey.certkey })} })), 'targets': targets, 'newCertificateKeyName': newCertificateKeyName, 'targetFingerprintSha256': targetFingerprintSha256}"
          }
        }
      }
    },
    {
      "name": "deploymentCheckpoint",
      "type": "checkpoint",
      "stage": "backup",
      "checkpoint": {
        "name": "citrix-adc-certificate-deployment",
        "capture": {
          "snapshot": "deploymentSnapshot"
        },
        "normalizedHash": true,
        "requiredForRollback": true
      }
    },
    {
      "name": "uploadLeafCertificate",
      "type": "http",
      "stage": "install",
      "request": {
        "method": "POST",
        "url": "https://{{deviceHost}}:{{managementPort}}/nitro/v1/config/systemfile",
        "headers": { "Content-Type": "application/json", "X-NITRO-USER": "{{credential.username}}", "X-NITRO-PASS": "{{credential.secretRefs.password}}" },
        "bodyType": "json",
        "body": { "systemfile": { "filename": "{{certificateKeyName}}.pem", "filelocation": "/nsconfig/ssl", "filecontent": "{{certificate.leafPemBase64}}", "fileencoding": "BASE64" } },
        "tls": { "verify": "{{tlsVerify}}", "allowInsecure": true },
        "successStatusCodes": [200, 201]
      }
    },
    {
      "name": "uploadPrivateKey",
      "type": "http",
      "stage": "install",
      "request": {
        "method": "POST",
        "url": "https://{{deviceHost}}:{{managementPort}}/nitro/v1/config/systemfile",
        "headers": { "Content-Type": "application/json", "X-NITRO-USER": "{{credential.username}}", "X-NITRO-PASS": "{{credential.secretRefs.password}}" },
        "bodyType": "json",
        "body": { "systemfile": { "filename": "{{certificateKeyName}}.key", "filelocation": "/nsconfig/ssl", "filecontent": "{{certificate.privateKeyPemBase64}}", "fileencoding": "BASE64" } },
        "tls": { "verify": "{{tlsVerify}}", "allowInsecure": true },
        "successStatusCodes": [200, 201]
      }
    },
    {
      "name": "installIntermediates",
      "type": "foreach",
      "stage": "install",
      "foreach": {
        "itemsPath": "certificate.orderedIntermediates",
        "itemVariable": "intermediate",
        "maxItems": 16,
        "steps": [
          {
            "name": "uploadIntermediate",
            "type": "http",
            "request": {
              "method": "POST",
              "url": "https://{{deviceHost}}:{{managementPort}}/nitro/v1/config/systemfile",
              "headers": { "Content-Type": "application/json", "X-NITRO-USER": "{{credential.username}}", "X-NITRO-PASS": "{{credential.secretRefs.password}}" },
              "bodyType": "json",
              "body": { "systemfile": { "filename": "{{certificateKeyName}}-ca-{{intermediate.sequence}}.pem", "filelocation": "/nsconfig/ssl", "filecontent": "{{intermediate.pemBase64}}", "fileencoding": "BASE64" } },
              "tls": { "verify": "{{tlsVerify}}", "allowInsecure": true },
              "successStatusCodes": [200, 201]
            }
          },
          {
            "name": "createIntermediateCertKey",
            "type": "http",
            "request": {
              "method": "POST",
              "url": "https://{{deviceHost}}:{{managementPort}}/nitro/v1/config/sslcertkey",
              "headers": { "Content-Type": "application/json", "X-NITRO-USER": "{{credential.username}}", "X-NITRO-PASS": "{{credential.secretRefs.password}}" },
              "bodyType": "json",
              "body": { "sslcertkey": { "certkey": "{{certificateKeyName}}-ca-{{intermediate.sequence}}", "cert": "/nsconfig/ssl/{{certificateKeyName}}-ca-{{intermediate.sequence}}.pem" } },
              "tls": { "verify": "{{tlsVerify}}", "allowInsecure": true },
              "successStatusCodes": [200, 201]
            }
          },
          {
            "name": "linkIntermediateCertKey",
            "type": "http",
            "when": { "variable": "intermediate.hasNext", "equals": true },
            "request": {
              "method": "POST",
              "url": "https://{{deviceHost}}:{{managementPort}}/nitro/v1/config/sslcertkey",
              "query": { "action": "link" },
              "headers": { "Content-Type": "application/json", "X-NITRO-USER": "{{credential.username}}", "X-NITRO-PASS": "{{credential.secretRefs.password}}" },
              "bodyType": "json",
              "body": { "sslcertkey": { "certkey": "{{certificateKeyName}}-ca-{{intermediate.sequence}}", "linkcertkeyname": "{{certificateKeyName}}-ca-{{intermediate.nextSequence}}" } },
              "tls": { "verify": "{{tlsVerify}}", "allowInsecure": true },
              "successStatusCodes": [200, 201]
            }
          }
        ]
      }
    },
    {
      "name": "createLeafCertKey",
      "type": "http",
      "stage": "install",
      "request": {
        "method": "POST",
        "url": "https://{{deviceHost}}:{{managementPort}}/nitro/v1/config/sslcertkey",
        "headers": { "Content-Type": "application/json", "X-NITRO-USER": "{{credential.username}}", "X-NITRO-PASS": "{{credential.secretRefs.password}}" },
        "bodyType": "json",
        "body": { "sslcertkey": { "certkey": "{{certificateKeyName}}", "cert": "/nsconfig/ssl/{{certificateKeyName}}.pem", "key": "/nsconfig/ssl/{{certificateKeyName}}.key" } },
        "tls": { "verify": "{{tlsVerify}}", "allowInsecure": true },
        "successStatusCodes": [200, 201]
      }
    },
    {
      "name": "linkLeafCertKey",
      "type": "http",
      "stage": "install",
      "when": { "variable": "certificate.orderedIntermediates.0.sequence", "exists": true },
      "request": {
        "method": "POST",
        "url": "https://{{deviceHost}}:{{managementPort}}/nitro/v1/config/sslcertkey",
        "query": { "action": "link" },
        "headers": { "Content-Type": "application/json", "X-NITRO-USER": "{{credential.username}}", "X-NITRO-PASS": "{{credential.secretRefs.password}}" },
        "bodyType": "json",
        "body": { "sslcertkey": { "certkey": "{{certificateKeyName}}", "linkcertkeyname": "{{certificateKeyName}}-ca-1" } },
        "tls": { "verify": "{{tlsVerify}}", "allowInsecure": true },
        "successStatusCodes": [200, 201]
      }
    },
    {
      "name": "bindTargets",
      "type": "foreach",
      "stage": "refresh",
      "foreach": {
        "itemsPath": "targetVirtualServers",
        "itemVariable": "target",
        "maxItems": 1000,
        "steps": [
          {
            "name": "bindNewCertificate",
            "type": "http",
            "request": {
              "method": "POST",
              "url": "https://{{deviceHost}}:{{managementPort}}/nitro/v1/config/sslvserver_sslcertkey_binding",
              "headers": { "Content-Type": "application/json", "X-NITRO-USER": "{{credential.username}}", "X-NITRO-PASS": "{{credential.secretRefs.password}}" },
              "bodyType": "json",
              "body": { "sslvserver_sslcertkey_binding": { "vservername": "{{target.name}}", "certkeyname": "{{certificateKeyName}}", "snicert": "{{target.sniCertificate}}" } },
              "tls": { "verify": "{{tlsVerify}}", "allowInsecure": true },
              "successStatusCodes": [200, 201]
            }
          },
          {
            "name": "verifyNewBinding",
            "type": "http",
            "request": {
              "method": "GET",
              "url": "https://{{deviceHost}}:{{managementPort}}/nitro/v1/config/sslvserver_sslcertkey_binding/{{target.name}}",
              "headers": { "Accept": "application/json", "X-NITRO-USER": "{{credential.username}}", "X-NITRO-PASS": "{{credential.secretRefs.password}}" },
              "tls": { "verify": "{{tlsVerify}}", "allowInsecure": true },
              "successStatusCodes": [200]
            },
            "assert": [
              { "type": "jsonPath", "path": "$.errorcode", "equals": 0 },
              { "type": "contains", "value": "{{certificateKeyName}}" }
            ]
          }
        ]
      }
    },
    {
      "name": "removeOldBindings",
      "type": "foreach",
      "stage": "refresh",
      "foreach": {
        "itemsPath": "targetBindings",
        "itemVariable": "oldBinding",
        "maxItems": 1000,
        "steps": [
          {
            "name": "removeOldBinding",
            "type": "http",
            "when": { "variable": "oldBinding.certkeyname", "notEquals": "{{certificateKeyName}}" },
            "request": {
              "method": "DELETE",
              "url": "https://{{deviceHost}}:{{managementPort}}/nitro/v1/config/sslvserver_sslcertkey_binding/{{oldBinding.vservername}}?args=certkeyname:{{oldBinding.certkeyname}}",
              "headers": { "Accept": "application/json", "X-NITRO-USER": "{{credential.username}}", "X-NITRO-PASS": "{{credential.secretRefs.password}}" },
              "tls": { "verify": "{{tlsVerify}}", "allowInsecure": true },
              "successStatusCodes": [200, 201]
            }
          }
        ]
      }
    },
    {
      "name": "saveConfiguration",
      "type": "http",
      "stage": "refresh",
      "request": {
        "method": "POST",
        "url": "https://{{deviceHost}}:{{managementPort}}/nitro/v1/config/nsconfig",
        "query": { "action": "save" },
        "headers": { "Content-Type": "application/json", "X-NITRO-USER": "{{credential.username}}", "X-NITRO-PASS": "{{credential.secretRefs.password}}" },
        "bodyType": "json",
        "body": { "nsconfig": {} },
        "tls": { "verify": "{{tlsVerify}}", "allowInsecure": true },
        "successStatusCodes": [200]
      },
      "assert": [{ "type": "jsonPath", "path": "$.errorcode", "equals": 0 }]
    },
    {
      "name": "verifyCertificateControlPlane",
      "type": "http",
      "stage": "verify",
      "request": {
        "method": "GET",
        "url": "https://{{deviceHost}}:{{managementPort}}/nitro/v1/config/sslcertkey/{{certificateKeyName}}",
        "headers": { "Accept": "application/json", "X-NITRO-USER": "{{credential.username}}", "X-NITRO-PASS": "{{credential.secretRefs.password}}" },
        "tls": { "verify": "{{tlsVerify}}", "allowInsecure": true },
        "successStatusCodes": [200]
      },
      "assert": [
        { "type": "jsonPath", "path": "$.errorcode", "equals": 0 },
        { "type": "contains", "value": "Valid" }
      ]
    },
    {
      "name": "verifyTlsHandshakes",
      "type": "foreach",
      "stage": "verify",
      "foreach": {
        "itemsPath": "targetVirtualServers",
        "itemVariable": "target",
        "maxItems": 1000,
        "steps": [
          {
            "name": "verifyTlsHandshake",
            "type": "tls_probe",
            "tlsProbe": {
              "host": "{{target.verifyHost}}",
              "port": 443,
              "serverName": "{{target.serverName}}",
              "expectedFingerprintSha256": "{{certificate.fingerprintSha256}}",
              "timeoutSeconds": 15
            }
          }
        ]
      }
    }
  ],
  "rollback": [
    {
      "name": "rollbackReadCurrentVersion",
      "type": "http",
      "stage": "prepare",
      "request": {
        "method": "GET",
        "url": "https://{{deviceHost}}:{{managementPort}}/nitro/v1/config/nsversion",
        "headers": { "Accept": "application/json", "X-NITRO-USER": "{{credential.username}}", "X-NITRO-PASS": "{{credential.secretRefs.password}}" },
        "tls": { "verify": "{{tlsVerify}}", "allowInsecure": true },
        "successStatusCodes": [200]
      },
      "extract": { "rollbackDeviceVersion": { "type": "firstOf", "paths": ["$.body.nsversion.version", "$.body.nsversion[0].version"] } },
      "assert": [{ "type": "jsonPath", "path": "$.errorcode", "equals": 0 }]
    },
    {
      "name": "rollbackVerifyDeviceVersion",
      "type": "condition",
      "stage": "prepare",
      "condition": { "variable": "rollbackDeviceVersion", "equals": "{{deploymentSnapshot.deviceVersion}}" },
      "description": "设备版本或 Build 漂移时停止自动回滚"
    },
    {
      "name": "rollbackRestoreOldBindings",
      "type": "foreach",
      "stage": "refresh",
      "foreach": {
        "itemsPath": "deploymentSnapshot.bindings",
        "itemVariable": "rollbackOldBinding",
        "maxItems": 1000,
        "steps": [
          {
            "name": "rollbackRestoreOldBinding",
            "type": "http",
            "request": {
              "method": "POST",
              "url": "https://{{deviceHost}}:{{managementPort}}/nitro/v1/config/sslvserver_sslcertkey_binding",
              "headers": { "Content-Type": "application/json", "X-NITRO-USER": "{{credential.username}}", "X-NITRO-PASS": "{{credential.secretRefs.password}}" },
              "bodyType": "json",
              "body": { "sslvserver_sslcertkey_binding": "{{rollbackOldBinding}}" },
              "tls": { "verify": "{{tlsVerify}}", "allowInsecure": true },
              "successStatusCodes": [200, 201]
            }
          }
        ]
      }
    },
    {
      "name": "rollbackReadBindingsAfterRestore",
      "type": "http",
      "stage": "refresh",
      "request": {
        "method": "GET",
        "url": "https://{{deviceHost}}:{{managementPort}}/nitro/v1/config/sslvserver_sslcertkey_binding",
        "query": { "bulkbindings": "yes" },
        "headers": { "Accept": "application/json", "X-NITRO-USER": "{{credential.username}}", "X-NITRO-PASS": "{{credential.secretRefs.password}}" },
        "tls": { "verify": "{{tlsVerify}}", "allowInsecure": true },
        "successStatusCodes": [200]
      },
      "assert": [{ "type": "jsonPath", "path": "$.errorcode", "equals": 0 }]
    },
    {
      "name": "rollbackCompareRestoredBindings",
      "type": "transform",
      "stage": "refresh",
      "transform": {
        "engine": "jsonata",
        "input": { "expected": "{{deploymentSnapshot.bindings}}", "actual": "{{steps.rollbackReadBindingsAfterRestore.output.body.sslvserver_sslcertkey_binding}}" },
        "outputs": {
          "rollbackOldBindingsRestored": { "expression": "$count($filter(expected, function($item) { $count($filter(actual, function($candidate) { $candidate.vservername = $item.vservername and $candidate.certkeyname = $item.certkeyname and $candidate.snicert = $item.snicert and $candidate.priority = $item.priority })) = 1 })) = $count(expected)" }
        }
      }
    },
    {
      "name": "rollbackRequireOldBindingsRestored",
      "type": "condition",
      "stage": "refresh",
      "condition": { "variable": "rollbackOldBindingsRestored", "equals": true }
    },
    {
      "name": "rollbackRemoveNewBindings",
      "type": "foreach",
      "stage": "refresh",
      "foreach": {
        "itemsPath": "deploymentSnapshot.targets",
        "itemVariable": "rollbackTarget",
        "maxItems": 1000,
        "steps": [
          {
            "name": "rollbackRemoveNewBinding",
            "type": "http",
            "request": {
              "method": "DELETE",
              "url": "https://{{deviceHost}}:{{managementPort}}/nitro/v1/config/sslvserver_sslcertkey_binding/{{rollbackTarget.name}}?args=certkeyname:{{deploymentSnapshot.newCertificateKeyName}}",
              "headers": { "Accept": "application/json", "X-NITRO-USER": "{{credential.username}}", "X-NITRO-PASS": "{{credential.secretRefs.password}}" },
              "tls": { "verify": "{{tlsVerify}}", "allowInsecure": true },
              "successStatusCodes": [200, 201]
            }
          }
        ]
      }
    },
    {
      "name": "rollbackReadFinalBindings",
      "type": "http",
      "stage": "verify",
      "request": {
        "method": "GET",
        "url": "https://{{deviceHost}}:{{managementPort}}/nitro/v1/config/sslvserver_sslcertkey_binding",
        "query": { "bulkbindings": "yes" },
        "headers": { "Accept": "application/json", "X-NITRO-USER": "{{credential.username}}", "X-NITRO-PASS": "{{credential.secretRefs.password}}" },
        "tls": { "verify": "{{tlsVerify}}", "allowInsecure": true },
        "successStatusCodes": [200]
      },
      "assert": [{ "type": "jsonPath", "path": "$.errorcode", "equals": 0 }]
    },
    {
      "name": "rollbackCompareFinalBindings",
      "type": "transform",
      "stage": "verify",
      "transform": {
        "engine": "jsonata",
        "input": { "expected": "{{deploymentSnapshot.bindings}}", "actual": "{{steps.rollbackReadFinalBindings.output.body.sslvserver_sslcertkey_binding}}", "targets": "{{deploymentSnapshot.targets}}" },
        "outputs": {
          "rollbackFinalBindingsEquivalent": { "expression": "$count($filter(actual, function($item) { $item.vservername in targets.name })) = $count(expected) and $count($filter(expected, function($item) { $count($filter(actual, function($candidate) { $candidate.vservername = $item.vservername and $candidate.certkeyname = $item.certkeyname and $candidate.snicert = $item.snicert and $candidate.priority = $item.priority })) = 1 })) = $count(expected)" }
        }
      }
    },
    {
      "name": "rollbackRequireFinalBindingsEquivalent",
      "type": "condition",
      "stage": "verify",
      "condition": { "variable": "rollbackFinalBindingsEquivalent", "equals": true }
    },
    {
      "name": "rollbackSaveConfiguration",
      "type": "http",
      "stage": "verify",
      "request": {
        "method": "POST",
        "url": "https://{{deviceHost}}:{{managementPort}}/nitro/v1/config/nsconfig",
        "query": { "action": "save" },
        "headers": { "Content-Type": "application/json", "X-NITRO-USER": "{{credential.username}}", "X-NITRO-PASS": "{{credential.secretRefs.password}}" },
        "bodyType": "json",
        "body": { "nsconfig": {} },
        "tls": { "verify": "{{tlsVerify}}", "allowInsecure": true },
        "successStatusCodes": [200]
      },
      "assert": [{ "type": "jsonPath", "path": "$.errorcode", "equals": 0 }]
    },
    {
      "name": "rollbackVerifyPreviousTlsHandshakes",
      "type": "foreach",
      "stage": "verify",
      "foreach": {
        "itemsPath": "deploymentSnapshot.targets",
        "itemVariable": "rollbackTarget",
        "maxItems": 1000,
        "steps": [
          {
            "name": "rollbackVerifyPreviousTlsHandshake",
            "type": "tls_probe",
            "tlsProbe": {
              "host": "{{rollbackTarget.verifyHost}}",
              "port": 443,
              "serverName": "{{rollbackTarget.serverName}}",
              "expectedFingerprintSha256": "{{rollbackTarget.previousFingerprintSha256}}",
              "timeoutSeconds": 15
            }
          }
        ]
      }
    }
  ]
}
