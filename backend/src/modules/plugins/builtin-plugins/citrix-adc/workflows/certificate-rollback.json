{
  "apiVersion": "gcac.workflow/v1",
  "kind": "CurlSshWorkflow",
  "metadata": { "name": "citrix-adc-certificate-rollback", "displayName": "Citrix ADC certificate rollback", "category": "certificate", "version": "1.0.0", "platforms": ["appliance"], "updateMethods": ["curl"], "maintainer": "GCAC" },
  "variables": {
    "deviceHost": { "type": "string", "required": true },
    "managementPort": { "type": "number", "required": true, "default": 443 },
    "credential": { "type": "credential", "required": true, "sensitive": true },
    "tlsVerify": { "type": "boolean", "required": true, "default": true },
    "backupBindings": { "type": "object", "required": true }
  },
  "steps": [
    { "name": "restoreBindings", "type": "foreach", "stage": "refresh", "foreach": { "itemsPath": "backupBindings", "itemVariable": "oldBinding", "maxItems": 1000, "steps": [
      { "name": "restoreBinding", "type": "http", "request": { "method": "POST", "url": "https://{{deviceHost}}:{{managementPort}}/nitro/v1/config/sslvserver_sslcertkey_binding", "headers": { "Content-Type": "application/json", "X-NITRO-USER": "{{credential.username}}", "X-NITRO-PASS": "{{credential.password}}" }, "bodyType": "json", "body": { "sslvserver_sslcertkey_binding": "{{oldBinding}}" }, "tls": { "verify": "{{tlsVerify}}", "allowInsecure": true }, "successStatusCodes": [200, 201] } }
    ] } },
    { "name": "saveConfiguration", "type": "http", "stage": "verify", "request": { "method": "POST", "url": "https://{{deviceHost}}:{{managementPort}}/nitro/v1/config/nsconfig", "query": { "action": "save" }, "headers": { "Content-Type": "application/json", "X-NITRO-USER": "{{credential.username}}", "X-NITRO-PASS": "{{credential.password}}" }, "bodyType": "json", "body": { "nsconfig": {} }, "tls": { "verify": "{{tlsVerify}}", "allowInsecure": true }, "successStatusCodes": [200] }, "assert": [{ "type": "jsonPath", "path": "$.errorcode", "equals": 0 }] }
  ]
}
