{
  "apiVersion": "gcac.workflow/v1",
  "kind": "CurlSshWorkflow",
  "metadata": {
    "name": "citrix-adc-certificate-rollback",
    "displayName": "Citrix ADC certificate rollback",
    "category": "certificate",
    "version": "1.1.1",
    "platforms": ["appliance"],
    "updateMethods": ["curl"],
    "maintainer": "GCAC"
  },
  "variables": {
    "deviceHost": { "type": "string", "required": true },
    "managementPort": { "type": "number", "required": true, "default": 443 },
    "credential": { "type": "credential", "required": true, "sensitive": true },
    "tlsVerify": { "type": "boolean", "required": true, "default": true },
    "recoverySnapshot": { "type": "object", "required": true },
    "recoverySnapshotHash": { "type": "string", "required": true }
  },
  "steps": [
    {
      "name": "verifyRecoverySnapshot",
      "type": "checkpoint_verify",
      "stage": "prepare",
      "checkpointVerify": { "valuePath": "recoverySnapshot", "expectedHash": "{{recoverySnapshotHash}}" }
    },
    {
      "name": "readCurrentVersion",
      "type": "http",
      "stage": "prepare",
      "request": {
        "method": "GET",
        "url": "https://{{deviceHost}}:{{managementPort}}/nitro/v1/config/nsversion",
        "headers": { "Accept": "application/json", "X-NITRO-USER": "{{credential.username}}", "X-NITRO-PASS": "{{credential.secretRefs.password}}" },
        "tls": { "verify": "{{tlsVerify}}", "allowInsecure": true },
        "successStatusCodes": [200]
      },
      "extract": { "currentDeviceVersion": { "type": "firstOf", "paths": ["$.body.nsversion.version", "$.body.nsversion[0].version"] } },
      "assert": [{ "type": "jsonPath", "path": "$.errorcode", "equals": 0 }]
    },
    {
      "name": "verifyDeviceVersion",
      "type": "condition",
      "stage": "prepare",
      "condition": { "variable": "currentDeviceVersion", "equals": "{{recoverySnapshot.deviceVersion}}" },
      "description": "设备版本或 Build 漂移时停止自动回滚"
    },
    {
      "name": "restoreOldBindings",
      "type": "foreach",
      "stage": "refresh",
      "foreach": {
        "itemsPath": "recoverySnapshot.bindings",
        "itemVariable": "oldBinding",
        "maxItems": 1000,
        "steps": [
          {
            "name": "restoreOldBinding",
            "type": "http",
            "request": {
              "method": "POST",
              "url": "https://{{deviceHost}}:{{managementPort}}/nitro/v1/config/sslvserver_sslcertkey_binding",
              "headers": { "Content-Type": "application/json", "X-NITRO-USER": "{{credential.username}}", "X-NITRO-PASS": "{{credential.secretRefs.password}}" },
              "bodyType": "json",
              "body": { "sslvserver_sslcertkey_binding": "{{oldBinding}}" },
              "tls": { "verify": "{{tlsVerify}}", "allowInsecure": true },
              "successStatusCodes": [200, 201]
            }
          }
        ]
      }
    },
    {
      "name": "readBindingsAfterRestore",
      "type": "http",
      "stage": "refresh",
      "request": {
        "method": "GET",
        "url": "https://{{deviceHost}}:{{managementPort}}/nitro/v1/config/sslvserver_sslcertkey_binding",
        "query": { "bulkbindings": "yes" },
        "headers": { "Accept": "application/json", "X-NITRO-USER": "{{credential.username}}", "X-NITRO-PASS": "{{credential.secretRefs.password}}" },
        "tls": { "verify": "{{tlsVerify}}", "allowInsecure": true },
        "successStatusCodes": [200]
      },
      "assert": [{ "type": "jsonPath", "path": "$.errorcode", "equals": 0 }]
    },
    {
      "name": "compareRestoredBindings",
      "type": "transform",
      "stage": "refresh",
      "transform": {
        "engine": "jsonata",
        "input": {
          "expected": "{{recoverySnapshot.bindings}}",
          "actual": "{{steps.readBindingsAfterRestore.output.body.sslvserver_sslcertkey_binding}}"
        },
        "outputs": {
          "oldBindingsRestored": { "expression": "$count($filter(expected, function($item) { $count($filter(actual, function($candidate) { $candidate.vservername = $item.vservername and $candidate.certkeyname = $item.certkeyname and $candidate.snicert = $item.snicert and $candidate.priority = $item.priority })) = 1 })) = $count(expected)" }
        }
      }
    },
    {
      "name": "requireOldBindingsRestored",
      "type": "condition",
      "stage": "refresh",
      "condition": { "variable": "oldBindingsRestored", "equals": true },
      "description": "旧绑定未完整恢复时停止自动回滚"
    },
    {
      "name": "removeNewBindings",
      "type": "foreach",
      "stage": "refresh",
      "foreach": {
        "itemsPath": "recoverySnapshot.targets",
        "itemVariable": "target",
        "maxItems": 1000,
        "steps": [
          {
            "name": "removeNewBinding",
            "type": "http",
            "request": {
              "method": "DELETE",
              "url": "https://{{deviceHost}}:{{managementPort}}/nitro/v1/config/sslvserver_sslcertkey_binding/{{target.name}}?args=certkeyname:{{recoverySnapshot.newCertificateKeyName}}",
              "headers": { "Accept": "application/json", "X-NITRO-USER": "{{credential.username}}", "X-NITRO-PASS": "{{credential.secretRefs.password}}" },
              "tls": { "verify": "{{tlsVerify}}", "allowInsecure": true },
              "successStatusCodes": [200, 201]
            }
          }
        ]
      }
    },
    {
      "name": "readFinalBindings",
      "type": "http",
      "stage": "verify",
      "request": {
        "method": "GET",
        "url": "https://{{deviceHost}}:{{managementPort}}/nitro/v1/config/sslvserver_sslcertkey_binding",
        "query": { "bulkbindings": "yes" },
        "headers": { "Accept": "application/json", "X-NITRO-USER": "{{credential.username}}", "X-NITRO-PASS": "{{credential.secretRefs.password}}" },
        "tls": { "verify": "{{tlsVerify}}", "allowInsecure": true },
        "successStatusCodes": [200]
      },
      "assert": [{ "type": "jsonPath", "path": "$.errorcode", "equals": 0 }]
    },
    {
      "name": "compareFinalBindings",
      "type": "transform",
      "stage": "verify",
      "transform": {
        "engine": "jsonata",
        "input": {
          "expected": "{{recoverySnapshot.bindings}}",
          "actual": "{{steps.readFinalBindings.output.body.sslvserver_sslcertkey_binding}}",
          "targets": "{{recoverySnapshot.targets}}"
        },
        "outputs": {
          "finalBindingsEquivalent": { "expression": "$count($filter(actual, function($item) { $item.vservername in targets.name })) = $count(expected) and $count($filter(expected, function($item) { $count($filter(actual, function($candidate) { $candidate.vservername = $item.vservername and $candidate.certkeyname = $item.certkeyname and $candidate.snicert = $item.snicert and $candidate.priority = $item.priority })) = 1 })) = $count(expected)" }
        }
      }
    },
    {
      "name": "requireFinalBindingsEquivalent",
      "type": "condition",
      "stage": "verify",
      "condition": { "variable": "finalBindingsEquivalent", "equals": true },
      "description": "最终绑定集合与恢复快照不等价时停止并进入人工介入"
    },
    {
      "name": "saveConfiguration",
      "type": "http",
      "stage": "verify",
      "request": {
        "method": "POST",
        "url": "https://{{deviceHost}}:{{managementPort}}/nitro/v1/config/nsconfig",
        "query": { "action": "save" },
        "headers": { "Content-Type": "application/json", "X-NITRO-USER": "{{credential.username}}", "X-NITRO-PASS": "{{credential.secretRefs.password}}" },
        "bodyType": "json",
        "body": { "nsconfig": {} },
        "tls": { "verify": "{{tlsVerify}}", "allowInsecure": true },
        "successStatusCodes": [200]
      },
      "assert": [{ "type": "jsonPath", "path": "$.errorcode", "equals": 0 }]
    },
    {
      "name": "verifyPreviousTlsHandshakes",
      "type": "foreach",
      "stage": "verify",
      "foreach": {
        "itemsPath": "recoverySnapshot.targets",
        "itemVariable": "target",
        "maxItems": 1000,
        "steps": [
          {
            "name": "verifyPreviousTlsHandshake",
            "type": "tls_probe",
            "tlsProbe": {
              "host": "{{target.verifyHost}}",
              "port": 443,
              "serverName": "{{target.serverName}}",
              "expectedFingerprintSha256": "{{target.previousFingerprintSha256}}",
              "timeoutSeconds": 15
            }
          }
        ]
      }
    }
  ]
}
