{
  "apiVersion": "gcac.workflow/v1",
  "kind": "CurlSshWorkflow",
  "metadata": {
    "name": "citrix-adc-certificate-rollback",
    "displayName": "Citrix ADC certificate rollback",
    "category": "certificate",
    "version": "1.1.4",
    "platforms": ["appliance"],
    "updateMethods": ["curl"],
    "maintainer": "GCAC"
  },
  "inputContract": {
    "apiVersion": "gcac.deployment-input/v1",
    "variables": {
      "recoverySnapshot": { "type": "object", "required": true, "configurationMode": "required", "source": { "kind": "binding" }, "lifecycle": "pre_execution", "bindingPolicy": "required_binding", "sensitive": true },
      "recoverySnapshotHash": { "type": "string", "required": true, "configurationMode": "required", "source": { "kind": "binding" }, "lifecycle": "pre_execution", "bindingPolicy": "required_binding" }
    },
    "connections": {
      "management": {
        "transport": "http",
        "host": { "type": "string", "required": true, "configurationMode": "required", "source": { "kind": "binding" }, "lifecycle": "pre_execution", "bindingPolicy": "required_binding" },
        "port": { "type": "number", "required": true, "configurationMode": "advanced", "source": { "kind": "default" }, "lifecycle": "pre_execution", "bindingPolicy": "default_overridable", "default": 443 },
        "credentialSlot": "credential",
        "tls": {
          "verifyPeer": { "type": "boolean", "required": true, "configurationMode": "advanced", "source": { "kind": "default" }, "lifecycle": "pre_execution", "bindingPolicy": "default_overridable", "default": true }
        }
      }
    },
    "credentials": {
      "credential": { "allowedKinds": ["USERNAME_PASSWORD"], "required": true, "configurationMode": "required", "lifecycle": "pre_execution" }
    },
    "artifacts": {}
  },
  "steps": [
    {
      "name": "verifyRecoverySnapshot",
      "type": "checkpoint_verify",
      "stage": "prepare",
      "checkpointVerify": { "valuePath": "variables.recoverySnapshot", "expectedHash": "{{variables.recoverySnapshotHash}}" }
    },
    {
      "name": "readCurrentVersion",
      "type": "http",
      "stage": "prepare",
      "request": {
        "method": "GET",
        "connectionRef": "management",
        "url": "https://{{connections.management.host}}:{{connections.management.port}}/nitro/v1/config/nsversion",
        "headers": { "Accept": "application/json", "X-NITRO-USER": "{{credentials.credential.username}}", "X-NITRO-PASS": "{{credentials.credential.secretRefs.password}}" },
        "tls": { "verify": "{{connections.management.tls.verifyPeer}}", "allowInsecure": true },
        "successStatusCodes": [200]
      },
      "extract": { "currentDeviceVersion": { "type": "firstOf", "paths": ["$.body.nsversion.version", "$.body.nsversion[0].version"] } },
      "assert": [{ "type": "jsonPath", "path": "$.errorcode", "equals": 0 }]
    },
    {
      "name": "verifyDeviceVersion",
      "type": "condition",
      "stage": "prepare",
      "condition": { "variable": "steps.readCurrentVersion.extracted.currentDeviceVersion", "equals": "{{variables.recoverySnapshot.deviceVersion}}" },
      "description": "设备版本或 Build 漂移时停止自动回滚"
    },
    {
      "name": "restoreOldBindings",
      "type": "foreach",
      "stage": "refresh",
      "foreach": {
        "itemsPath": "variables.recoverySnapshot.bindings",
        "itemVariable": "oldBinding",
        "maxItems": 1000,
        "steps": [
          {
            "name": "restoreOldBinding",
            "type": "http",
            "request": {
              "method": "POST",
              "connectionRef": "management",
              "url": "https://{{connections.management.host}}:{{connections.management.port}}/nitro/v1/config/sslvserver_sslcertkey_binding",
              "headers": { "Content-Type": "application/json", "X-NITRO-USER": "{{credentials.credential.username}}", "X-NITRO-PASS": "{{credentials.credential.secretRefs.password}}" },
              "bodyType": "json",
              "body": { "sslvserver_sslcertkey_binding": "{{oldBinding}}" },
              "tls": { "verify": "{{connections.management.tls.verifyPeer}}", "allowInsecure": true },
              "successStatusCodes": [200, 201]
            }
          }
        ]
      }
    },
    {
      "name": "readBindingsAfterRestore",
      "type": "http",
      "stage": "refresh",
      "request": {
        "method": "GET",
        "connectionRef": "management",
        "url": "https://{{connections.management.host}}:{{connections.management.port}}/nitro/v1/config/sslvserver_sslcertkey_binding",
        "query": { "bulkbindings": "yes" },
        "headers": { "Accept": "application/json", "X-NITRO-USER": "{{credentials.credential.username}}", "X-NITRO-PASS": "{{credentials.credential.secretRefs.password}}" },
        "tls": { "verify": "{{connections.management.tls.verifyPeer}}", "allowInsecure": true },
        "successStatusCodes": [200]
      },
      "assert": [{ "type": "jsonPath", "path": "$.errorcode", "equals": 0 }]
    },
    {
      "name": "compareRestoredBindings",
      "type": "transform",
      "stage": "refresh",
      "transform": {
        "engine": "jsonata",
        "input": {
          "expected": "{{variables.recoverySnapshot.bindings}}",
          "actual": "{{steps.readBindingsAfterRestore.output.body.sslvserver_sslcertkey_binding}}"
        },
        "outputs": {
          "oldBindingsRestored": { "expression": "$count($filter(expected, function($item) { $count($filter(actual, function($candidate) { $candidate.vservername = $item.vservername and $candidate.certkeyname = $item.certkeyname and $candidate.snicert = $item.snicert and $candidate.priority = $item.priority })) = 1 })) = $count(expected)" }
        },
        "timeoutMs": 1000
      }
    },
    {
      "name": "requireOldBindingsRestored",
      "type": "condition",
      "stage": "refresh",
      "condition": { "variable": "steps.compareRestoredBindings.extracted.oldBindingsRestored", "equals": true },
      "description": "旧绑定未完整恢复时停止自动回滚"
    },
    {
      "name": "removeNewBindings",
      "type": "foreach",
      "stage": "refresh",
      "foreach": {
        "itemsPath": "variables.recoverySnapshot.targets",
        "itemVariable": "target",
        "maxItems": 1000,
        "steps": [
          {
            "name": "removeNewBinding",
            "type": "http",
            "request": {
              "method": "DELETE",
              "connectionRef": "management",
              "url": "https://{{connections.management.host}}:{{connections.management.port}}/nitro/v1/config/sslvserver_sslcertkey_binding/{{target.name}}?args=certkeyname:{{variables.recoverySnapshot.newCertificateKeyName}}",
              "headers": { "Accept": "application/json", "X-NITRO-USER": "{{credentials.credential.username}}", "X-NITRO-PASS": "{{credentials.credential.secretRefs.password}}" },
              "tls": { "verify": "{{connections.management.tls.verifyPeer}}", "allowInsecure": true },
              "successStatusCodes": [200, 201]
            }
          }
        ]
      }
    },
    {
      "name": "readFinalBindings",
      "type": "http",
      "stage": "verify",
      "request": {
        "method": "GET",
        "connectionRef": "management",
        "url": "https://{{connections.management.host}}:{{connections.management.port}}/nitro/v1/config/sslvserver_sslcertkey_binding",
        "query": { "bulkbindings": "yes" },
        "headers": { "Accept": "application/json", "X-NITRO-USER": "{{credentials.credential.username}}", "X-NITRO-PASS": "{{credentials.credential.secretRefs.password}}" },
        "tls": { "verify": "{{connections.management.tls.verifyPeer}}", "allowInsecure": true },
        "successStatusCodes": [200]
      },
      "assert": [{ "type": "jsonPath", "path": "$.errorcode", "equals": 0 }]
    },
    {
      "name": "compareFinalBindings",
      "type": "transform",
      "stage": "verify",
      "transform": {
        "engine": "jsonata",
        "input": {
          "expected": "{{variables.recoverySnapshot.bindings}}",
          "actual": "{{steps.readFinalBindings.output.body.sslvserver_sslcertkey_binding}}",
          "targets": "{{variables.recoverySnapshot.targets}}"
        },
        "outputs": {
          "finalBindingsEquivalent": { "expression": "$count($filter(actual, function($item) { $item.vservername in targets.name })) = $count(expected) and $count($filter(expected, function($item) { $count($filter(actual, function($candidate) { $candidate.vservername = $item.vservername and $candidate.certkeyname = $item.certkeyname and $candidate.snicert = $item.snicert and $candidate.priority = $item.priority })) = 1 })) = $count(expected)" }
        },
        "timeoutMs": 1000
      }
    },
    {
      "name": "requireFinalBindingsEquivalent",
      "type": "condition",
      "stage": "verify",
      "condition": { "variable": "steps.compareFinalBindings.extracted.finalBindingsEquivalent", "equals": true },
      "description": "最终绑定集合与恢复快照不等价时停止并进入人工介入"
    },
    {
      "name": "saveConfiguration",
      "type": "http",
      "stage": "verify",
      "request": {
        "method": "POST",
        "connectionRef": "management",
        "url": "https://{{connections.management.host}}:{{connections.management.port}}/nitro/v1/config/nsconfig",
        "query": { "action": "save" },
        "headers": { "Content-Type": "application/json", "X-NITRO-USER": "{{credentials.credential.username}}", "X-NITRO-PASS": "{{credentials.credential.secretRefs.password}}" },
        "bodyType": "json",
        "body": { "nsconfig": {} },
        "tls": { "verify": "{{connections.management.tls.verifyPeer}}", "allowInsecure": true },
        "successStatusCodes": [200]
      },
      "assert": [{ "type": "jsonPath", "path": "$.errorcode", "equals": 0 }]
    }
  ]
}
