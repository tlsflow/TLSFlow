{
  "apiVersion": "gcac.plugin-action-contract/v1",
  "actionId": "device.connection.test.v1",
  "capability": "device.connection.test",
  "actionContractVersion": "v1",
  "inputSchema": {
    "type": "object",
    "required": ["deviceAddress", "credential", "protocolFixture"],
    "properties": {
      "deviceAddress": { "type": "string", "minLength": 1, "maxLength": 512 },
      "displayName": { "type": "string", "minLength": 1, "maxLength": 512 },
      "credential": {
        "type": "object",
        "required": ["username", "secretRef"],
        "properties": {
          "username": { "type": "string", "minLength": 1, "maxLength": 256 },
          "secretRef": { "type": "string", "pattern": "^secret://[A-Za-z0-9._:/#-]{1,512}$" },
          "grantId": { "type": "string", "minLength": 1, "maxLength": 256 }
        },
        "additionalProperties": true
      },
      "protocolFixture": {
        "type": "object",
        "required": ["apiVersion", "protocol", "responses"],
        "properties": {
          "apiVersion": { "const": "gcac.device-fixture/v1" },
          "protocol": { "const": "NITRO" },
          "responses": { "type": "object", "additionalProperties": true }
        },
        "additionalProperties": true
      }
    },
    "additionalProperties": true
  },
  "outputSchema": {
    "type": "object",
    "required": ["summary", "normalizedObjects"],
    "properties": {
      "summary": { "type": "object", "required": ["protocol", "requestCount"], "additionalProperties": true },
      "normalizedObjects": { "type": "array" }
    },
    "additionalProperties": true
  },
  "writeEffect": false,
  "hostPermissions": ["secret.resolve", "network.http"]
}
