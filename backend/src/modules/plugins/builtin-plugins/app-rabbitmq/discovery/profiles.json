{
  "apiVersion": "gcac.plugin-discovery/v1",
  "kind": "AgentFactProfileSet",
  "pluginId": "app.rabbitmq",
  "version": "1.0.0",
  "profiles": [
    {
      "id": "linux.agent_plan.pem",
      "pluginId": "app.rabbitmq",
      "version": "1.0.0",
      "sources": [
        "linux"
      ],
      "pathMode": "explicit",
      "targetPaths": [
        "/etc/rabbitmq/tls/server.pem"
      ],
      "configPaths": [
        "/etc/rabbitmq/rabbitmq.conf"
      ],
      "processExecutables": [
        "/usr/lib/rabbitmq/bin/rabbitmq-server"
      ],
      "serviceNames": [
        "rabbitmq-server"
      ],
      "listeningPorts": [
        5671
      ],
      "frameworkType": "app.rabbitmq",
      "defaultPort": 5671
    }
  ]
}
