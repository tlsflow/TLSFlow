{
  "apiVersion": "gcac.workflow/v1",
  "kind": "CurlSshWorkflow",
  "metadata": {
    "name": "app-rabbitmq-certificate-deploy",
    "displayName": "RabbitMQ 证书部署",
    "description": "RabbitMQ 插件通过固定 Agent 事实和受授权执行绑定完成证书部署。",
    "category": "application",
    "tags": [
      "plugin",
      "app-rabbitmq",
      "certificate",
      "deploy"
    ],
    "version": "1.0.5",
    "platforms": [
      "linux"
    ],
    "maintainer": "GCAC"
  },
  "inputContract": {
    "apiVersion": "gcac.deployment-input/v1",
    "variables": {
      "certificatePath": {
        "type": "string",
        "required": true,
        "configurationMode": "required",
        "source": {
          "kind": "asset",
          "path": "target.certificateLocation.certificatePath"
        },
        "lifecycle": "pre_execution",
        "bindingPolicy": "fixed"
      },
      "configPath": {
        "type": "string",
        "required": true,
        "configurationMode": "required",
        "source": {
          "kind": "asset",
          "path": "target.certificateLocation.sourceConfigPath"
        },
        "lifecycle": "pre_execution",
        "bindingPolicy": "fixed"
      },
      "serviceName": {
        "type": "string",
        "required": false,
        "configurationMode": "advanced",
        "source": {
          "kind": "asset",
          "path": "target.certificateLocation.serviceName"
        },
        "lifecycle": "pre_execution",
        "bindingPolicy": "fixed"
      }
    },
    "connections": {},
    "credentials": {},
    "artifacts": {
      "certificateArtifact": {
        "kind": "certificate",
        "required": true,
        "configurationMode": "required",
        "lifecycle": "pre_execution",
        "artifactContract": {
          "outputs": {
            "certificate": {
              "role": "certificate",
              "required": true,
              "format": "PEM",
              "encoding": "base64",
              "sensitive": false
            },
            "privateKey": {
              "role": "private-key",
              "required": true,
              "format": "PEM",
              "encoding": "base64",
              "sensitive": true
            }
          }
        }
      }
    }
  },
  "steps": [
    {
      "name": "bindDeploymentInputs",
      "type": "transform",
      "stage": "prepare",
      "transform": {
        "engine": "jsonata",
        "input": {
          "targetPath": "{{variables.certificatePath}}",
          "configPath": "{{variables.configPath}}",
          "serviceName": "{{variables.serviceName}}",
          "artifact": "{{artifacts.certificateArtifact}}"
        },
        "outputs": {
          "targetPath": {
            "expression": "targetPath"
          },
          "configPath": {
            "expression": "configPath"
          },
          "serviceName": {
            "expression": "serviceName"
          },
          "artifactBound": {
            "expression": "$exists(artifact)"
          }
        },
        "timeoutMs": 1000,
        "maxInputBytes": 65536,
        "maxOutputBytes": 65536
      }
    },
    {
      "name": "requireDeploymentAuthorizationInputs",
      "type": "condition",
      "stage": "prepare",
      "condition": {
        "variable": "steps.bindDeploymentInputs.extracted.artifactBound",
        "equals": true
      },
      "description": "缺少证书 Artifact 绑定时停止生成部署计划"
    },
    {
      "name": "captureBeforeChange",
      "type": "checkpoint",
      "stage": "backup",
      "checkpoint": {
        "name": "certificate-file-before-change",
        "capture": {
          "targetPath": "steps.bindDeploymentInputs.extracted.targetPath",
          "configPath": "steps.bindDeploymentInputs.extracted.configPath"
        },
        "normalizedHash": true,
        "requiredForRollback": true
      }
    },
    {
      "name": "describeAuthorizedAtomicPlan",
      "type": "transform",
      "stage": "install",
      "transform": {
        "engine": "jsonata",
        "input": {
          "targetPath": "{{steps.bindDeploymentInputs.extracted.targetPath}}",
          "artifactBound": "{{steps.bindDeploymentInputs.extracted.artifactBound}}"
        },
        "outputs": {
          "targetPath": {
            "expression": "targetPath"
          },
          "artifactBound": {
            "expression": "artifactBound"
          }
        },
        "timeoutMs": 1000,
        "maxInputBytes": 65536,
        "maxOutputBytes": 65536
      }
    },
    {
      "name": "requireAtomicPlanTarget",
      "type": "condition",
      "stage": "install",
      "condition": {
        "variable": "steps.describeAuthorizedAtomicPlan.extracted.targetPath",
        "exists": true
      },
      "description": "原子替换计划必须绑定事实中的目标路径"
    },
    {
      "name": "bindRefreshEvidence",
      "type": "transform",
      "stage": "refresh",
      "transform": {
        "engine": "jsonata",
        "input": {
          "serviceName": "{{steps.bindDeploymentInputs.extracted.serviceName}}"
        },
        "outputs": {
          "serviceName": {
            "expression": "serviceName"
          }
        },
        "timeoutMs": 1000,
        "maxInputBytes": 65536,
        "maxOutputBytes": 65536
      }
    },
    {
      "name": "bindDeploymentVerification",
      "type": "transform",
      "stage": "verify",
      "transform": {
        "engine": "jsonata",
        "input": {
          "targetPath": "{{steps.bindDeploymentInputs.extracted.targetPath}}",
          "artifactBound": "{{steps.bindDeploymentInputs.extracted.artifactBound}}"
        },
        "outputs": {
          "targetPath": {
            "expression": "targetPath"
          },
          "artifactBound": {
            "expression": "artifactBound"
          }
        },
        "timeoutMs": 1000,
        "maxInputBytes": 65536,
        "maxOutputBytes": 65536
      }
    },
    {
      "name": "requireDeploymentVerificationBinding",
      "type": "condition",
      "stage": "verify",
      "condition": {
        "variable": "steps.bindDeploymentVerification.extracted.targetPath",
        "exists": true
      },
      "description": "部署完成前必须保留同一目标和 Artifact 绑定"
    }
  ],
  "rollback": [
    {
      "name": "bindRollbackCheckpoint",
      "type": "transform",
      "stage": "prepare",
      "transform": {
        "engine": "jsonata",
        "input": {
          "targetPath": "{{steps.bindDeploymentInputs.extracted.targetPath}}",
          "configPath": "{{steps.bindDeploymentInputs.extracted.configPath}}"
        },
        "outputs": {
          "targetPath": {
            "expression": "targetPath"
          },
          "configPath": {
            "expression": "configPath"
          }
        },
        "timeoutMs": 1000,
        "maxInputBytes": 65536,
        "maxOutputBytes": 65536
      }
    },
    {
      "name": "requireRollbackCheckpoint",
      "type": "condition",
      "stage": "prepare",
      "condition": {
        "variable": "steps.bindRollbackCheckpoint.extracted.targetPath",
        "exists": true
      },
      "description": "没有原子替换前的 checkpoint 时拒绝回滚"
    },
    {
      "name": "describeAuthorizedRestorePlan",
      "type": "transform",
      "stage": "install",
      "transform": {
        "engine": "jsonata",
        "input": {
          "targetPath": "{{steps.bindRollbackCheckpoint.extracted.targetPath}}",
          "configPath": "{{steps.bindRollbackCheckpoint.extracted.configPath}}"
        },
        "outputs": {
          "targetPath": {
            "expression": "targetPath"
          },
          "configPath": {
            "expression": "configPath"
          }
        },
        "timeoutMs": 1000,
        "maxInputBytes": 65536,
        "maxOutputBytes": 65536
      }
    },
    {
      "name": "requireRestoredTarget",
      "type": "condition",
      "stage": "verify",
      "condition": {
        "variable": "steps.describeAuthorizedRestorePlan.extracted.targetPath",
        "exists": true
      },
      "description": "回滚必须回到同一固定目标路径"
    }
  ]
}
