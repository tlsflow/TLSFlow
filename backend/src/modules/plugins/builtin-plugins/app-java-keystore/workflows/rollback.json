{
  "apiVersion": "gcac.workflow/v1",
  "kind": "CurlSshWorkflow",
  "metadata": {
    "name": "app-java-keystore-certificate-rollback",
    "displayName": "Java KeyStore 证书回滚",
    "description": "Java KeyStore 插件通过固定 Agent 事实和受授权执行绑定完成证书回滚。",
    "category": "application",
    "tags": [
      "plugin",
      "app-java-keystore",
      "certificate",
      "rollback"
    ],
    "version": "1.0.5",
    "platforms": [
      "linux",
      "windows"
    ],
    "maintainer": "GCAC"
  },
  "inputContract": {
    "apiVersion": "gcac.deployment-input/v1",
    "variables": {
      "certificatePath": {
        "type": "string",
        "required": true,
        "configurationMode": "required",
        "source": {
          "kind": "asset",
          "path": "target.certificateLocation.keystorePath"
        },
        "lifecycle": "pre_execution",
        "bindingPolicy": "fixed"
      },
      "configPath": {
        "type": "string",
        "required": true,
        "configurationMode": "required",
        "source": {
          "kind": "asset",
          "path": "target.certificateLocation.sourceConfigPath"
        },
        "lifecycle": "pre_execution",
        "bindingPolicy": "fixed"
      },
      "serviceName": {
        "type": "string",
        "required": false,
        "configurationMode": "advanced",
        "source": {
          "kind": "asset",
          "path": "target.certificateLocation.serviceName"
        },
        "lifecycle": "pre_execution",
        "bindingPolicy": "fixed"
      },
      "backupReference": {
        "type": "string",
        "required": true,
        "configurationMode": "required",
        "source": {
          "kind": "binding"
        },
        "lifecycle": "pre_execution",
        "bindingPolicy": "required_binding"
      }
    },
    "connections": {},
    "credentials": {},
    "artifacts": {}
  },
  "steps": [
    {
      "name": "bindRollbackInputs",
      "type": "transform",
      "stage": "prepare",
      "transform": {
        "engine": "jsonata",
        "input": {
          "targetPath": "{{variables.certificatePath}}",
          "configPath": "{{variables.configPath}}",
          "backupReference": "{{variables.backupReference}}"
        },
        "outputs": {
          "targetPath": {
            "expression": "targetPath"
          },
          "configPath": {
            "expression": "configPath"
          },
          "backupReference": {
            "expression": "backupReference"
          },
          "rollbackBound": {
            "expression": "$exists(targetPath) and $exists(backupReference)"
          }
        },
        "timeoutMs": 1000,
        "maxInputBytes": 65536,
        "maxOutputBytes": 65536
      }
    },
    {
      "name": "requireRollbackAuthorization",
      "type": "condition",
      "stage": "prepare",
      "condition": {
        "variable": "steps.bindRollbackInputs.extracted.rollbackBound",
        "equals": true
      },
      "description": "回滚必须同时绑定原目标、checkpoint 和授权引用"
    },
    {
      "name": "describeAuthorizedRestorePlan",
      "type": "transform",
      "stage": "install",
      "transform": {
        "engine": "jsonata",
        "input": {
          "targetPath": "{{steps.bindRollbackInputs.extracted.targetPath}}",
          "configPath": "{{steps.bindRollbackInputs.extracted.configPath}}",
          "backupReference": "{{steps.bindRollbackInputs.extracted.backupReference}}"
        },
        "outputs": {
          "targetPath": {
            "expression": "targetPath"
          },
          "configPath": {
            "expression": "configPath"
          },
          "backupReference": {
            "expression": "backupReference"
          }
        },
        "timeoutMs": 1000,
        "maxInputBytes": 65536,
        "maxOutputBytes": 65536
      }
    },
    {
      "name": "requireRestoredTarget",
      "type": "condition",
      "stage": "verify",
      "condition": {
        "variable": "steps.describeAuthorizedRestorePlan.extracted.targetPath",
        "exists": true
      },
      "description": "恢复计划必须绑定同一目标路径并等待最终验证"
    }
  ]
}
