{
  "apiVersion": "gcac.plugin-manifest/v1",
  "kind": "GcacPlugin",
  "pluginId": "device.synology-dsm",
  "version": "1.0.7",
  "displayNameKey": "plugin.synologyDsm.name",
  "descriptionKey": "plugin.synologyDsm.description",
  "logoUrl": "/plugin-logos/synology.svg",
  "defaultLocale": "zh-CN",
  "publisher": "GCAC",
  "runtime": "WORKFLOW_DSL",
  "source": "BUILTIN",
  "scope": "BOTH",
  "trust": "OFFICIAL_SIGNED",
  "support": "OFFICIAL",
  "capabilities": [
    { "key": "device.connection.test", "contractVersion": "v1", "actionContractId": "device.connection.test.v1", "riskLevel": "LOW", "executionLocations": ["CONTROL_PLANE", "GATEWAY"] },
    { "key": "device.discover", "contractVersion": "v1", "actionContractId": "device.discover.v1", "riskLevel": "LOW", "executionLocations": ["CONTROL_PLANE", "GATEWAY"] },
    { "key": "certificate.deploy", "contractVersion": "v1", "actionContractId": "certificate.deploy.v1", "riskLevel": "HIGH", "executionLocations": ["CONTROL_PLANE", "GATEWAY"] },
    { "key": "certificate.rollback", "contractVersion": "v1", "actionContractId": "certificate.rollback.v1", "riskLevel": "HIGH", "executionLocations": ["CONTROL_PLANE", "GATEWAY"] }
  ],
  "permissions": [
    "secret.resolve",
    "artifact.read",
    "network.http",
    "device.write",
    "audit.append"
  ],
  "compatibility": {
    "productFamilies": ["device.synology-dsm"],
    "frameworkTypes": ["synology.dsm-web"],
    "targetTypes": ["tls.binding"],
    "managementMethods": ["PLUGIN"],
    "executionLocations": ["CONTROL_PLANE", "GATEWAY"],
    "artifactContracts": ["certificate.deploy.v1"]
  },
  "resources": {
    "runtimeEntrypoint": "runtime/index.js",
    "actionContracts": {
      "device.connection.test.v1": "action-contracts/device-connection-test.json",
      "device.discover.v1": "action-contracts/device-discover.json",
      "certificate.deploy.v1": "action-contracts/certificate-deploy.json",
      "certificate.rollback.v1": "action-contracts/certificate-rollback.json"
    },
    "workflows": {
      "device.connection.test": "workflows/connection-test.json",
      "device.discover": "workflows/discover.json",
      "certificate.deploy": "workflows/deploy.json",
      "certificate.rollback": "workflows/rollback.json"
    },
    "forms": { "device": "forms/device.json" },
    "presentations": { "device": "presentations/device.json" },
    "discoveryMappings": { "dsm-v1": "discovery/dsm.json" },
    "onboarding": { "applicationAsset": "onboarding/application-asset.json" },
    "locales": {
      "zh-CN": "locales/zh-CN.json",
      "zh-TW": "locales/zh-TW.json",
      "en-US": "locales/en-US.json",
      "ja-JP": "locales/ja-JP.json",
      "ko-KR": "locales/ko-KR.json",
      "fr-FR": "locales/fr-FR.json",
      "ru-RU": "locales/ru-RU.json",
      "pt-BR": "locales/pt-BR.json"
    }
  }
}
