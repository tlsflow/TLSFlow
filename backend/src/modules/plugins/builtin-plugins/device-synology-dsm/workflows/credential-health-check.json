{
  "apiVersion": "gcac.workflow/v1",
  "kind": "CurlSshWorkflow",
  "metadata": { "name": "synology-dsm-credential-health-check", "displayName": "Synology DSM credential health check", "category": "device", "version": "2.0.22", "platforms": ["appliance"], "updateMethods": ["curl"], "maintainer": "GCAC" },
  "inputContract": {
    "apiVersion": "gcac.deployment-input/v1",
    "variables": {
      "allowInsecureTls": {
        "type": "boolean", "required": true, "configurationMode": "required", "source": { "kind": "binding" }, "lifecycle": "pre_execution", "bindingPolicy": "required_binding", "descriptionKey": "deploymentInputs.allowInsecureTls.description",
        "ui": { "labelKey": "deploymentInputs.allowInsecureTls.label", "group": "security", "order": 10, "helpKey": "deploymentInputs.allowInsecureTls.help" }
      }
    },
    "connections": { "management": { "transport": "http", "allowedProtocols": ["http", "https"], "host": { "type": "string", "required": true, "configurationMode": "required", "source": { "kind": "binding" }, "lifecycle": "pre_execution", "bindingPolicy": "required_binding" }, "port": { "type": "number", "required": true, "configurationMode": "advanced", "source": { "kind": "default" }, "lifecycle": "pre_execution", "bindingPolicy": "default_overridable", "default": 5001 }, "credentialSlot": "credential", "tls": { "enabled": { "type": "boolean", "required": true, "configurationMode": "advanced", "source": { "kind": "default" }, "lifecycle": "pre_execution", "bindingPolicy": "default_overridable", "default": true }, "verifyPeer": { "type": "boolean", "required": true, "configurationMode": "advanced", "source": { "kind": "default" }, "lifecycle": "pre_execution", "bindingPolicy": "default_overridable", "default": true }, "serverName": { "type": "string", "required": true, "configurationMode": "runtime", "source": { "kind": "asset", "path": "application.serverName" }, "lifecycle": "pre_execution", "bindingPolicy": "fixed" } } } },
    "credentials": { "credential": { "allowedKinds": ["USERNAME_PASSWORD"], "required": true, "configurationMode": "required", "lifecycle": "pre_execution" } },
    "artifacts": {}
  },
  "steps": [
    { "name": "authenticate", "type": "http", "stage": "prepare", "request": { "method": "POST", "connectionRef": "management", "url": "/webapi/auth.cgi", "bodyType": "form", "form": { "api": "SYNO.API.Auth", "version": 7, "method": "login", "session": "GCAC", "format": "sid", "enable_syno_token": "yes", "client": "browser", "account": "{{credentials.credential.username}}" }, "formCredentialRefs": { "passwd": "{{credentials.credential}}" }, "headers": { "Accept": "application/json" }, "tls": { "verify": "{{connections.management.tls.verifyPeer}}", "sni": "{{connections.management.tls.serverName}}", "allowInsecure": true }, "timeoutSeconds": 30, "maxResponseBytes": 1048576, "successStatusCodes": [200] }, "extract": [{ "name": "authResponse", "type": "outputPath", "path": "$", "sensitive": true }] },
    { "name": "classifyAuthentication", "type": "transform", "stage": "verify", "transform": { "engine": "jsonata", "input": { "authResponse": "{{steps.authenticate.extracted.authResponse}}" }, "outputs": { "credentialHealth": { "expression": "authResponse.body.success = true ? {'apiVersion':'gcac.credential-health-result/v1','status':'VALID','summary':'设备认证成功','evidence':{'protocol':'DSM'}} : {'apiVersion':'gcac.credential-health-result/v1','status':'ERROR','reasonCode':'PASSWORD_INVALID','summary':'设备拒绝凭据认证','evidence':{'protocol':'DSM','remoteErrorCode':$string(authResponse.body.error.code)}}" } }, "timeoutMs": 1000, "maxInputBytes": 1048576, "maxOutputBytes": 65536 } },
    { "name": "readDsmInfo", "type": "http", "stage": "verify", "when": { "variable": "steps.classifyAuthentication.extracted.credentialHealth.status", "equals": "VALID" }, "request": { "method": "GET", "connectionRef": "management", "url": "/webapi/entry.cgi?api=SYNO.DSM.Info&version=2&method=getinfo&_sid={{steps.authenticate.extracted.authResponse.body.data.sid}}", "headers": { "Accept": "application/json", "X-SYNO-TOKEN": "{{steps.authenticate.extracted.authResponse.body.data.synotoken}}" }, "tls": { "verify": "{{connections.management.tls.verifyPeer}}", "sni": "{{connections.management.tls.serverName}}", "allowInsecure": true }, "timeoutSeconds": 30, "maxResponseBytes": 1048576, "successStatusCodes": [200] }, "assert": [{ "type": "jsonPath", "path": "$.success", "equals": true }] }
  ]
}
