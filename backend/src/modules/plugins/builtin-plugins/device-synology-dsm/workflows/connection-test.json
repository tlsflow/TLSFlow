{
  "apiVersion": "gcac.workflow/v1",
  "kind": "CurlSshWorkflow",
  "metadata": { "name": "synology-dsm-connection-test", "displayName": "Synology DSM connection test", "category": "device", "version": "2.0.22", "platforms": ["appliance"], "updateMethods": ["curl"], "maintainer": "GCAC" },
  "inputContract": {
    "apiVersion": "gcac.deployment-input/v1",
    "variables": {
      "allowInsecureTls": {
        "type": "boolean",
        "required": true,
        "configurationMode": "required",
        "source": { "kind": "binding" },
        "lifecycle": "pre_execution",
        "bindingPolicy": "required_binding",
        "descriptionKey": "deploymentInputs.allowInsecureTls.description",
        "ui": {
          "labelKey": "deploymentInputs.allowInsecureTls.label",
          "group": "security",
          "order": 10,
          "helpKey": "deploymentInputs.allowInsecureTls.help"
        }
      }
    },
    "connections": { "management": { "transport": "http", "allowedProtocols": ["http", "https"], "host": { "type": "string", "required": true, "configurationMode": "required", "source": { "kind": "binding" }, "lifecycle": "pre_execution", "bindingPolicy": "required_binding" }, "port": { "type": "number", "required": true, "configurationMode": "advanced", "source": { "kind": "default" }, "lifecycle": "pre_execution", "bindingPolicy": "default_overridable", "default": 5001 }, "credentialSlot": "credential", "tls": { "enabled": { "type": "boolean", "required": true, "configurationMode": "advanced", "source": { "kind": "default" }, "lifecycle": "pre_execution", "bindingPolicy": "default_overridable", "default": true }, "verifyPeer": { "type": "boolean", "required": true, "configurationMode": "advanced", "source": { "kind": "default" }, "lifecycle": "pre_execution", "bindingPolicy": "default_overridable", "default": true }, "serverName": { "type": "string", "required": true, "configurationMode": "runtime", "source": { "kind": "asset", "path": "application.serverName" }, "lifecycle": "pre_execution", "bindingPolicy": "fixed" } } } },
    "credentials": { "credential": { "allowedKinds": ["USERNAME_PASSWORD"], "required": true, "configurationMode": "required", "lifecycle": "pre_execution" } },
    "artifacts": {}
  },
  "steps": [
    { "name": "authenticate", "type": "http", "stage": "prepare", "request": { "method": "POST", "connectionRef": "management", "url": "/webapi/auth.cgi", "bodyType": "form", "form": { "api": "SYNO.API.Auth", "version": 7, "method": "login", "session": "GCAC", "format": "sid", "enable_syno_token": "yes", "client": "browser", "account": "{{credentials.credential.username}}" }, "formCredentialRefs": { "passwd": "{{credentials.credential}}" }, "headers": { "Accept": "application/json" }, "tls": { "verify": "{{connections.management.tls.verifyPeer}}", "sni": "{{connections.management.tls.serverName}}", "allowInsecure": true }, "timeoutSeconds": 30, "maxResponseBytes": 1048576, "successStatusCodes": [200] }, "extract": [{ "name": "sid", "type": "jsonPath", "path": "$.data.sid" }, { "name": "synotoken", "type": "jsonPath", "path": "$.data.synotoken", "sensitive": true }], "assert": [{ "type": "statusCode", "equals": 200 }, { "type": "jsonPath", "path": "$.success", "equals": true }] },
    { "name": "readDsmInfo", "type": "http", "stage": "verify", "request": { "method": "GET", "connectionRef": "management", "url": "/webapi/entry.cgi?api=SYNO.DSM.Info&version=2&method=getinfo&_sid={{steps.authenticate.extracted.sid}}", "headers": { "Accept": "application/json", "X-SYNO-TOKEN": "{{steps.authenticate.extracted.synotoken}}" }, "tls": { "verify": "{{connections.management.tls.verifyPeer}}", "sni": "{{connections.management.tls.serverName}}", "allowInsecure": true }, "timeoutSeconds": 30, "maxResponseBytes": 1048576, "successStatusCodes": [200] }, "extract": [{ "name": "dsmInfoData", "type": "jsonPath", "path": "$.data" }], "assert": [{ "type": "statusCode", "equals": 200 }, { "type": "jsonPath", "path": "$.success", "equals": true }] },
    { "name": "normalizeDsmVersion", "type": "transform", "stage": "verify", "transform": { "engine": "jsonata", "input": { "response": "{{steps.readDsmInfo.extracted.dsmInfoData}}" }, "outputs": { "productVersion": { "expression": "($data := response.data ? response.data : response; $nested := $lookup($data,'SYNO.DSM.Info') ? $lookup($data,'SYNO.DSM.Info') : {}; $versionCandidate := $data.systemVersion ? $data.systemVersion : ($data.productVersion ? $data.productVersion : ($data.versionString ? $data.versionString : ($data.version_string ? $data.version_string : ($data.dsmVersion ? $data.dsmVersion : ($nested.systemVersion ? $nested.systemVersion : ($nested.productVersion ? $nested.productVersion : ($nested.versionString ? $nested.versionString : ($nested.version_string ? $nested.version_string : ($nested.dsmVersion ? $nested.dsmVersion : ($nested.version ? $nested.version : $data.version)))))))))); $versionMatch := $match($string($versionCandidate),/([0-9]+\\.[0-9]+(\\.[0-9]+)?)/); $versionMatch.groups[0])" }, "productBuild": { "expression": "($data := response.data ? response.data : response; $nested := $lookup($data,'SYNO.DSM.Info') ? $lookup($data,'SYNO.DSM.Info') : {}; $buildCandidate := $data.build ? $data.build : ($data.buildVersion ? $data.buildVersion : ($data.versionString ? $data.versionString : ($data.version_string ? $data.version_string : ($nested.build ? $nested.build : ($nested.buildVersion ? $nested.buildVersion : ($nested.versionString ? $nested.versionString : ($nested.version_string ? $nested.version_string : ($nested.version ? $nested.version : $data.version)))))))); $buildMatch := $match($string($buildCandidate),/(^|[-_ ])([0-9]{4,})/); $buildMatch.groups[1])" } }, "timeoutMs": 1000, "maxInputBytes": 1048576, "maxOutputBytes": 65536 } }
  ]
}
