{
  "apiVersion": "gcac.workflow/v1",
  "kind": "CurlSshWorkflow",
  "metadata": { "name": "synology-dsm-connection-test", "displayName": "Synology DSM connection test", "category": "device", "version": "1.0.3", "platforms": ["appliance"], "updateMethods": ["curl"], "maintainer": "GCAC" },
  "inputContract": {
    "apiVersion": "gcac.deployment-input/v1",
    "variables": {},
    "connections": { "management": { "transport": "http", "host": { "type": "string", "required": true, "configurationMode": "required", "source": { "kind": "binding" }, "lifecycle": "pre_execution", "bindingPolicy": "required_binding" }, "port": { "type": "number", "required": true, "configurationMode": "advanced", "source": { "kind": "default" }, "lifecycle": "pre_execution", "bindingPolicy": "default_overridable", "default": 5001 }, "credentialSlot": "credential", "tls": { "verifyPeer": { "type": "boolean", "required": true, "configurationMode": "advanced", "source": { "kind": "default" }, "lifecycle": "pre_execution", "bindingPolicy": "default_overridable", "default": true } } } },
    "credentials": { "credential": { "allowedKinds": ["USERNAME_PASSWORD"], "required": true, "configurationMode": "required", "lifecycle": "pre_execution" } },
    "artifacts": {}
  },
  "steps": [
    { "name": "authenticate", "type": "http", "stage": "prepare", "request": { "method": "POST", "connectionRef": "management", "url": "https://{{connections.management.host}}:{{connections.management.port}}/webapi/auth.cgi?api=SYNO.API.Auth&version=7&method=login&session=GCAC&format=sid", "headers": { "Accept": "application/json", "Content-Type": "application/x-www-form-urlencoded" }, "body": { "account": "{{credentials.credential.username}}", "password": "{{credentials.credential.secretRefs.password}}" }, "tls": { "verify": "{{connections.management.tls.verifyPeer}}", "allowInsecure": false }, "timeoutSeconds": 30, "maxResponseBytes": 1048576, "successStatusCodes": [200] }, "extract": [{ "name": "sid", "type": "jsonPath", "path": "$.data.sid" }], "assert": [{ "type": "statusCode", "equals": 200 }, { "type": "jsonPath", "path": "$.success", "equals": true }] },
    { "name": "readDsmInfo", "type": "http", "stage": "verify", "request": { "method": "GET", "connectionRef": "management", "url": "https://{{connections.management.host}}:{{connections.management.port}}/webapi/entry.cgi?api=SYNO.DSM.Info&version=2&method=get&_sid={{steps.authenticate.extracted.sid}}", "headers": { "Accept": "application/json" }, "tls": { "verify": "{{connections.management.tls.verifyPeer}}", "allowInsecure": false }, "timeoutSeconds": 30, "maxResponseBytes": 1048576, "successStatusCodes": [200] }, "extract": [{ "name": "productVersion", "type": "jsonPath", "path": "$.data.version" }], "assert": [{ "type": "statusCode", "equals": 200 }, { "type": "jsonPath", "path": "$.success", "equals": true }] }
  ]
}
