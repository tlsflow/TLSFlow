{
  "apiVersion": "gcac.workflow/v1",
  "kind": "CurlSshWorkflow",
  "metadata": { "name": "synology-dsm-certificate-deploy", "displayName": "Synology DSM certificate deployment", "category": "certificate", "version": "1.0.0", "platforms": ["appliance"], "updateMethods": ["curl"], "maintainer": "GCAC" },
  "inputContract": {
    "apiVersion": "gcac.deployment-input/v1",
    "variables": { "target": { "type": "string", "required": true, "configurationMode": "runtime", "source": { "kind": "asset", "path": "deployment.target" }, "lifecycle": "pre_execution", "bindingPolicy": "fixed" }, "certificateId": { "type": "string", "required": false, "configurationMode": "runtime", "source": { "kind": "derived", "resolver": "certificate_resource_name" }, "lifecycle": "pre_execution", "bindingPolicy": "fixed" } },
    "connections": { "management": { "transport": "http", "host": { "type": "string", "required": true, "configurationMode": "required", "source": { "kind": "binding" }, "lifecycle": "pre_execution", "bindingPolicy": "required_binding" }, "port": { "type": "number", "required": true, "configurationMode": "advanced", "source": { "kind": "default" }, "lifecycle": "pre_execution", "bindingPolicy": "default_overridable", "default": 5001 }, "credentialSlot": "credential", "tls": { "verifyPeer": { "type": "boolean", "required": true, "configurationMode": "advanced", "source": { "kind": "default" }, "lifecycle": "pre_execution", "bindingPolicy": "default_overridable", "default": true } } } },
    "credentials": { "credential": { "allowedKinds": ["USERNAME_PASSWORD"], "required": true, "configurationMode": "required", "lifecycle": "pre_execution" } },
    "artifacts": { "certificate": { "type": "certificate", "required": true, "configurationMode": "runtime", "source": { "kind": "binding", "path": "certificate" }, "lifecycle": "pre_execution", "bindingPolicy": "fixed", "artifactContract": "certificate.deploy.v1" } }
  },
  "steps": [
    { "name": "readCurrentCertificate", "type": "http", "stage": "prepare", "request": { "method": "GET", "connectionRef": "management", "url": "https://{{connections.management.host}}:{{connections.management.port}}/webapi/entry.cgi?api=SYNO.Core.Certificate&version=1&method=list", "headers": { "Accept": "application/json" }, "tls": { "verify": "{{connections.management.tls.verifyPeer}}", "allowInsecure": false }, "successStatusCodes": [200] }, "extract": [{ "name": "previousCertificate", "type": "outputPath", "path": "$.body" }], "assert": [{ "type": "jsonPath", "path": "$.success", "equals": true }] },
    { "name": "importCertificate", "type": "http", "stage": "execute", "request": { "method": "POST", "connectionRef": "management", "url": "https://{{connections.management.host}}:{{connections.management.port}}/webapi/entry.cgi?api=SYNO.Core.Certificate&version=1&method=import", "headers": { "Accept": "application/json", "Content-Type": "application/json" }, "body": { "target": "{{variables.target}}", "certificateId": "{{variables.certificateId}}", "artifactRef": "{{artifacts.certificate.artifactRef}}" }, "tls": { "verify": "{{connections.management.tls.verifyPeer}}", "allowInsecure": false }, "successStatusCodes": [200], "timeoutSeconds": 60 }, "assert": [{ "type": "jsonPath", "path": "$.success", "equals": true }] },
    { "name": "verifyCertificate", "type": "http", "stage": "verify", "request": { "method": "GET", "connectionRef": "management", "url": "https://{{connections.management.host}}:{{connections.management.port}}/webapi/entry.cgi?api=SYNO.Core.Certificate&version=1&method=list", "headers": { "Accept": "application/json" }, "tls": { "verify": "{{connections.management.tls.verifyPeer}}", "allowInsecure": false }, "successStatusCodes": [200] }, "assert": [{ "type": "jsonPath", "path": "$.success", "equals": true }, { "type": "jsonPath", "path": "$.data.certificates", "exists": true }] }
  ]
}
