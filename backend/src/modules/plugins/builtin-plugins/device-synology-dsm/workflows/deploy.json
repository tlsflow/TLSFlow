{
  "apiVersion": "gcac.workflow/v1",
  "kind": "CurlSshWorkflow",
  "metadata": { "name": "synology-dsm-certificate-deploy", "displayName": "Synology DSM certificate deployment", "category": "certificate", "version": "2.0.6", "platforms": ["appliance"], "updateMethods": ["curl"], "maintainer": "GCAC" },
  "inputContract": {
    "apiVersion": "gcac.deployment-input/v1",
    "variables": {
      "allowInsecureTls": {
        "type": "boolean",
        "required": true,
        "configurationMode": "required",
        "source": { "kind": "binding" },
        "lifecycle": "pre_execution",
        "bindingPolicy": "required_binding",
        "descriptionKey": "deploymentInputs.allowInsecureTls.description",
        "ui": {
          "labelKey": "deploymentInputs.allowInsecureTls.label",
          "group": "security",
          "order": 10,
          "helpKey": "deploymentInputs.allowInsecureTls.help"
        }
      },
      "target": { "type": "string", "required": true, "configurationMode": "runtime", "source": { "kind": "derived", "resolver": "deployment_target_name" }, "lifecycle": "pre_execution", "bindingPolicy": "fixed" },
      "certificateId": { "type": "string", "required": false, "configurationMode": "runtime", "source": { "kind": "derived", "resolver": "certificate_resource_name" }, "lifecycle": "pre_execution", "bindingPolicy": "fixed" }
    },
    "connections": {
      "management": {
        "transport": "http",
        "allowedProtocols": ["http", "https"],
        "host": { "type": "string", "required": true, "configurationMode": "required", "source": { "kind": "binding" }, "lifecycle": "pre_execution", "bindingPolicy": "required_binding" },
        "port": { "type": "number", "required": true, "configurationMode": "advanced", "source": { "kind": "default" }, "lifecycle": "pre_execution", "bindingPolicy": "default_overridable", "default": 5001 },
        "credentialSlot": "credential",
        "tls": {
          "enabled": { "type": "boolean", "required": true, "configurationMode": "advanced", "source": { "kind": "default" }, "lifecycle": "pre_execution", "bindingPolicy": "default_overridable", "default": true },
          "verifyPeer": { "type": "boolean", "required": true, "configurationMode": "advanced", "source": { "kind": "default" }, "lifecycle": "pre_execution", "bindingPolicy": "default_overridable", "default": true },
          "serverName": { "type": "string", "required": true, "configurationMode": "runtime", "source": { "kind": "asset", "path": "application.serverName" }, "lifecycle": "pre_execution", "bindingPolicy": "fixed" }
        }
      }
    },
    "credentials": { "credential": { "allowedKinds": ["USERNAME_PASSWORD"], "required": true, "configurationMode": "required", "lifecycle": "pre_execution" } },
    "artifacts": {
      "certificate": {
        "kind": "certificate",
        "required": true,
        "configurationMode": "required",
        "lifecycle": "runtime_injected",
        "artifactContract": {
          "outputs": {
            "leafPem": { "role": "public_certificate", "required": true, "format": "pem", "encoding": "utf8" },
            "privateKeyPem": { "role": "private_key", "required": true, "format": "pem", "encoding": "utf8", "sensitive": true },
            "orderedChainPem": { "role": "certificate_chain", "required": false, "format": "pem", "encoding": "utf8" }
          }
        }
      }
    }
  },
  "steps": [
    {
      "name": "authenticate",
      "type": "http",
      "stage": "prepare",
      "request": {
        "method": "POST",
        "connectionRef": "management",
        "url": "/webapi/auth.cgi",
        "bodyType": "form",
        "form": { "api": "SYNO.API.Auth", "version": 7, "method": "login", "session": "GCAC", "format": "sid", "enable_syno_token": "yes", "client": "browser", "account": "{{credentials.credential.username}}" },
        "formCredentialRefs": { "passwd": "{{credentials.credential}}" },
        "headers": { "Accept": "application/json" },
        "tls": { "verify": "{{connections.management.tls.verifyPeer}}", "sni": "{{connections.management.tls.serverName}}", "allowInsecure": true },
        "timeoutSeconds": 30,
        "maxResponseBytes": 1048576,
        "successStatusCodes": [200]
      },
      "extract": [
        { "name": "sid", "type": "jsonPath", "path": "$.data.sid" },
        { "name": "synotoken", "type": "jsonPath", "path": "$.data.synotoken", "sensitive": true }
      ],
      "assert": [{ "type": "statusCode", "equals": 200 }, { "type": "jsonPath", "path": "$.success", "equals": true }]
    },
    {
      "name": "readCurrentCertificate",
      "type": "http",
      "stage": "prepare",
      "request": {
        "method": "GET",
        "connectionRef": "management",
        "url": "/webapi/entry.cgi?api=SYNO.Core.Certificate.CRT&version=1&method=list&_sid={{steps.authenticate.extracted.sid}}",
        "headers": { "Accept": "application/json", "X-SYNO-TOKEN": "{{steps.authenticate.extracted.synotoken}}" },
        "tls": { "verify": "{{connections.management.tls.verifyPeer}}", "sni": "{{connections.management.tls.serverName}}", "allowInsecure": true },
        "successStatusCodes": [200]
      },
      "extract": [{ "name": "previousCertificate", "type": "outputPath", "path": "$.body" }],
      "assert": [{ "type": "jsonPath", "path": "$.success", "equals": true }]
    },
    {
      "name": "selectCurrentCertificate",
      "type": "transform",
      "stage": "prepare",
      "transform": {
        "engine": "jsonata",
        "input": { "target": "{{variables.target}}", "certificates": "{{steps.readCurrentCertificate.extracted.previousCertificate}}" },
        "outputs": {
          "previousCertificateId": { "expression": "($target := target; $byTarget := $filter(certificates.data.certificates, function($certificate){$count($certificate.services[display_name = $target]) > 0}); $byDefault := $filter(certificates.data.certificates, function($certificate){$count($certificate.services[service = 'default']) > 0}); $candidate := ($count($byTarget) > 0 ? $byTarget : $byDefault)[0]; $candidate.id)" },
          "previousCertificateServices": { "expression": "($target := target; $byTarget := $filter(certificates.data.certificates, function($certificate){$count($certificate.services[display_name = $target]) > 0}); $byDefault := $filter(certificates.data.certificates, function($certificate){$count($certificate.services[service = 'default']) > 0}); $candidate := ($count($byTarget) > 0 ? $byTarget : $byDefault)[0]; $selected := $candidate.services[display_name = $target]; $count($selected) > 0 ? $selected : $candidate.services)" }
        },
        "timeoutMs": 200,
        "maxInputBytes": 1048576,
        "maxOutputBytes": 1048576
      }
    },
    {
      "name": "importCertificateWithChain",
      "type": "http",
      "stage": "install",
      "when": { "variable": "artifacts.certificate.outputs.orderedChainPem", "exists": true },
      "request": {
        "method": "POST",
        "connectionRef": "management",
        "url": "/webapi/entry.cgi?api=SYNO.Core.Certificate&version=1&method=import&_sid={{steps.authenticate.extracted.sid}}",
        "bodyType": "multipart",
        "multipart": {
          "key": { "value": "{{artifacts.certificate.outputs.privateKeyPem}}", "filename": "privkey.pem", "contentType": "application/x-x509-ca-cert" },
          "cert": { "value": "{{artifacts.certificate.outputs.leafPem}}", "filename": "cert.pem", "contentType": "application/x-x509-ca-cert" },
          "inter_cert": { "value": "{{artifacts.certificate.outputs.orderedChainPem}}", "filename": "chain.pem", "contentType": "application/x-x509-ca-cert" },
          "id": { "value": "" },
          "desc": { "value": "{{variables.target}}" },
          "as_default": { "value": "" }
        },
        "headers": { "Accept": "application/json", "X-SYNO-TOKEN": "{{steps.authenticate.extracted.synotoken}}" },
        "tls": { "verify": "{{connections.management.tls.verifyPeer}}", "sni": "{{connections.management.tls.serverName}}", "allowInsecure": true },
        "successStatusCodes": [200],
        "timeoutSeconds": 60
      },
      "extract": [{ "name": "newCertificateId", "type": "jsonPath", "path": "$.data.id" }],
      "assert": [{ "type": "jsonPath", "path": "$.success", "equals": true }]
    },
    {
      "name": "importCertificateWithoutChain",
      "type": "http",
      "stage": "install",
      "when": { "variable": "artifacts.certificate.outputs.orderedChainPem", "exists": false },
      "request": {
        "method": "POST",
        "connectionRef": "management",
        "url": "/webapi/entry.cgi?api=SYNO.Core.Certificate&version=1&method=import&_sid={{steps.authenticate.extracted.sid}}",
        "bodyType": "multipart",
        "multipart": {
          "key": { "value": "{{artifacts.certificate.outputs.privateKeyPem}}", "filename": "privkey.pem", "contentType": "application/x-x509-ca-cert" },
          "cert": { "value": "{{artifacts.certificate.outputs.leafPem}}", "filename": "cert.pem", "contentType": "application/x-x509-ca-cert" },
          "id": { "value": "" },
          "desc": { "value": "{{variables.target}}" },
          "as_default": { "value": "" }
        },
        "headers": { "Accept": "application/json", "X-SYNO-TOKEN": "{{steps.authenticate.extracted.synotoken}}" },
        "tls": { "verify": "{{connections.management.tls.verifyPeer}}", "sni": "{{connections.management.tls.serverName}}", "allowInsecure": true },
        "successStatusCodes": [200],
        "timeoutSeconds": 60
      },
      "extract": [{ "name": "newCertificateId", "type": "jsonPath", "path": "$.data.id" }],
      "assert": [{ "type": "jsonPath", "path": "$.success", "equals": true }]
    },
    {
      "name": "readCertificatesAfterImport",
      "type": "http",
      "stage": "refresh",
      "request": {
        "method": "GET",
        "connectionRef": "management",
        "url": "/webapi/entry.cgi?api=SYNO.Core.Certificate.CRT&version=1&method=list&_sid={{steps.authenticate.extracted.sid}}",
        "headers": { "Accept": "application/json", "X-SYNO-TOKEN": "{{steps.authenticate.extracted.synotoken}}" },
        "tls": { "verify": "{{connections.management.tls.verifyPeer}}", "sni": "{{connections.management.tls.serverName}}", "allowInsecure": true },
        "successStatusCodes": [200]
      },
      "extract": [{ "name": "certificatesAfterImport", "type": "outputPath", "path": "$.body" }],
      "assert": [{ "type": "jsonPath", "path": "$.success", "equals": true }]
    },
    {
      "name": "buildServiceSettingsWithChain",
      "type": "transform",
      "stage": "refresh",
      "when": { "variable": "artifacts.certificate.outputs.orderedChainPem", "exists": true },
      "transform": {
        "engine": "jsonata",
        "input": {
          "services": "{{steps.selectCurrentCertificate.extracted.previousCertificateServices}}",
          "oldId": "{{steps.selectCurrentCertificate.extracted.previousCertificateId}}",
          "newId": "{{steps.importCertificateWithChain.extracted.newCertificateId}}"
        },
        "outputs": {
          "settings": { "expression": "$append([], $map(services, function($service){ {'service':$merge([$service, {'multiple_cert':true,'user_setable':true}]),'old_id':oldId,'id':newId} }))", "format": "jsonString" }
        },
        "timeoutMs": 200,
        "maxInputBytes": 1048576,
        "maxOutputBytes": 1048576
      }
    },
    {
      "name": "bindCertificateToServiceWithChain",
      "type": "http",
      "stage": "refresh",
      "when": { "variable": "artifacts.certificate.outputs.orderedChainPem", "exists": true },
      "request": {
        "method": "POST",
        "connectionRef": "management",
        "url": "/webapi/entry.cgi?_sid={{steps.authenticate.extracted.sid}}",
        "bodyType": "form",
        "form": { "api": "SYNO.Core.Certificate.Service", "version": 1, "method": "set", "settings": "{{steps.buildServiceSettingsWithChain.extracted.settings}}" },
        "headers": { "Accept": "application/json", "X-SYNO-TOKEN": "{{steps.authenticate.extracted.synotoken}}" },
        "tls": { "verify": "{{connections.management.tls.verifyPeer}}", "sni": "{{connections.management.tls.serverName}}", "allowInsecure": true },
        "successStatusCodes": [200],
        "timeoutSeconds": 60
      },
      "assert": [{ "type": "jsonPath", "path": "$.success", "equals": true }]
    },
    {
      "name": "buildServiceSettingsWithoutChain",
      "type": "transform",
      "stage": "refresh",
      "when": { "variable": "artifacts.certificate.outputs.orderedChainPem", "exists": false },
      "transform": {
        "engine": "jsonata",
        "input": {
          "services": "{{steps.selectCurrentCertificate.extracted.previousCertificateServices}}",
          "oldId": "{{steps.selectCurrentCertificate.extracted.previousCertificateId}}",
          "newId": "{{steps.importCertificateWithoutChain.extracted.newCertificateId}}"
        },
        "outputs": {
          "settings": { "expression": "$append([], $map(services, function($service){ {'service':$merge([$service, {'multiple_cert':true,'user_setable':true}]),'old_id':oldId,'id':newId} }))", "format": "jsonString" }
        },
        "timeoutMs": 200,
        "maxInputBytes": 1048576,
        "maxOutputBytes": 1048576
      }
    },
    {
      "name": "bindCertificateToServiceWithoutChain",
      "type": "http",
      "stage": "refresh",
      "when": { "variable": "artifacts.certificate.outputs.orderedChainPem", "exists": false },
      "request": {
        "method": "POST",
        "connectionRef": "management",
        "url": "/webapi/entry.cgi?_sid={{steps.authenticate.extracted.sid}}",
        "bodyType": "form",
        "form": { "api": "SYNO.Core.Certificate.Service", "version": 1, "method": "set", "settings": "{{steps.buildServiceSettingsWithoutChain.extracted.settings}}" },
        "headers": { "Accept": "application/json", "X-SYNO-TOKEN": "{{steps.authenticate.extracted.synotoken}}" },
        "tls": { "verify": "{{connections.management.tls.verifyPeer}}", "sni": "{{connections.management.tls.serverName}}", "allowInsecure": true },
        "successStatusCodes": [200],
        "timeoutSeconds": 60
      },
      "assert": [{ "type": "jsonPath", "path": "$.success", "equals": true }]
    },
    {
      "name": "authenticateForVerification",
      "type": "http",
      "stage": "verify",
      "request": {
        "method": "POST",
        "connectionRef": "management",
        "url": "/webapi/auth.cgi",
        "bodyType": "form",
        "form": { "api": "SYNO.API.Auth", "version": 7, "method": "login", "session": "GCAC-verify", "format": "sid", "enable_syno_token": "yes", "client": "browser", "account": "{{credentials.credential.username}}" },
        "formCredentialRefs": { "passwd": "{{credentials.credential}}" },
        "headers": { "Accept": "application/json" },
        "tls": { "verify": "{{connections.management.tls.verifyPeer}}", "sni": "{{connections.management.tls.serverName}}", "allowInsecure": true },
        "successStatusCodes": [200],
        "timeoutSeconds": 30,
        "maxResponseBytes": 1048576
      },
      "extract": [
        { "name": "sid", "type": "jsonPath", "path": "$.data.sid" },
        { "name": "synotoken", "type": "jsonPath", "path": "$.data.synotoken", "sensitive": true }
      ],
      "assert": [{ "type": "statusCode", "equals": 200 }, { "type": "jsonPath", "path": "$.success", "equals": true }]
    }
  ]
}
