{
  "apiVersion": "gcac.workflow/v1",
  "kind": "CurlSshWorkflow",
  "metadata": { "name": "synology-dsm-discover", "displayName": "Synology DSM discovery", "category": "device", "version": "1.0.18", "platforms": ["appliance"], "updateMethods": ["curl"], "maintainer": "GCAC" },
  "inputContract": {
    "apiVersion": "gcac.deployment-input/v1",
    "variables": {},
    "connections": { "management": { "transport": "http", "host": { "type": "string", "required": true, "configurationMode": "required", "source": { "kind": "binding" }, "lifecycle": "pre_execution", "bindingPolicy": "required_binding" }, "port": { "type": "number", "required": true, "configurationMode": "advanced", "source": { "kind": "default" }, "lifecycle": "pre_execution", "bindingPolicy": "default_overridable", "default": 5001 }, "credentialSlot": "credential", "tls": { "verifyPeer": { "type": "boolean", "required": true, "configurationMode": "advanced", "source": { "kind": "default" }, "lifecycle": "pre_execution", "bindingPolicy": "default_overridable", "default": true }, "serverName": { "type": "string", "required": true, "configurationMode": "runtime", "source": { "kind": "asset", "path": "application.serverName" }, "lifecycle": "pre_execution", "bindingPolicy": "fixed" } } } },
    "credentials": { "credential": { "allowedKinds": ["USERNAME_PASSWORD"], "required": true, "configurationMode": "required", "lifecycle": "pre_execution" } },
    "artifacts": {}
  },
  "steps": [
    { "name": "authenticate", "type": "http", "stage": "prepare", "request": { "method": "POST", "connectionRef": "management", "url": "https://{{connections.management.host}}:{{connections.management.port}}/webapi/auth.cgi", "bodyType": "form", "form": { "api": "SYNO.API.Auth", "version": 7, "method": "login", "session": "GCAC", "format": "sid", "enable_syno_token": "yes", "client": "browser", "account": "{{credentials.credential.username}}" }, "formCredentialRefs": { "passwd": "{{credentials.credential}}" }, "headers": { "Accept": "application/json" }, "tls": { "verify": "{{connections.management.tls.verifyPeer}}", "sni": "{{connections.management.tls.serverName}}", "allowInsecure": false }, "successStatusCodes": [200] }, "extract": [{ "name": "sid", "type": "jsonPath", "path": "$.data.sid" }, { "name": "synotoken", "type": "jsonPath", "path": "$.data.synotoken", "sensitive": true }], "assert": [{ "type": "jsonPath", "path": "$.success", "equals": true }] },
    { "name": "readDsmInfo", "type": "http", "stage": "prepare", "request": { "method": "GET", "connectionRef": "management", "url": "https://{{connections.management.host}}:{{connections.management.port}}/webapi/entry.cgi?api=SYNO.DSM.Info&version=2&method=get&_sid={{steps.authenticate.extracted.sid}}", "headers": { "Accept": "application/json", "X-SYNO-TOKEN": "{{steps.authenticate.extracted.synotoken}}" }, "tls": { "verify": "{{connections.management.tls.verifyPeer}}", "sni": "{{connections.management.tls.serverName}}", "allowInsecure": false }, "successStatusCodes": [200] }, "extract": [{ "name": "info", "type": "outputPath", "path": "$.body" }], "assert": [{ "type": "jsonPath", "path": "$.success", "equals": true }] },
    { "name": "readServices", "type": "http", "stage": "prepare", "request": { "method": "GET", "connectionRef": "management", "url": "https://{{connections.management.host}}:{{connections.management.port}}/webapi/entry.cgi?api=SYNO.Core.Network.Interface&version=1&method=list&_sid={{steps.authenticate.extracted.sid}}", "headers": { "Accept": "application/json", "X-SYNO-TOKEN": "{{steps.authenticate.extracted.synotoken}}" }, "tls": { "verify": "{{connections.management.tls.verifyPeer}}", "sni": "{{connections.management.tls.serverName}}", "allowInsecure": false }, "successStatusCodes": [200] }, "extract": [{ "name": "services", "type": "outputPath", "path": "$.body" }], "assert": [{ "type": "jsonPath", "path": "$.success", "equals": true }] },
    { "name": "readCertificates", "type": "http", "stage": "prepare", "request": { "method": "GET", "connectionRef": "management", "url": "https://{{connections.management.host}}:{{connections.management.port}}/webapi/entry.cgi?api=SYNO.Core.Certificate.CRT&version=1&method=list&_sid={{steps.authenticate.extracted.sid}}", "headers": { "Accept": "application/json", "X-SYNO-TOKEN": "{{steps.authenticate.extracted.synotoken}}" }, "tls": { "verify": "{{connections.management.tls.verifyPeer}}", "sni": "{{connections.management.tls.serverName}}", "allowInsecure": false }, "successStatusCodes": [200] }, "extract": [{ "name": "certificates", "type": "outputPath", "path": "$.body" }], "assert": [{ "type": "jsonPath", "path": "$.success", "equals": true }] },
    { "name": "projectDiscovery", "type": "transform", "stage": "verify", "transform": { "engine": "jsonata", "input": { "address": "{{connections.management.host}}", "info": "{{steps.readDsmInfo.extracted.info}}", "services": "{{steps.readServices.extracted.services}}", "certificates": "{{steps.readCertificates.extracted.certificates}}" }, "outputs": { "discovery": { "expression": "{'apiVersion':'gcac.device-discovery/v2','device':{'stableKey':'synology-dsm:' & address,'displayName':address,'productFamily':'device.synology-dsm','softwareVersion':info.data.version,'managementAddress':address},'capabilities':[{'key':'device.connection.test','available':true},{'key':'device.discover','available':true},{'key':'certificate.deploy','available':true},{'key':'certificate.rollback','available':true}],'frameworks':[{'stableKey':'framework:synology-dsm','frameworkType':'synology.dsm-web','displayName':'DSM Web'}],'sites':[$map(services.data.services,function($s){ {'stableKey':'DSM:' & $s.name,'frameworkStableKey':'framework:synology-dsm','siteType':'device.service','displayName':$s.name,'addresses':[address],'port':$s.port,'protocol':'HTTPS'} })], 'managedTargets':[$map(services.data.services,function($s){ {'stableKey':'TARGET:DSM:' & $s.name,'frameworkStableKey':'framework:synology-dsm','siteStableKey':'DSM:' & $s.name,'targetType':'tls.binding','targetKey':'DSM:' & $s.name,'supportedCapabilities':['certificate.deploy','certificate.verify','certificate.rollback'],'executionLocations':['CONTROL_PLANE','GATEWAY']} })], 'certificates':certificates.data.certificates,'certificateBindings':$reduce(certificates.data.certificates,function($acc,$certificate){$append($acc,$map($filter($append($certificate.services,$map($certificate.serviceNames,function($name){{'display_name':$name}})),function($service){$service.display_name in services.data.services.name}),function($service){{'stableKey':'BINDING:' & $service.display_name & ':' & $string($certificate.id),'managedTargetStableKey':'TARGET:DSM:' & $service.display_name,'certificateStableKey':'CERT:' & $string($certificate.id),'bindingName':$service.display_name,'metadata':{'certificateId':$string($certificate.id)}}}))},[]),'warnings':[]}" } }, "timeoutMs": 1000, "maxInputBytes": 1048576, "maxOutputBytes": 1048576 } }
  ]
}
