{
  "apiVersion": "gcac.workflow/v1",
  "kind": "CurlSshWorkflow",
  "metadata": { "name": "synology-dsm-certificate-rollback", "displayName": "Synology DSM certificate rollback", "category": "certificate", "version": "1.0.3", "platforms": ["appliance"], "updateMethods": ["curl"], "maintainer": "GCAC" },
  "inputContract": {
    "apiVersion": "gcac.deployment-input/v1",
    "variables": { "target": { "type": "string", "required": true, "configurationMode": "runtime", "source": { "kind": "asset", "path": "deployment.target" }, "lifecycle": "pre_execution", "bindingPolicy": "fixed" }, "previousCertificate": { "type": "object", "required": true, "configurationMode": "runtime", "source": { "kind": "snapshot", "path": "deployment.previousCertificate" }, "lifecycle": "pre_execution", "bindingPolicy": "fixed", "sensitive": true } },
    "connections": { "management": { "transport": "http", "host": { "type": "string", "required": true, "configurationMode": "required", "source": { "kind": "binding" }, "lifecycle": "pre_execution", "bindingPolicy": "required_binding" }, "port": { "type": "number", "required": true, "configurationMode": "advanced", "source": { "kind": "default" }, "lifecycle": "pre_execution", "bindingPolicy": "default_overridable", "default": 5001 }, "credentialSlot": "credential", "tls": { "verifyPeer": { "type": "boolean", "required": true, "configurationMode": "advanced", "source": { "kind": "default" }, "lifecycle": "pre_execution", "bindingPolicy": "default_overridable", "default": true } } } },
    "credentials": { "credential": { "allowedKinds": ["USERNAME_PASSWORD"], "required": true, "configurationMode": "required", "lifecycle": "pre_execution" } },
    "artifacts": {}
  },
  "steps": [
    { "name": "restoreCertificate", "type": "http", "stage": "compensate", "request": { "method": "POST", "connectionRef": "management", "url": "https://{{connections.management.host}}:{{connections.management.port}}/webapi/entry.cgi?api=SYNO.Core.Certificate&version=1&method=rollback", "headers": { "Accept": "application/json", "Content-Type": "application/json" }, "body": { "target": "{{variables.target}}", "certificateId": "{{variables.previousCertificate.id}}" }, "tls": { "verify": "{{connections.management.tls.verifyPeer}}", "allowInsecure": false }, "successStatusCodes": [200], "timeoutSeconds": 60 }, "assert": [{ "type": "jsonPath", "path": "$.success", "equals": true }] },
    { "name": "verifyRollback", "type": "http", "stage": "verify", "request": { "method": "GET", "connectionRef": "management", "url": "https://{{connections.management.host}}:{{connections.management.port}}/webapi/entry.cgi?api=SYNO.Core.Certificate&version=1&method=list", "headers": { "Accept": "application/json" }, "tls": { "verify": "{{connections.management.tls.verifyPeer}}", "allowInsecure": false }, "successStatusCodes": [200] }, "assert": [{ "type": "jsonPath", "path": "$.success", "equals": true }] }
  ]
}
