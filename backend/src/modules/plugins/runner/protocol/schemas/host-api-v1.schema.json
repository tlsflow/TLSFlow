{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "gcac://plugin-runner/host-api/v2",
  "title": "GCAC Plugin Runner Action Host API v2",
  "type": "object",
  "required": ["method", "request", "result", "error"],
  "properties": {
    "method": { "type": "string", "pattern": "^[a-z][A-Za-z0-9]*(?:\\.[A-Za-z0-9_-]+)+$" },
    "request": { "$ref": "#/$defs/requestEnvelope" },
    "result": { "$ref": "#/$defs/resultEnvelope" },
    "error": { "$ref": "#/$defs/error" }
  },
  "additionalProperties": false,
  "$defs": {
    "id": { "type": "string", "pattern": "^[A-Za-z0-9._:-]{1,256}$" },
    "record": { "type": "object", "additionalProperties": true, "maxProperties": 200 },
    "requestEnvelope": { "type": "object", "additionalProperties": false, "required": ["input", "grantRefs"], "properties": { "input": { "$ref": "#/$defs/record" }, "grantRefs": { "type": "array", "items": { "$ref": "#/$defs/id" }, "maxItems": 100 } } },
    "resultEnvelope": { "type": "object", "additionalProperties": false, "required": ["ok"], "properties": { "ok": { "type": "boolean" }, "data": { "$ref": "#/$defs/record" }, "error": { "$ref": "#/$defs/error" } } },
    "error": { "type": "object", "additionalProperties": false, "required": ["code", "message", "retryable", "mayBeUnknown", "secretRedacted"], "properties": { "code": { "type": "string", "minLength": 1, "maxLength": 128 }, "message": { "type": "string", "minLength": 1, "maxLength": 512 }, "retryable": { "type": "boolean" }, "mayBeUnknown": { "type": "boolean" }, "details": { "$ref": "#/$defs/record" }, "secretRedacted": { "const": true } } },
    "methodCatalog": { "type": "object", "additionalProperties": false, "properties": {
      "cloudService.get": { "$ref": "#/$defs/record" },
      "artifact.grant.read": { "$ref": "#/$defs/record" },
      "secret.grant.resolve": { "$ref": "#/$defs/record" },
      "crypto.sign": { "$ref": "#/$defs/record" },
      "http.request": { "$ref": "#/$defs/record" },
      "execution.isCancelled": { "$ref": "#/$defs/record" },
      "audit.append": { "$ref": "#/$defs/record" }
    } }
  }
}
