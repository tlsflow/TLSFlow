{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "gcac://plugin-runner/ipc/v2",
  "title": "GCAC Plugin Runner Action IPC v2",
  "oneOf": [
    { "$ref": "#/$defs/hello" },
    { "$ref": "#/$defs/hello_result" },
    { "$ref": "#/$defs/execute" },
    { "$ref": "#/$defs/execute_result" },
    { "$ref": "#/$defs/host_call" },
    { "$ref": "#/$defs/host_result" },
    { "$ref": "#/$defs/cancel" },
    { "$ref": "#/$defs/cancel_result" },
    { "$ref": "#/$defs/ping" },
    { "$ref": "#/$defs/pong" },
    { "$ref": "#/$defs/shutdown" },
    { "$ref": "#/$defs/shutdown_result" }
  ],
  "$defs": {
    "id": { "type": "string", "pattern": "^[A-Za-z0-9._:-]{1,256}$" },
    "requestId": { "type": "string", "pattern": "^[A-Za-z0-9._:-]{1,128}$" },
    "dateTime": { "type": "string", "format": "date-time", "maxLength": 64 },
    "hash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "record": { "type": "object", "additionalProperties": true, "maxProperties": 200 },
    "stringArray": { "type": "array", "items": { "$ref": "#/$defs/id" }, "maxItems": 200 },
    "grantRefs": { "type": "array", "items": { "$ref": "#/$defs/id" }, "maxItems": 100 },
    "hostGrantRefs": { "type": "array", "items": { "$ref": "#/$defs/id" }, "minItems": 1, "maxItems": 100 },
    "error": { "type": "object", "additionalProperties": false, "required": ["code", "message", "retryable", "mayBeUnknown", "secretRedacted"], "properties": { "code": { "type": "string", "minLength": 1, "maxLength": 128 }, "message": { "type": "string", "minLength": 1, "maxLength": 512 }, "retryable": { "type": "boolean" }, "mayBeUnknown": { "type": "boolean" }, "details": { "$ref": "#/$defs/record" }, "secretRedacted": { "const": true } } },
    "warning": { "type": "object", "additionalProperties": false, "required": ["code", "message", "secretRedacted"], "properties": { "code": { "type": "string", "minLength": 1, "maxLength": 128 }, "message": { "type": "string", "minLength": 1, "maxLength": 512 }, "details": { "$ref": "#/$defs/record" }, "secretRedacted": { "const": true } } },
    "runner": { "type": "object", "additionalProperties": false, "required": ["pid", "sdkVersion", "runnerVersion"], "properties": { "pid": { "type": "integer", "minimum": 1 }, "sdkVersion": { "$ref": "#/$defs/id" }, "runnerVersion": { "$ref": "#/$defs/id" } } },
    "base": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocolVersion", "messageType", "requestId", "sentAt"],
      "properties": {
        "protocolVersion": { "const": "gcac.plugin-runner/v2" }, "messageType": { "$ref": "#/$defs/id" }, "requestId": { "$ref": "#/$defs/requestId" }, "sentAt": { "$ref": "#/$defs/dateTime" },
        "pluginVersionId": { "$ref": "#/$defs/id" }, "tenantId": { "$ref": "#/$defs/id" }, "executionId": { "$ref": "#/$defs/id" }, "executionStepId": { "$ref": "#/$defs/id" },
        "pluginId": { "$ref": "#/$defs/id" }, "pluginVersion": { "$ref": "#/$defs/id" }, "runnerVersion": { "$ref": "#/$defs/id" }, "sdkVersion": { "$ref": "#/$defs/id" }, "workflowVersionId": { "$ref": "#/$defs/id" }, "capability": { "$ref": "#/$defs/id" }, "actionId": { "$ref": "#/$defs/id" }, "actionContractVersion": { "$ref": "#/$defs/id" },
        "inputSchemaSha256": { "$ref": "#/$defs/hash" }, "outputSchemaSha256": { "$ref": "#/$defs/hash" }, "packageHash": { "$ref": "#/$defs/hash" }, "manifestHash": { "$ref": "#/$defs/hash" }, "resourceHash": { "$ref": "#/$defs/hash" }, "planDigest": { "$ref": "#/$defs/digest" }, "writeEffect": { "type": "boolean" },
        "runner": { "$ref": "#/$defs/runner" }, "capabilities": { "$ref": "#/$defs/stringArray" }, "permissions": { "$ref": "#/$defs/stringArray" }, "accepted": { "type": "boolean" }, "error": { "$ref": "#/$defs/error" },
        "grantRefs": { "$ref": "#/$defs/grantRefs" }, "idempotencyKey": { "$ref": "#/$defs/id" }, "input": { "$ref": "#/$defs/record" }, "deadlineAt": { "$ref": "#/$defs/dateTime" }, "method": { "type": "string", "enum": ["cloudService.get", "artifact.grant.read", "secret.grant.resolve", "crypto.sign", "crypto.hmac", "http.request", "execution.isCancelled", "audit.append"] }, "timeoutMs": { "type": "integer", "minimum": 1, "maximum": 120000 },
        "success": { "type": "boolean" }, "status": { "enum": ["SUCCESS", "FAILED", "UNKNOWN", "CANCELLED", "ACCEPTED", "ALREADY_COMPLETED", "DRAINING", "SHUTDOWN"] }, "output": { "$ref": "#/$defs/record" }, "externalReceipt": { "$ref": "#/$defs/record" }, "warnings": { "type": "array", "items": { "$ref": "#/$defs/warning" }, "maxItems": 100 }, "ok": { "type": "boolean" },
        "targetRequestId": { "$ref": "#/$defs/id" }, "reason": { "type": "string", "minLength": 1, "maxLength": 512 }, "nonce": { "$ref": "#/$defs/id" }, "graceMs": { "type": "integer", "minimum": 0, "maximum": 120000 }
      }
    },
    "hello": { "allOf": [{ "$ref": "#/$defs/base" }, { "type": "object", "required": ["pluginVersionId", "pluginId", "pluginVersion", "runner", "capabilities", "permissions", "packageHash", "resourceHash", "manifestHash"], "properties": { "messageType": { "const": "hello" } } }] },
    "hello_result": { "allOf": [{ "$ref": "#/$defs/base" }, { "type": "object", "required": ["pluginVersionId", "accepted", "pluginId", "pluginVersion", "runnerVersion", "sdkVersion", "capabilities", "permissions", "packageHash", "resourceHash", "manifestHash"], "properties": { "messageType": { "const": "hello_result" } } }] },
    "execute": { "allOf": [{ "$ref": "#/$defs/base" }, { "type": "object", "required": ["pluginVersionId", "tenantId", "executionId", "executionStepId", "workflowVersionId", "pluginId", "capability", "actionId", "actionContractVersion", "inputSchemaSha256", "outputSchemaSha256", "packageHash", "manifestHash", "resourceHash", "planDigest", "writeEffect", "grantRefs", "idempotencyKey", "input", "deadlineAt"], "properties": { "messageType": { "const": "execute" } } }] },
    "execute_result": { "allOf": [{ "$ref": "#/$defs/base" }, { "type": "object", "required": ["pluginVersionId", "tenantId", "executionId", "executionStepId", "workflowVersionId", "pluginId", "capability", "actionId", "actionContractVersion", "inputSchemaSha256", "outputSchemaSha256", "packageHash", "manifestHash", "resourceHash", "planDigest", "writeEffect", "success", "status", "output", "warnings"], "properties": { "messageType": { "const": "execute_result" } } }] },
    "host_call": { "allOf": [{ "$ref": "#/$defs/base" }, { "type": "object", "required": ["pluginVersionId", "tenantId", "executionId", "executionStepId", "workflowVersionId", "pluginId", "capability", "actionId", "actionContractVersion", "inputSchemaSha256", "outputSchemaSha256", "packageHash", "manifestHash", "resourceHash", "planDigest", "writeEffect", "method", "input", "grantRefs", "idempotencyKey", "deadlineAt", "timeoutMs"], "properties": { "messageType": { "const": "host_call" }, "grantRefs": { "$ref": "#/$defs/hostGrantRefs" } } }] },
    "host_result": { "allOf": [{ "$ref": "#/$defs/base" }, { "type": "object", "required": ["pluginVersionId", "tenantId", "executionId", "executionStepId", "workflowVersionId", "pluginId", "capability", "actionId", "actionContractVersion", "inputSchemaSha256", "outputSchemaSha256", "packageHash", "manifestHash", "resourceHash", "planDigest", "writeEffect", "ok"], "properties": { "messageType": { "const": "host_result" } } }] },
    "cancel": { "allOf": [{ "$ref": "#/$defs/base" }, { "type": "object", "required": ["pluginVersionId", "tenantId", "executionId", "executionStepId", "targetRequestId", "reason"], "properties": { "messageType": { "const": "cancel" } } }] },
    "cancel_result": { "allOf": [{ "$ref": "#/$defs/base" }, { "type": "object", "required": ["pluginVersionId", "tenantId", "executionId", "executionStepId", "targetRequestId", "accepted", "status"], "properties": { "messageType": { "const": "cancel_result" } } }] },
    "ping": { "allOf": [{ "$ref": "#/$defs/base" }, { "type": "object", "required": ["pluginVersionId", "nonce"], "properties": { "messageType": { "const": "ping" } } }] },
    "pong": { "allOf": [{ "$ref": "#/$defs/base" }, { "type": "object", "required": ["pluginVersionId", "nonce"], "properties": { "messageType": { "const": "pong" } } }] },
    "shutdown": { "allOf": [{ "$ref": "#/$defs/base" }, { "type": "object", "required": ["pluginVersionId", "reason", "graceMs"], "properties": { "messageType": { "const": "shutdown" } } }] },
    "shutdown_result": { "allOf": [{ "$ref": "#/$defs/base" }, { "type": "object", "required": ["pluginVersionId", "accepted", "status"], "properties": { "messageType": { "const": "shutdown_result" } } }] }
  }
}
