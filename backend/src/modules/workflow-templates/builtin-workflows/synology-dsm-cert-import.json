{
  "apiVersion": "gcac.workflow/v1",
  "kind": "CurlSshWorkflow",
  "metadata": {
    "name": "synology-dsm-cert-import",
    "displayName": "更新Synology DSM 证书",
    "description": "通过 Synology DSM WebAPI 导入证书并迁移现有服务绑定。",
    "version": "1.1.1",
    "logoUrl": "/plugin-logos/synology.svg",
    "platforms": ["synology-dsm"],
    "updateMethods": ["curl"],
    "maintainer": "GCAC",
    "category": "certificate",
    "tags": [
      "synology",
      "dsm",
      "certificate",
      "curl"
    ]
  },
  "variables": {
    "frameworkType": {
      "type": "enum",
      "configurationMode": "required",
      "required": true,
      "default": "CUSTOM",
      "source": { "kind": "asset_ssl", "path": "target.frameworkType" },
      "lifecycle": "pre_execution",
      "bindingPolicy": "fixed",
      "enum": [
        "NGINX",
        "APACHE",
        "TOMCAT",
        "IIS",
        "CUSTOM"
      ],
      "description": "应用资产框架类型，Synology DSM API 证书导入按自定义设备处理。"
    },
    "siteName": {
      "type": "string",
      "configurationMode": "required",
      "required": true,
      "default": "Synology DSM",
      "source": { "kind": "asset_ssl", "path": "target.siteName" },
      "lifecycle": "pre_execution",
      "bindingPolicy": "fixed",
      "description": "应用资产站点显示名称。"
    },
    "bindingInformation": {
      "type": "string",
      "configurationMode": "advanced",
      "required": false,
      "default": "*:5001:nas.example.com",
      "source": { "kind": "asset_ssl", "path": "target.bindingInformation" },
      "lifecycle": "pre_execution",
      "bindingPolicy": "fixed",
      "description": "DSM HTTPS 入口绑定信息。"
    },
    "hostHeader": {
      "type": "string",
      "configurationMode": "advanced",
      "required": false,
      "default": "nas.example.com",
      "source": { "kind": "asset_ssl", "path": "target.hostHeader" },
      "lifecycle": "pre_execution",
      "bindingPolicy": "fixed",
      "description": "验证请求使用的 Host 头。"
    },
    "port": {
      "type": "number",
      "configurationMode": "required",
      "required": true,
      "default": 5001,
      "source": { "kind": "asset_ssl", "path": "target.port" },
      "lifecycle": "pre_execution",
      "bindingPolicy": "fixed",
      "description": "DSM HTTPS 管理端口。"
    },
    "protocol": {
      "type": "enum",
      "configurationMode": "required",
      "required": true,
      "default": "HTTPS",
      "source": { "kind": "asset_ssl", "path": "target.protocol" },
      "lifecycle": "pre_execution",
      "bindingPolicy": "fixed",
      "enum": [
        "HTTP",
        "HTTPS",
        "TLS",
        "CUSTOM"
      ],
      "description": "应用资产访问协议。"
    },
    "verifyUrl": {
      "type": "string",
      "configurationMode": "required",
      "required": true,
      "default": "https://nas.example.com:5001/",
      "source": { "kind": "asset_ssl", "path": "target.verifyUrl" },
      "lifecycle": "pre_execution",
      "bindingPolicy": "fixed",
      "description": "证书导入后用于验证 DSM HTTPS 入口的 URL。"
    },
    "sniName": {
      "type": "string",
      "configurationMode": "advanced",
      "required": false,
      "default": "nas.example.com",
      "source": { "kind": "asset_ssl", "path": "target.sniName" },
      "lifecycle": "pre_execution",
      "bindingPolicy": "fixed",
      "description": "TLS SNI 名称。"
    },
    "deviceBaseUrl": {
      "type": "string",
      "configurationMode": "advanced",
      "required": true,
      "default": "https://nas.example.com:5001",
      "source": { "kind": "derived", "resolver": "endpoint_url" },
      "lifecycle": "pre_execution",
      "bindingPolicy": "fixed",
      "description": "DSM WebAPI 基础地址，不包含末尾斜杠。"
    },
    "synologyCredential": {
      "type": "credential",
      "configurationMode": "required",
      "required": true,
      "sensitive": true,
      "source": { "kind": "credential", "slot": "synologyCredential" },
      "lifecycle": "pre_execution",
      "bindingPolicy": "required_binding",
      "description": "DSM 登录凭据，使用 username_password 类型，账号写在凭据 username 中，密码只通过 SecretRef 注入登录表单。"
    },
    "previousCertificateId": {
      "type": "string",
      "configurationMode": "runtime",
      "required": false,
      "default": "",
      "source": { "kind": "step_output", "step": "build_previous_synology_certificate_context", "output": "previousCertificateId" },
      "lifecycle": "step_output",
      "bindingPolicy": "fixed",
      "description": "迁移前承载服务绑定的旧证书 ID，由上传前证书列表实时解析生成，用作回滚目标。"
    },
    "newCertificateId": {
      "type": "string",
      "configurationMode": "runtime",
      "required": false,
      "default": "",
      "source": { "kind": "step_output", "step": "build_synology_service_bindings", "output": "newCertificateId" },
      "lifecycle": "step_output",
      "bindingPolicy": "fixed",
      "description": "新增证书导入成功后从 SYNO.Core.Certificate.CRT list 解析出的新证书 ID。创建应用资产时未知，不能作为必填输入；仅用于记录或回滚辅助。"
    },
    "certificateDescription": {
      "type": "string",
      "configurationMode": "advanced",
      "required": false,
      "default": "GCAC active certificate",
      "source": { "kind": "dsl", "value": "GCAC active certificate" },
      "lifecycle": "pre_execution",
      "bindingPolicy": "default_overridable",
      "description": "新增证书描述，用于 DSM 列表中区分当前目标证书。"
    },
    "serviceBindingsJson": {
      "type": "string",
      "configurationMode": "runtime",
      "required": false,
      "default": "",
      "source": { "kind": "step_output", "step": "build_synology_service_bindings", "output": "serviceBindingsJson" },
      "lifecycle": "step_output",
      "bindingPolicy": "fixed",
      "description": "SYNO.Core.Certificate.Service set 的 settings JSON 字符串。运行时应由证书列表实时转换生成，创建应用资产时不能手工必填。"
    },
    "serverCert": {
      "type": "certificate",
      "configurationMode": "runtime",
      "required": true,
      "sensitive": true,
      "source": { "kind": "certificate" },
      "lifecycle": "runtime_injected",
      "bindingPolicy": "fixed",
      "description": "要新增到 Synology DSM 的证书产物。",
      "artifactContract": {
        "outputs": {
          "certFile": {
            "role": "public_certificate",
            "required": true,
            "format": "pem",
            "encoding": "utf8",
            "description": "提交给 DSM cert 字段的 fullchain PEM 内容。"
          },
          "keyFile": {
            "role": "private_key",
            "required": true,
            "format": "pem",
            "encoding": "utf8",
            "description": "提交给 DSM key 字段的私钥 PEM 内容。"
          },
          "chainFile": {
            "role": "certificate_chain",
            "required": false,
            "format": "pem",
            "encoding": "utf8",
            "description": "提交给 DSM inter_cert 字段的证书链 PEM 内容。"
          }
        }
      }
    }
  },
  "steps": [
    {
      "name": "prepare_synology_login",
      "type": "http",
      "stage": "prepare",
      "request": {
        "method": "POST",
        "url": "{{deviceBaseUrl}}/webapi/entry.cgi",
        "bodyType": "form",
        "form": {
          "api": "SYNO.API.Auth",
          "version": 7,
          "method": "login",
          "account": "{{synologyCredential.username}}",
          "session": "webui",
          "format": "sid",
          "enable_syno_token": "yes"
        },
        "formCredentialRefs": {
          "passwd": "{{synologyCredential}}"
        },
        "timeoutSeconds": 30,
        "maxResponseBytes": 1048576,
        "successStatusCodes": [
          200
        ],
        "failOnNon2xx": true
      },
      "extract": [
        {
          "name": "synologySid",
          "type": "jsonPath",
          "path": "$.data.sid",
          "sensitive": true
        },
        {
          "name": "synoToken",
          "type": "jsonPath",
          "path": "$.data.synotoken",
          "sensitive": true
        }
      ],
      "assert": [
        {
          "type": "statusCode",
          "equals": 200
        },
        {
          "type": "contains",
          "value": "\"success\":true"
        }
      ]
    },
    {
      "name": "list_synology_certificates_before_import",
      "type": "http",
      "stage": "backup",
      "request": {
        "method": "GET",
        "url": "{{deviceBaseUrl}}/webapi/entry.cgi",
        "query": {
          "api": "SYNO.Core.Certificate.CRT",
          "method": "list",
          "version": 1,
          "SynoToken": "{{synoToken}}",
          "_sid": "{{synologySid}}"
        },
        "headers": {
          "X-SYNO-TOKEN": "{{synoToken}}"
        },
        "timeoutSeconds": 30,
        "maxResponseBytes": 1048576,
        "successStatusCodes": [
          200
        ],
        "failOnNon2xx": true
      },
      "extract": [
        {
          "name": "synologyCertificatesBeforeImport",
          "type": "firstOf",
          "paths": [
            "$.body.data.certificates",
            "$.body.certificates",
            "$.body.data.items",
            "$.body.items",
            "$.body.data"
          ]
        }
      ],
      "assert": [
        {
          "type": "statusCode",
          "equals": 200
        },
        {
          "type": "contains",
          "value": "\"success\":true"
        }
      ]
    },
    {
      "name": "build_previous_synology_certificate_context",
      "type": "transform",
      "stage": "backup",
      "transform": {
        "engine": "jsonata",
        "input": {
          "certificates": "{{synologyCertificatesBeforeImport}}"
        },
        "outputs": {
          "previousCertificateId": {
            "expression": "$filter(certificates, function($c){$c.is_default = true})[0].id"
          },
          "previousCertificateServices": {
            "expression": "$filter(certificates, function($c){$c.is_default = true})[0].services"
          }
        },
        "timeoutMs": 1000,
        "maxInputBytes": 1048576,
        "maxOutputBytes": 1048576
      }
    },
    {
      "name": "install_synology_certificate_as_new_default",
      "type": "http",
      "stage": "install",
      "request": {
        "method": "POST",
        "url": "{{deviceBaseUrl}}/webapi/entry.cgi",
        "query": {
          "api": "SYNO.Core.Certificate",
          "method": "import",
          "version": 1,
          "SynoToken": "{{synoToken}}",
          "_sid": "{{synologySid}}"
        },
        "headers": {
          "X-SYNO-TOKEN": "{{synoToken}}"
        },
        "bodyType": "multipart",
        "multipart": {
          "key": {
            "filename": "privkey.pem",
            "contentType": "application/octet-stream",
            "value": "{{serverCert.outputs.keyFile.content}}"
          },
          "cert": {
            "filename": "fullchain.pem",
            "contentType": "application/octet-stream",
            "value": "{{serverCert.outputs.certFile.content}}"
          },
          "inter_cert": {
            "filename": "chain.pem",
            "contentType": "application/octet-stream",
            "value": "{{serverCert.outputs.chainFile.content}}"
          },
          "id": {
            "value": ""
          },
          "desc": {
            "value": "{{certificateDescription}}"
          },
          "as_default": {
            "value": "true"
          }
        },
        "timeoutSeconds": 60,
        "maxResponseBytes": 1048576,
        "successStatusCodes": [
          200
        ],
        "failOnNon2xx": true
      },
      "extract": [
        {
          "name": "synologyImportSuccess",
          "type": "regex",
          "pattern": "\"success\"\\s*:\\s*(true|false)",
          "optional": true
        }
      ],
      "assert": [
        {
          "type": "statusCode",
          "equals": 200
        },
        {
          "type": "contains",
          "value": "\"success\":true"
        }
      ]
    },
    {
      "name": "list_synology_certificates_after_import",
      "type": "http",
      "stage": "refresh",
      "request": {
        "method": "GET",
        "url": "{{deviceBaseUrl}}/webapi/entry.cgi",
        "query": {
          "api": "SYNO.Core.Certificate.CRT",
          "method": "list",
          "version": 1,
          "SynoToken": "{{synoToken}}",
          "_sid": "{{synologySid}}"
        },
        "headers": {
          "X-SYNO-TOKEN": "{{synoToken}}"
        },
        "timeoutSeconds": 30,
        "maxResponseBytes": 1048576,
        "successStatusCodes": [
          200
        ],
        "failOnNon2xx": true
      },
      "extract": [
        {
          "name": "synologyCertificatesAfterImport",
          "type": "firstOf",
          "paths": [
            "$.body.data.certificates",
            "$.body.certificates",
            "$.body.data.items",
            "$.body.items",
            "$.body.data"
          ]
        }
      ],
      "assert": [
        {
          "type": "statusCode",
          "equals": 200
        },
        {
          "type": "contains",
          "value": "\"success\":true"
        }
      ]
    },
    {
      "name": "build_synology_service_bindings",
      "type": "transform",
      "stage": "refresh",
      "transform": {
        "engine": "jsonata",
        "input": {
          "certificateDescription": "{{certificateDescription}}",
          "certificates": "{{synologyCertificatesAfterImport}}",
          "previousCertificateId": "{{previousCertificateId}}",
          "previousCertificateServices": "{{previousCertificateServices}}"
        },
        "outputs": {
          "newCertificateId": {
            "expression": "$filter(certificates, function($c){$c.desc = certificateDescription})[0].id"
          },
          "serviceBindingsJson": {
            "expression": "[$map(previousCertificateServices, function($service){{\"service\":$service,\"old_id\":previousCertificateId,\"id\":newCertificateId}})]",
            "format": "jsonString"
          }
        },
        "timeoutMs": 1000,
        "maxInputBytes": 1048576,
        "maxOutputBytes": 1048576
      }
    },
    {
      "name": "apply_synology_service_bindings",
      "type": "http",
      "stage": "refresh",
      "request": {
        "method": "POST",
        "url": "{{deviceBaseUrl}}/webapi/entry.cgi",
        "query": {
          "api": "SYNO.Core.Certificate.Service",
          "method": "set",
          "version": 1,
          "SynoToken": "{{synoToken}}",
          "_sid": "{{synologySid}}"
        },
        "headers": {
          "Content-Type": "application/x-www-form-urlencoded; charset=UTF-8",
          "X-SYNO-TOKEN": "{{synoToken}}"
        },
        "bodyType": "form",
        "form": {
          "api": "SYNO.Core.Certificate.Service",
          "version": 1,
          "method": "set",
          "settings": "{{serviceBindingsJson}}",
          "_sid": "{{synologySid}}",
          "SynoToken": "{{synoToken}}"
        },
        "timeoutSeconds": 60,
        "maxResponseBytes": 1048576,
        "successStatusCodes": [
          200
        ],
        "failOnNon2xx": true
      },
      "assert": [
        {
          "type": "statusCode",
          "equals": 200
        },
        {
          "type": "contains",
          "value": "\"success\":true"
        }
      ]
    },
    {
      "name": "wait_dsm_certificate_apply",
      "type": "wait",
      "stage": "refresh",
      "seconds": 15
    },
    {
      "name": "logout_synology_session",
      "type": "http",
      "stage": "refresh",
      "request": {
        "method": "POST",
        "url": "{{deviceBaseUrl}}/webapi/entry.cgi",
        "query": {
          "api": "SYNO.API.Auth",
          "method": "logout",
          "version": 6,
          "SynoToken": "{{synoToken}}",
          "_sid": "{{synologySid}}"
        },
        "bodyType": "none",
        "timeoutSeconds": 30,
        "successStatusCodes": [
          200
        ],
        "failOnNon2xx": true
      },
      "assert": [
        {
          "type": "statusCode",
          "equals": 200
        }
      ]
    },
    {
      "name": "verify_synology_https",
      "type": "http",
      "stage": "verify",
      "request": {
        "method": "GET",
        "url": "{{verifyUrl}}",
        "headers": {
          "Host": "{{hostHeader}}"
        },
        "timeoutSeconds": 30,
        "successStatusCodes": [
          200
        ],
        "failOnNon2xx": true
      },
      "assert": [
        {
          "type": "statusCode",
          "equals": 200
        }
      ]
    }
  ],
  "rollback": [
    {
      "name": "rollback_synology_service_bindings_to_previous_certificate",
      "type": "manual",
      "stage": "verify",
      "instruction": "回滚时请把 serviceBindingsJson 中每项 id 改为 previousCertificateId、old_id 改为 newCertificateId 后重新执行服务绑定迁移；旧证书必须保留在 DSM 中。"
    }
  ]
}
