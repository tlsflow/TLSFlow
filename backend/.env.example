GCAC_DEPLOYMENT_ARCHITECTURE=standard
GCAC_PERSISTENCE_BACKEND=postgres
GCAC_DATABASE_HOST=127.0.0.1
GCAC_DATABASE_PORT=5432
GCAC_DATABASE_USER=gcac
GCAC_DATABASE_PASSWORD=change-me
GCAC_DATABASE_NAME=gcac
GCAC_PUBLIC_BASE_URL=http://127.0.0.1:5172
GCAC_APPROVAL_ALLOW_SELF_APPROVAL=true
GCAC_TOKEN_SECRET=change-me
GCAC_INITIAL_ADMIN_PASSWORD=change-me
GCAC_SECRET_KEK=change-me
GCAC_LICENSE_STORAGE_KEY=change-me
# 许可证导入需要与签发器匹配的 Ed25519 公钥；生产环境必须使用非开发 keyId。
# GCAC_LICENSE_TRUST_KEYS_JSON={"release-2026-08":"<base64url-ed25519-public-key>"}
GCAC_CA_CONFIRMATION_SECRET=change-me

# Browser Runtime 仅 standard 架构启用。Backend 只通过 HTTP API 访问专用 Runtime 容器，
# 不挂载 Docker Socket，也不在 Backend 内执行 Docker CLI。
BROWSER_RUNTIME_URL=http://127.0.0.1:8787
BROWSER_RUNTIME_SHARED_SECRET=change-me
