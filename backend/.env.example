# GCAC Backend 环境变量模板 / GCAC Backend environment template
# 复制为 backend/.env / Copy to backend/.env

# 必填配置 / Required configuration
GCAC_PERSISTENCE_BACKEND=postgres
GCAC_DATABASE_HOST=127.0.0.1
GCAC_DATABASE_PORT=5432
GCAC_DATABASE_USER=gcac
GCAC_DATABASE_PASSWORD=TLSFlow-DB-7Qm2-Vp9x-2026
GCAC_DATABASE_NAME=gcac
GCAC_PUBLIC_BASE_URL=http://127.0.0.1:5172
GCAC_TOKEN_SECRET=TLSFlow-Token-K4r8-Np2z-2026
GCAC_SECRET_KEK=TLSFlow-KEK-H7s3-Lx6v-2026

# 可选配置 / Optional configuration
# 默认禁止自审批 / Self-approval is disabled by default
GCAC_APPROVAL_ALLOW_SELF_APPROVAL=false

# 启用 CA 高风险操作时填写 / Required for high-risk CA operations
# GCAC_CA_CONFIRMATION_SECRET=TLSFlow-CA-R2n8-Ym5q-2026

# 调试时使用 Browser Runtime / Browser Runtime for local debugging
# BROWSER_RUNTIME_URL=http://127.0.0.1:8787
