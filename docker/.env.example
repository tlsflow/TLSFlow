# GCAC Docker Compose 环境变量模板
#
# 本文件只提供变量名和占位符，不包含真实密钥。请复制到仓库外的受控文件，
# 例如 /Users/you/.config/gcac/docker.env，再通过 docker compose --env-file 使用。
# GCAC_RELEASE_VERSION 不在此维护；Compose 镜像标签必须从根目录 version 文件读取。

# 构建与对外端口
VITE_PRODUCT_EDITION=public
GCAC_PORT=8085
GCAC_BACKEND_PORT=3003

# 标准版 PostgreSQL
POSTGRES_DB=gcac
POSTGRES_USER=gcac
POSTGRES_PASSWORD=CHANGE_ME

# GCAC 必填密钥（请使用密码管理器或 CI Secret 注入）
GCAC_TOKEN_SECRET=CHANGE_ME
GCAC_INITIAL_ADMIN_PASSWORD=CHANGE_ME
GCAC_SECRET_KEK=CHANGE_ME
GCAC_CA_CONFIRMATION_SECRET=CHANGE_ME

# 生产 Plugin Runner 固定启动材料
GCAC_PLUGIN_RUNNER_EXECUTOR_MODULE_PATH=/app/dist/modules/plugins/runner/runner-server.js
GCAC_PLUGIN_RUNNER_VERSION=gcac-plugin-runner-v1
GCAC_PLUGIN_SDK_VERSION=gcac-plugin-sdk-v1

# Policy Authority 生产信任根和签名材料
GCAC_POLICY_AUTHORITY_ROOT_KEY_ID=REPLACE_WITH_PRODUCTION_ROOT_KEY_ID
GCAC_POLICY_AUTHORITY_ID=REPLACE_WITH_PRODUCTION_AUTHORITY_ID
GCAC_POLICY_AUTHORITY_ROOT_PUBLIC_KEY_PEM=REPLACE_WITH_ED25519_PUBLIC_KEY_PEM
GCAC_POLICY_AUTHORITY_ROOT_FINGERPRINT_SHA256=REPLACE_WITH_64_CHAR_SHA256
GCAC_POLICY_AUTHORITY_BOOTSTRAP_JSON={}
GCAC_POLICY_AUTHORITY_KEYSET_JSON={}
GCAC_POLICY_AUTHORITY_SIGNING_KEYS_JSON={}
GCAC_POLICY_AUTHORITY_POLICY_BUNDLE_JSON={}
GCAC_POLICY_AUTHORITY_STATE_FILE=/var/lib/gcac/policy-authority-state.json

# Agent 本地策略验证材料
GCAC_AGENT_LOCAL_POLICY_ROOT_KEY_ID=REPLACE_WITH_AGENT_POLICY_ROOT_KEY_ID
GCAC_AGENT_LOCAL_POLICY_ROOT_PUBLIC_KEY_PEM=REPLACE_WITH_ED25519_PUBLIC_KEY_PEM
GCAC_AGENT_LOCAL_POLICY_ROOT_FINGERPRINT_SHA256=REPLACE_WITH_64_CHAR_SHA256
GCAC_AGENT_LOCAL_POLICY_BUNDLE_JSON={}

# 标准版 Browser Runtime
BROWSER_RUNTIME_SHARED_SECRET=CHANGE_ME
BROWSER_RUNTIME_PUBLIC_BASE_URL=
BROWSER_RUNTIME_MAX_SESSIONS=4
