# TLSFlow user Docker Compose environment template
#
# Copy to docker/.env and edit the values.
# This file must not contain real secrets.

# Image tag; pin a release version in production
GCAC_RELEASE_VERSION=latest

# Public Web port, default: 8085
GCAC_PORT=8085

# Public control-plane URL reachable by Agents
GCAC_PUBLIC_BASE_URL=http://your-tlsflow-host:8085

# Host persistence root, located beside docker-compose.yml
GCAC_DATA_ROOT=./data

# PostgreSQL database name, default: gcac
POSTGRES_DB=gcac

# PostgreSQL username, default: gcac
POSTGRES_USER=gcac

# PostgreSQL password, must be changed
POSTGRES_PASSWORD=TLSFlow-DB-7Qm2-Vp9x-2026

# Access-token signing secret, use a random value
GCAC_TOKEN_SECRET=TLSFlow-Token-K4r8-Np2z-2026

# Secret encryption key; use a random value and keep it unchanged
GCAC_SECRET_KEK=TLSFlow-KEK-H7s3-Lx6v-2026

# Enable Browser Runtime image, default: false
BROWSER_RUNTIME_ENABLED=false

# Docker Compose profile is derived from the above switch; do not remove
COMPOSE_PROFILES=${BROWSER_RUNTIME_ENABLED}

# Required when Browser Runtime is enabled
BROWSER_RUNTIME_SHARED_SECRET=
