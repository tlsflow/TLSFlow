# GCAC Docker Compose 环境变量模板
#
# 本文件只提供变量名和占位符，不包含真实密钥。请复制到仓库外的受控文件，
# 例如 /Users/you/.config/gcac/docker.env，再通过 docker compose --env-file 使用。
# GCAC_RELEASE_VERSION 不在此维护；Compose 镜像标签必须从根目录 version 文件读取。

# 构建与对外端口
VITE_PRODUCT_EDITION=public
GCAC_PORT=8085
GCAC_BACKEND_PORT=3003

# 标准版 PostgreSQL
POSTGRES_DB=gcac
POSTGRES_USER=gcac
POSTGRES_PASSWORD=CHANGE_ME

# GCAC 必填密钥（请使用密码管理器或 CI Secret 注入）
GCAC_TOKEN_SECRET=CHANGE_ME
GCAC_INITIAL_ADMIN_PASSWORD=CHANGE_ME
GCAC_SECRET_KEK=CHANGE_ME
GCAC_CA_CONFIRMATION_SECRET=CHANGE_ME
# 许可证签发根公钥（Base64URL 编码的 Ed25519 SubjectPublicKeyInfo）
GCAC_LICENSE_TRUST_KEYS_JSON={"REPLACE_WITH_LICENSE_KEY_ID":"REPLACE_WITH_BASE64URL_SPKI"}

# Plugin Runner、Policy Authority 和 Agent Local Policy 的实例级材料不放在模板中。
# 首次生产启动会随机生成，使用 GCAC_SECRET_KEK 加密保存到持久化 data/runtime 卷，
# 后续启动从该文件解密恢复。请勿删除该卷或更换 GCAC_SECRET_KEK。

# 标准版 Browser Runtime
BROWSER_RUNTIME_SHARED_SECRET=CHANGE_ME
BROWSER_RUNTIME_PUBLIC_BASE_URL=
BROWSER_RUNTIME_MAX_SESSIONS=4
