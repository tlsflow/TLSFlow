# TLSFlow 标准版 Docker Compose 环境变量模板
# TLSFlow standard Docker Compose environment template
#
# 复制为 docker/.env 后修改值 / Copy to docker/.env and edit the values.
# 本文件不包含真实密钥 / This file must not contain real secrets.

# Docker Hub 镜像命名空间 / Docker Hub image namespace
GCAC_IMAGE_NAMESPACE=your-dockerhub-namespace

# 镜像标签，建议使用固定版本 / Image tag; pin a release version in production
GCAC_RELEASE_VERSION=latest

# Web 对外端口，默认 8085 / Public Web port, default: 8085
GCAC_PORT=8085

# 控制面公开地址，必须能被 Agent 访问 / Public control-plane URL reachable by Agents
GCAC_PUBLIC_BASE_URL=http://your-tlsflow-host:8085

# 宿主持久化数据根目录，与 compose.yml 位于同一目录
# Host persistence root, located beside compose.yml
GCAC_DATA_ROOT=./data

# PostgreSQL 数据库名称，默认 gcac / PostgreSQL database name, default: gcac
POSTGRES_DB=gcac

# PostgreSQL 用户名，默认 gcac / PostgreSQL username, default: gcac
POSTGRES_USER=gcac

# PostgreSQL 密码，必须修改 / PostgreSQL password, must be changed
POSTGRES_PASSWORD=TLSFlow-DB-7Qm2-Vp9x-2026

# 登录令牌签名密钥，必须使用随机值 / Access-token signing secret, use a random value
GCAC_TOKEN_SECRET=TLSFlow-Token-K4r8-Np2z-2026

# Secret 加密密钥，必须使用随机值并长期保持不变
# Secret encryption key; use a random value and keep it unchanged
GCAC_SECRET_KEK=TLSFlow-KEK-H7s3-Lx6v-2026

# 是否启用 Browser Runtime，默认关闭
# Enable Browser Runtime image, default: false
BROWSER_RUNTIME_ENABLED=false

# Docker Compose Profile 由上面的开关自动控制，请勿删除
# Docker Compose profile is derived from the switch above; do not remove
COMPOSE_PROFILES=${BROWSER_RUNTIME_ENABLED}

# 是否允许审批发起人自行批准，默认关闭
# Allow approval requesters to approve their own requests, default: false
# GCAC_APPROVAL_ALLOW_SELF_APPROVAL=false

# 启用 Browser Runtime 时必须设置 / Required when Browser Runtime is enabled
BROWSER_RUNTIME_SHARED_SECRET=
