{
  "schemaVersion": "gcac.docker-publish-contract/v1",
  "sourceRepository": "GCAC_PUBLIC_REPOSITORY",
  "sourceRefRequired": true,
  "platforms": [
    "linux/amd64",
    "linux/arm64"
  ],
  "localBuild": {
    "script": "docker/build-tools/build-local.sh",
    "mustLoadLocally": true,
    "mustPush": false
  },
  "publish": {
    "script": "docker/publish/publish-images.sh",
    "requiresExternalDockerLogin": true,
    "requiredEnvironment": [
      "GCAC_DOCKER_LOGIN_CONFIRMED"
    ],
    "defaultNamespace": "tlsflow",
    "secretNames": [
      "DOCKERHUB_USERNAME",
      "DOCKERHUB_TOKEN"
    ],
    "images": [
      "tlsflow-small",
      "tlsflow-db",
      "tlsflow-backend",
      "tlsflow-web",
      "tlsflow-browser-runtime"
    ],
    "provenance": true,
    "sbom": true
  }
}
