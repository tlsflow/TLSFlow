# syntax=docker/dockerfile:1.7

ARG NODE_IMAGE=node:22-bookworm-slim
ARG GO_FULL_IMAGE=golang:1.23-bookworm
ARG GO_COMPAT_IMAGE=golang:1.20-bullseye

FROM ${GO_FULL_IMAGE} AS full-go
FROM ${GO_COMPAT_IMAGE} AS compatibility-go

FROM ${NODE_IMAGE} AS bundle
ARG GO_PROXY=https://proxy.golang.org|https://goproxy.cn|direct
WORKDIR /src
COPY --from=full-go /usr/local/go /opt/go-full
COPY --from=compatibility-go /usr/local/go /opt/go-compat
COPY version ./version
COPY agents ./agents
COPY docker/build-tools/build-agent-release-bundle.mjs ./docker/build-tools/build-agent-release-bundle.mjs
COPY docker/verify/verify-release-bundle.mjs ./docker/verify/verify-release-bundle.mjs
ENV GCAC_AGENT_BUNDLE_IN_DOCKER=true \
    GCAC_FULL_GO=/opt/go-full/bin/go \
    GCAC_COMPAT_GO=/opt/go-compat/bin/go \
    GOPROXY=${GO_PROXY}
RUN node docker/build-tools/build-agent-release-bundle.mjs
RUN node docker/verify/verify-release-bundle.mjs /src/build/agent-release-bundle

FROM scratch
COPY --from=bundle /src/build/agent-release-bundle/ /
