# syntax=docker/dockerfile:1.7

ARG BUILD_IMAGE=debian:bookworm-slim
ARG GO_FULL_IMAGE=golang:1.23-bookworm
ARG GO_COMPAT_IMAGE=golang:1.20-bullseye

FROM ${GO_FULL_IMAGE} AS full-go
FROM ${GO_COMPAT_IMAGE} AS compatibility-go

FROM ${BUILD_IMAGE} AS bundle
RUN apt-get update \
  && apt-get install -y --no-install-recommends ca-certificates \
  && rm -rf /var/lib/apt/lists/*
ARG GO_PROXY=https://proxy.golang.org|https://goproxy.cn|direct
WORKDIR /src
COPY --from=full-go /usr/local/go /opt/go-full
COPY --from=compatibility-go /usr/local/go /opt/go-compat
COPY version ./version
COPY agents ./agents
COPY docker/build-tools/build-agent-release-bundle.sh ./docker/build-tools/build-agent-release-bundle.sh
COPY docker/verify/verify-release-bundle.sh ./docker/verify/verify-release-bundle.sh
ENV GCAC_AGENT_BUNDLE_IN_DOCKER=true \
    GCAC_FULL_GO=/opt/go-full/bin/go \
    GCAC_COMPAT_GO=/opt/go-compat/bin/go \
    GOPROXY=${GO_PROXY}
RUN chmod +x docker/build-tools/build-agent-release-bundle.sh docker/verify/verify-release-bundle.sh \
  && sh docker/build-tools/build-agent-release-bundle.sh
RUN sh docker/verify/verify-release-bundle.sh /src/build/agent-release-bundle

FROM scratch
COPY --from=bundle /src/build/agent-release-bundle/ /
