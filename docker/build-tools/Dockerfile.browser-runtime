# syntax=docker/dockerfile:1.7

ARG NODE_IMAGE=node:22-bookworm-slim

FROM ${NODE_IMAGE} AS build
WORKDIR /src/browser-runtime
COPY browser-runtime/package.json browser-runtime/package-lock.json ./
ENV PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=1
RUN npm ci
COPY browser-runtime/tsconfig.json ./
COPY browser-runtime/src ./src
RUN npm run build

FROM ${NODE_IMAGE} AS runtime-dependencies
WORKDIR /src/browser-runtime
COPY browser-runtime/package.json browser-runtime/package-lock.json ./
ENV PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=1
RUN npm ci --omit=dev --ignore-scripts

FROM ${NODE_IMAGE} AS novnc-assets
WORKDIR /tmp/novnc
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
  set -eux; \
  for attempt in 1 2 3 4 5; do \
    apt-get \
      -o Acquire::Retries=5 \
      -o Acquire::http::Timeout=30 \
      -o Acquire::https::Timeout=30 \
      update \
      && apt-get \
        -o Acquire::Retries=5 \
        -o Acquire::http::Timeout=30 \
        -o Acquire::https::Timeout=30 \
        install -y --no-install-recommends ca-certificates novnc \
      && break; \
    if [ "$attempt" = 5 ]; then exit 1; fi; \
    rm -rf /var/lib/apt/lists/*; \
    sleep 5; \
  done; \
  rm -rf /var/lib/apt/lists/* \
  && mkdir -p /novnc \
  && cp -a /usr/share/novnc/. /novnc/

FROM ${NODE_IMAGE}
WORKDIR /app
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
  set -eux; \
  for attempt in 1 2 3 4 5; do \
    apt-get \
      -o Acquire::Retries=5 \
      -o Acquire::http::Timeout=30 \
      -o Acquire::https::Timeout=30 \
      update \
      && apt-get \
        -o Acquire::Retries=5 \
        -o Acquire::http::Timeout=30 \
        -o Acquire::https::Timeout=30 \
        install -y --no-install-recommends ca-certificates \
      && break; \
    if [ "$attempt" = 5 ]; then exit 1; fi; \
    rm -rf /var/lib/apt/lists/*; \
    sleep 5; \
  done; \
  sed -i 's|http://deb.debian.org/debian|https://deb.debian.org/debian|g' /etc/apt/sources.list.d/debian.sources; \
  sed -i 's|http://deb.debian.org/debian-security|https://deb.debian.org/debian-security|g' /etc/apt/sources.list.d/debian.sources; \
  for attempt in 1 2 3 4 5; do \
    apt-get \
      -o Acquire::Retries=5 \
      -o Acquire::http::Timeout=30 \
      -o Acquire::https::Timeout=30 \
      update \
      && apt-get \
        -o Acquire::Retries=5 \
        -o Acquire::http::Timeout=30 \
        -o Acquire::https::Timeout=30 \
        install -y --no-install-recommends \
          chromium dumb-init fluxbox fonts-noto-cjk x11vnc xvfb \
      && break; \
    if [ "$attempt" = 5 ]; then exit 1; fi; \
    rm -rf /var/lib/apt/lists/*; \
    sleep 5; \
  done; \
  rm -rf /var/lib/apt/lists/* \
  && useradd --create-home --uid 10001 --shell /usr/sbin/nologin browser-runtime \
  && mkdir -p /run/gcac-browser-sessions /app/container \
  && chown -R browser-runtime:browser-runtime /run/gcac-browser-sessions /app
COPY --from=runtime-dependencies /src/browser-runtime/node_modules ./node_modules
COPY --from=novnc-assets /novnc ./novnc
COPY --from=build /src/browser-runtime/dist ./dist
COPY browser-runtime/container/start-session.sh ./container/start-session.sh
RUN chmod 0555 ./container/start-session.sh
ENV NODE_ENV=production \
    BROWSER_SESSION_ROOT=/run/gcac-browser-sessions \
    BROWSER_SESSION_SCRIPT=/app/container/start-session.sh \
    BROWSER_CHROMIUM_EXECUTABLE=/usr/bin/chromium \
    BROWSER_NOVNC_ROOT=/app/novnc
USER browser-runtime
EXPOSE 8787
ENTRYPOINT ["dumb-init", "--"]
CMD ["node", "dist/server.js"]
