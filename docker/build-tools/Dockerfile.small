# syntax=docker/dockerfile:1.7

ARG NODE_IMAGE=node:22-bookworm-slim
ARG VITE_PRODUCT_EDITION=public

FROM ${NODE_IMAGE} AS docs-build
WORKDIR /src/docs
COPY docs/Documentation/package.json docs/Documentation/package-lock.json ./
RUN npm ci
COPY docs/Documentation ./
RUN npm run docs:check && npm run docs:build

FROM ${NODE_IMAGE} AS web-build
ARG VITE_PRODUCT_EDITION
ENV VITE_PRODUCT_EDITION=${VITE_PRODUCT_EDITION}
WORKDIR /src/web
COPY web/package.json web/package-lock.json ./
COPY version /src/version
RUN npm ci
COPY web ./
COPY --from=docs-build /src/docs/.vitepress/dist ./public/docs
RUN npm run build

FROM ${NODE_IMAGE} AS backend-build
WORKDIR /src/backend
COPY backend/package.json backend/package-lock.json ./
RUN npm ci
COPY scripts /src/scripts
COPY backend ./
RUN npm run build
RUN test -f dist/modules/workflow-templates/domain/jsonata-transform.worker.js

FROM ${NODE_IMAGE} AS runtime
ARG TARGETARCH
WORKDIR /app
ENV NODE_ENV=production \
    GCAC_DEPLOYMENT_ARCHITECTURE=small \
    GCAC_PERSISTENCE_BACKEND=pglite \
    GCAC_PGLITE_DATA_DIR=/var/lib/gcac/pglite \
    GCAC_MIGRATIONS_DIR=/app/src/database/migrations \
    GCAC_WEB_ROOT=/app/web \
    GCAC_WORKFLOW_DATA_DIR=/app/data/workflows \
    GCAC_RUNTIME_SECRETS_FILE=/app/data/runtime/runtime-secrets.enc \
    GCAC_POLICY_AUTHORITY_STATE_FILE=/app/data/runtime/policy-authority-state.json \
    GCAC_AGENT_RELEASE_BUNDLE_ROOT=/opt/gcac/agent-release-bundle \
    GCAC_LEGO_PATH=/usr/local/bin/lego \
    GCAC_PLUGIN_RUNNER_EXECUTABLE_PATH=/usr/local/bin/node \
    GCAC_PLUGIN_RUNNER_WORKING_DIRECTORY=/app \
    GCAC_PLUGIN_RUNNER_ARGS_JSON=[\"/app/dist/modules/plugins/runner/runner-server.js\"] \
    GCAC_PLUGIN_RUNNER_VERSION=gcac-plugin-runner-v1 \
    GCAC_PLUGIN_SDK_VERSION=gcac-plugin-sdk-v1 \
    GCAC_POLICY_AUTHORITY_EXECUTABLE_PATH=/usr/local/bin/node \
    GCAC_POLICY_AUTHORITY_WORKING_DIRECTORY=/app \
    GCAC_POLICY_AUTHORITY_ARGS_JSON=[\"/app/dist/modules/agents/security/policy-authority-process.js\"] \
    GCAC_POLICY_AUTHORITY_PROCESS_ROLE=host \
    GCAC_TOKEN_SECRET_FILE=/app/data/runtime/token-secret

COPY docker/build-tools/versions.json docker/build-tools/install-lego.sh /tmp/
RUN apt-get update \
  && apt-get install -y --no-install-recommends dumb-init ca-certificates curl tar openssl openjdk-17-jre-headless \
  && TARGETARCH="$TARGETARCH" sh /tmp/install-lego.sh /tmp/versions.json \
  && rm -f /tmp/lego.tar.gz /tmp/install-lego.sh /tmp/versions.json \
  && rm -rf /var/lib/apt/lists/* \
  && useradd --create-home --uid 10001 --shell /usr/sbin/nologin gcac \
  && mkdir -p /var/lib/gcac/pglite /app/data/workflows /app/data/runtime /app/data/tls-inspector /app/data/plugins /app/src/database/migrations \
      /app/src/modules/plugins/builtin-plugins /app/src/modules/workflow-templates/builtin-workflows \
      /app/web /opt/gcac/agent-release-bundle \
  && chown -R gcac:gcac /var/lib/gcac /app /opt/gcac

COPY --from=backend-build /src/backend/package.json ./package.json
COPY --from=backend-build /src/backend/package-lock.json ./package-lock.json
COPY version /version
RUN npm ci --omit=dev --ignore-scripts
COPY --from=backend-build /src/backend/dist ./dist
RUN test -f dist/modules/workflow-templates/domain/jsonata-transform.worker.js
COPY --from=backend-build /src/scripts ./scripts
COPY tls-inspector /opt/gcac/tls-inspector
COPY docker/runtime/start-gcac-with-tls-inspector.sh /usr/local/bin/start-gcac-with-tls-inspector.sh
RUN chmod 0755 /usr/local/bin/start-gcac-with-tls-inspector.sh
COPY --from=backend-build --chown=gcac:gcac /src/backend/src/database/migrations ./src/database/migrations
COPY --from=backend-build /src/backend/src/modules/plugins/builtin-plugins ./src/modules/plugins/builtin-plugins
COPY --from=backend-build /src/backend/src/modules/workflow-templates/builtin-workflows ./src/modules/workflow-templates/builtin-workflows
COPY --from=web-build /src/web/dist ./web
COPY build/agent-release-bundle/ /opt/gcac/agent-release-bundle/

COPY docker/verify/verify-release-bundle.sh ./docker/verify/verify-release-bundle.sh
COPY docker/verify/scan-small-image-content.sh ./docker/verify/scan-small-image-content.sh
RUN test -f /opt/gcac/agent-release-bundle/manifest.json \
  && test -f /opt/gcac/agent-release-bundle/linux/amd64/gcac-linux-agent \
  && test -f /opt/gcac/agent-release-bundle/linux/arm64/gcac-linux-agent \
  && sh /app/docker/verify/verify-release-bundle.sh \
  && sh /app/docker/verify/scan-small-image-content.sh /app /opt/gcac

USER gcac
ENV TLS_INSPECTOR_HOST=127.0.0.1 \
    TLS_INSPECTOR_PORT=8788 \
    TLS_INSPECTOR_DATA_DIR=/app/data/tls-inspector \
    GCAC_TLS_INSPECTOR_URL=http://127.0.0.1:8788
EXPOSE 3003 8788
ENTRYPOINT ["dumb-init", "--"]
CMD ["/usr/local/bin/start-gcac-with-tls-inspector.sh"]
