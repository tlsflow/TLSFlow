# syntax=docker/dockerfile:1.7

ARG NODE_IMAGE=node:22-bookworm-slim

FROM ${NODE_IMAGE} AS build
WORKDIR /src/backend
COPY backend/package.json backend/package-lock.json ./
RUN npm ci
COPY scripts /src/scripts
COPY backend ./
RUN npm run build
RUN test -f dist/modules/workflow-templates/domain/jsonata-transform.worker.js

FROM ${NODE_IMAGE}
ARG TARGETARCH
WORKDIR /app
ENV NODE_ENV=production \
    GCAC_DEPLOYMENT_ARCHITECTURE=standard \
    GCAC_PERSISTENCE_BACKEND=postgres \
    GCAC_MIGRATIONS_DIR=/app/src/database/migrations \
    GCAC_WORKFLOW_DATA_DIR=/app/data/workflows \
    GCAC_RUNTIME_SECRETS_FILE=/app/data/runtime/runtime-secrets.enc \
    GCAC_POLICY_AUTHORITY_STATE_FILE=/app/data/runtime/policy-authority-state.json \
    GCAC_AGENT_RELEASE_BUNDLE_ROOT=/opt/gcac/agent-release-bundle \
    GCAC_LEGO_PATH=/usr/local/bin/lego \
    BROWSER_RUNTIME_URL=http://browser-runtime:8787

COPY docker/build-tools/versions.json docker/build-tools/install-lego.mjs /tmp/
RUN apt-get update \
  && apt-get install -y --no-install-recommends dumb-init ca-certificates curl tar openssl openjdk-17-jre-headless \
  && TARGETARCH="$TARGETARCH" node /tmp/install-lego.mjs /tmp/versions.json \
  && rm -f /tmp/lego.tar.gz /tmp/install-lego.mjs /tmp/versions.json \
  && rm -rf /var/lib/apt/lists/* \
  && useradd --create-home --uid 10001 --shell /usr/sbin/nologin gcac \
  && mkdir -p /app/data/workflows /app/data/runtime /app/data/tls-inspector /app/data/plugins /app/src/database/migrations /app/src/modules/plugins/builtin-plugins \
      /app/src/modules/workflow-templates/builtin-workflows /opt/gcac/agent-release-bundle \
  && chown -R gcac:gcac /app /opt/gcac

COPY --from=build /src/backend/package.json ./package.json
COPY --from=build /src/backend/package-lock.json ./package-lock.json
COPY version /version
RUN npm ci --omit=dev --ignore-scripts
COPY --from=build /src/backend/dist ./dist
RUN test -f dist/modules/workflow-templates/domain/jsonata-transform.worker.js
COPY --from=build /src/scripts ./scripts
COPY tls-inspector /opt/gcac/tls-inspector
COPY docker/runtime/start-gcac-with-tls-inspector.mjs /usr/local/bin/start-gcac-with-tls-inspector.mjs
COPY --from=build --chown=gcac:gcac /src/backend/src/database/migrations ./src/database/migrations
COPY --from=build /src/backend/src/modules/plugins/builtin-plugins ./src/modules/plugins/builtin-plugins
COPY --from=build /src/backend/src/modules/workflow-templates/builtin-workflows ./src/modules/workflow-templates/builtin-workflows
COPY build/agent-release-bundle/ /opt/gcac/agent-release-bundle/

RUN test -f /opt/gcac/agent-release-bundle/manifest.json \
  && node -e "const m=require('./package.json'); if (m.dependencies['@electric-sql/pglite'] === undefined) process.exit(1)"

COPY docker/verify/verify-release-bundle.mjs ./docker/verify/verify-release-bundle.mjs
RUN node ./docker/verify/verify-release-bundle.mjs

USER gcac
ENV TLS_INSPECTOR_HOST=127.0.0.1 \
    TLS_INSPECTOR_PORT=8788 \
    TLS_INSPECTOR_DATA_DIR=/app/data/tls-inspector \
    GCAC_TLS_INSPECTOR_URL=http://127.0.0.1:8788
EXPOSE 3003 8788
ENTRYPOINT ["dumb-init", "--"]
CMD ["node", "/usr/local/bin/start-gcac-with-tls-inspector.mjs"]
