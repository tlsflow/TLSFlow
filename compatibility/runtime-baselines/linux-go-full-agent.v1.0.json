{
  "apiVersion": "gcac.runtime-baseline/v1",
  "baselineId": "linux-go-full-agent",
  "version": "1.0",
  "agentProductLine": "linux-go-full-agent",
  "osFamily": "linux",
  "architectures": [
    "amd64",
    "arm64"
  ],
  "runtimeRequirements": [
    {
      "name": "linux-kernel",
      "operator": "at_least",
      "value": "3.2"
    }
  ],
  "securityRequirements": [
    "tls-1.2-or-newer",
    "signed-agent-artifact"
  ],
  "installationCapabilities": [
    "agent-local-install",
    "agent-local-upgrade",
    "agent-local-rollback"
  ],
  "unsupportedBoundaries": [
    "kernel-below-3.2",
    "unsupported-cpu-architecture",
    "security-baseline-unsatisfied"
  ]
}
