{
  "apiVersion": "gcac.runtime-baseline/v1",
  "baselineId": "windows-compatibility-agent",
  "version": "1.0",
  "agentProductLine": "windows-compatibility-agent",
  "osFamily": "windows",
  "architectures": [
    "x64"
  ],
  "runtimeRequirements": [
    {
      "name": "windows-server",
      "operator": "one_of",
      "values": [
        "2008-r2-sp1",
        "2012",
        "2012-r2"
      ]
    }
  ],
  "securityRequirements": [
    "tls-1.2-or-newer",
    "signed-agent-artifact"
  ],
  "installationCapabilities": [
    "windows-service-install",
    "windows-service-upgrade",
    "windows-service-rollback"
  ],
  "unsupportedBoundaries": [
    "windows-server-2003",
    "windows-server-2003-r2",
    "windows-server-2008-non-r2"
  ]
}
