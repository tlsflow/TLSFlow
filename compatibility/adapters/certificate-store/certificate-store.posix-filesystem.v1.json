{
  "apiVersion": "gcac.adapter/v1",
  "adapterId": "certificate-store.posix-filesystem",
  "version": "1.0",
  "kind": "certificate_store",
  "consumes": ["certificate.material.jks", "certificate.material.pem", "certificate.material.pkcs12"],
  "produces": ["certificate.store.filesystem-path"],
  "requirements": {
    "id": "certificate-store.posix-filesystem.requirement",
    "ownerType": "provider_action",
    "ownerId": "certificate-store.posix-filesystem",
    "requiredAll": [
      {
        "capabilityKey": "linux.filesystem.posix-atomic.v1",
        "operator": "equals",
        "expected": true,
        "reason": "需要以原子替换方式写入证书材料",
        "riskIfMissing": "证书文件可能处于不完整状态"
      }
    ],
    "optional": [
      {
        "capabilityKey": "linux.security.selinux.v1",
        "operator": "equals",
        "expected": true,
        "reason": "存在 SELinux 时应恢复安全上下文",
        "riskIfMissing": "服务可能无法读取更新后的证书"
      },
      {
        "capabilityKey": "linux.security.apparmor.v1",
        "operator": "equals",
        "expected": true,
        "reason": "存在 AppArmor 时应验证访问策略",
        "riskIfMissing": "服务可能无法读取更新后的证书"
      }
    ],
    "anyOfGroups": [],
    "forbidden": [],
    "minConfidence": 80,
    "allowManual": false,
    "riskLevel": "critical"
  },
  "conflicts": [],
  "priority": 100,
  "riskLevel": "critical",
  "supportedOperationSchemas": ["1.0"]
}
