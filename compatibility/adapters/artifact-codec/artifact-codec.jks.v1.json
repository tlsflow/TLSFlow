{
  "apiVersion": "gcac.adapter/v1",
  "adapterId": "artifact-codec.jks",
  "version": "1.0",
  "kind": "artifact_codec",
  "consumes": ["certificate.version"],
  "produces": ["certificate.material.jks"],
  "requirements": {
    "id": "artifact-codec.jks.requirement",
    "ownerType": "provider_action",
    "ownerId": "artifact-codec.jks",
    "requiredAll": [
      {
        "capabilityKey": "tomcat.keystore.replace",
        "operator": "equals",
        "expected": true,
        "reason": "需要生成或验证 Tomcat 可使用的 Java KeyStore",
        "riskIfMissing": "无法为 JKS 场景准备证书材料"
      },
      {
        "capabilityKey": "tls.local_verify",
        "operator": "equals",
        "expected": true,
        "reason": "需要验证密钥库中的证书材料",
        "riskIfMissing": "无法确认 JKS 材料可以安全部署"
      }
    ],
    "optional": [],
    "anyOfGroups": [],
    "forbidden": [],
    "minConfidence": 80,
    "allowManual": false,
    "riskLevel": "critical"
  },
  "conflicts": [],
  "priority": 100,
  "riskLevel": "critical",
  "supportedOperationSchemas": ["1.0"]
}
