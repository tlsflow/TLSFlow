{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gcac.local/schemas/execution-recipe.v1.schema.json",
  "title": "GCAC Execution Recipe v1",
  "type": "object",
  "required": ["apiVersion", "recipeId", "version", "actionType", "operationSchemaVersion", "requires", "composition", "rollbackRequired", "verificationRequired", "conflictsWith"],
  "properties": {
    "apiVersion": { "const": "gcac.execution-recipe/v1" },
    "recipeId": { "$ref": "#/$defs/id" },
    "version": { "$ref": "#/$defs/version" },
    "actionType": { "type": "string", "minLength": 1 },
    "operationSchemaVersion": { "$ref": "#/$defs/version" },
    "requires": { "type": "object" },
    "composition": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "enum": ["product", "certificate_store", "artifact_codec", "service_controller", "transport", "verifier", "rollback"] },
      "additionalProperties": { "type": "string", "minLength": 1 }
    },
    "rollbackRequired": { "type": "boolean" },
    "verificationRequired": { "type": "boolean" },
    "conflictsWith": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "deprecatedAt": { "type": "string", "format": "date-time" }
  },
  "additionalProperties": false,
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)+$" },
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+(?:\\.\\d+)?$" }
  }
}
