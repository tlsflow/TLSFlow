{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "gcac://schemas/unified-plugin-manifest.v1",
  "title": "GCAC 统一插件 Manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "apiVersion", "kind", "pluginId", "version", "displayNameKey", "publisher",
    "runtime", "source", "scope", "trust", "support", "capabilities", "permissions", "resources"
  ],
  "properties": {
    "apiVersion": { "const": "gcac.plugin-manifest/v1" },
    "kind": { "const": "GcacPlugin" },
    "pluginId": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "minLength": 1 },
    "displayNameKey": { "type": "string", "minLength": 1 },
    "defaultLocale": { "type": "string", "minLength": 2 },
    "descriptionKey": { "type": "string", "minLength": 1 },
    "publisher": { "type": "string", "minLength": 1 },
    "runtime": { "enum": ["AGENT_PLAN", "WORKFLOW_DSL"] },
    "source": { "enum": ["BUILTIN", "USER"] },
    "scope": { "enum": ["MANAGED", "STANDALONE", "BOTH"] },
    "trust": { "enum": ["OFFICIAL_SIGNED", "USER_SIGNED", "UNSIGNED"] },
    "support": { "enum": ["OFFICIAL", "COMMUNITY", "SELF_MANAGED"] },
    "minGcacVersion": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-([0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*))?(?:\\+([0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*))?$",
      "description": "插件要求的最低 GCAC 宿主版本；缺少时按 0.0.0 兼容历史插件"
    },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["key", "contractVersion", "actionContractId", "riskLevel", "executionLocations"],
        "properties": {
          "key": { "type": "string", "minLength": 1 },
          "contractVersion": { "type": "string", "minLength": 1 },
          "actionContractId": { "type": "string", "minLength": 1 },
          "riskLevel": { "enum": ["LOW", "MEDIUM", "HIGH"] },
          "executionLocations": { "type": "array", "items": { "enum": ["AGENT", "CONTROL_PLANE", "GATEWAY"] }, "minItems": 1 },
          "compatibility": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "host": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "minVersion": { "$ref": "#/$defs/semver" },
                  "requiredFeatures": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
                }
              },
              "targets": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["productFamily", "versionRange"],
                  "properties": {
                    "productFamily": { "type": "string", "minLength": 1 },
                    "versionRange": { "type": "string", "minLength": 1, "pattern": "^(?:(?:>=|<=|>|<|=)?(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?)(?:\\s+(?:(?:>=|<=|>|<|=)?(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?))*$" }
                  }
                }
              },
              "execution": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["location"],
                  "properties": {
                    "location": { "enum": ["AGENT", "CONTROL_PLANE", "GATEWAY"] },
                    "minRuntimeVersion": { "$ref": "#/$defs/semver" }
                  }
                }
              },
              "testedVersions": { "type": "object", "additionalProperties": { "type": "array", "items": { "type": "string", "minLength": 1 } } }
            }
          }
        }
      }
    },
    "permissions": { "type": "array", "items": { "type": "string" } },
    "compatibility": { "type": "object" },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "runtimeEntrypoint": { "const": "runtime/index.js" },
        "agentPlans": { "type": "object", "additionalProperties": { "type": "string", "minLength": 1 } },
        "workflows": { "type": "object", "additionalProperties": { "type": "string", "minLength": 1 } },
        "forms": { "type": "object", "additionalProperties": { "type": "string", "minLength": 1 } },
        "presentations": { "type": "object", "additionalProperties": { "type": "string", "minLength": 1 } },
        "locales": { "type": "object", "additionalProperties": { "type": "string", "minLength": 1 } },
        "discoveryMappings": { "type": "object", "additionalProperties": { "type": "string", "minLength": 1 } },
        "agentDiscoveryMappings": { "type": "object", "additionalProperties": { "type": "string", "minLength": 1 } }
      }
    }
  },
  "$defs": {
    "semver": { "type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-([0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*))?(?:\\+([0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*))?$" }
  }
}
