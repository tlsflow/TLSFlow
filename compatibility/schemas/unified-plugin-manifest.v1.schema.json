{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "gcac://schemas/unified-plugin-manifest.v1",
  "title": "GCAC 统一插件 Manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "apiVersion", "kind", "pluginId", "version", "displayNameKey", "publisher",
    "runtime", "source", "scope", "trust", "support", "capabilities", "permissions", "resources"
  ],
  "properties": {
    "apiVersion": { "const": "gcac.plugin-manifest/v1" },
    "kind": { "const": "GcacPlugin" },
    "pluginId": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "minLength": 1 },
    "displayNameKey": { "type": "string", "minLength": 1 },
    "defaultLocale": { "type": "string", "minLength": 2 },
    "descriptionKey": { "type": "string", "minLength": 1 },
    "publisher": { "type": "string", "minLength": 1 },
    "runtime": { "enum": ["AGENT_ATOMIC", "WORKFLOW_DSL"] },
    "source": { "enum": ["BUILTIN", "USER"] },
    "scope": { "enum": ["MANAGED", "STANDALONE", "BOTH"] },
    "trust": { "enum": ["OFFICIAL_SIGNED", "USER_SIGNED", "UNSIGNED"] },
    "support": { "enum": ["OFFICIAL", "COMMUNITY", "SELF_MANAGED"] },
    "minGcacVersion": { "type": "string" },
    "capabilities": { "type": "array", "minItems": 1, "items": { "type": "object" } },
    "permissions": { "type": "array", "items": { "type": "string" } },
    "compatibility": { "type": "object" },
    "resources": { "type": "object" }
  }
}
