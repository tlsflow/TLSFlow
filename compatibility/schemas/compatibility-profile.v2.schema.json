{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gcac.local/schemas/compatibility-profile.v2.schema.json",
  "title": "GCAC Compatibility Profile v2",
  "type": "object",
  "required": ["apiVersion", "profileId", "version", "baselineRef", "recipeRefs", "certificationRefs", "declaredStatus", "automation", "limitations"],
  "properties": {
    "apiVersion": { "const": "gcac.compatibility/v2" },
    "profileId": { "$ref": "#/$defs/id" },
    "version": { "$ref": "#/$defs/version" },
    "baselineRef": { "$ref": "#/$defs/reference" },
    "recipeRefs": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/reference" } },
    "certificationRefs": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/id" } },
    "declaredStatus": { "enum": ["certified", "supported", "compatible", "experimental", "legacy", "unsupported"] },
    "automation": { "enum": ["full", "assisted", "manual", "monitor_only"] },
    "limitations": { "type": "array", "items": { "type": "string" } },
    "publishedAt": { "type": "string", "format": "date-time" },
    "deprecatedAt": { "type": "string", "format": "date-time" }
  },
  "additionalProperties": false,
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)+$" },
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+(?:\\.\\d+)?$" },
    "reference": { "type": "string", "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)+@\\d+\\.\\d+(?:\\.\\d+)?$" }
  }
}
