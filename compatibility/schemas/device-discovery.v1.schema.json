{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "gcac.device-discovery/v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "device", "capabilities", "frameworks", "sites", "certificates", "certificateBindings", "warnings"],
  "properties": {
    "apiVersion": { "const": "gcac.device-discovery/v1" },
    "device": { "$ref": "#/$defs/device" },
    "capabilities": { "type": "array", "maxItems": 100, "items": { "$ref": "#/$defs/capability" } },
    "frameworks": { "type": "array", "maxItems": 200, "items": { "$ref": "#/$defs/framework" } },
    "sites": { "type": "array", "maxItems": 5000, "items": { "$ref": "#/$defs/site" } },
    "certificates": { "type": "array", "maxItems": 10000, "items": { "$ref": "#/$defs/certificate" } },
    "certificateBindings": { "type": "array", "maxItems": 20000, "items": { "$ref": "#/$defs/binding" } },
    "warnings": { "type": "array", "maxItems": 500, "items": { "$ref": "#/$defs/warning" } },
    "rawFacts": { "type": "object" }
  },
  "$defs": {
    "stableKey": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,255}$" },
    "metadata": { "type": "object" },
    "device": { "type": "object", "required": ["stableKey", "displayName", "productFamily"], "properties": { "stableKey": { "$ref": "#/$defs/stableKey" }, "displayName": { "type": "string" }, "productFamily": { "type": "string" }, "softwareVersion": { "type": "string" }, "managementAddress": { "type": "string" }, "metadata": { "$ref": "#/$defs/metadata" } } },
    "capability": { "type": "object", "required": ["key", "available"], "properties": { "key": { "type": "string" }, "available": { "type": "boolean" }, "metadata": { "$ref": "#/$defs/metadata" } } },
    "framework": { "type": "object", "required": ["stableKey", "type", "displayName"], "properties": { "stableKey": { "$ref": "#/$defs/stableKey" }, "type": { "type": "string" }, "displayName": { "type": "string" }, "version": { "type": "string" }, "metadata": { "$ref": "#/$defs/metadata" } } },
    "site": { "type": "object", "required": ["stableKey", "displayName", "addresses"], "properties": { "stableKey": { "$ref": "#/$defs/stableKey" }, "frameworkStableKey": { "$ref": "#/$defs/stableKey" }, "displayName": { "type": "string" }, "addresses": { "type": "array", "items": { "type": "string" } }, "port": { "type": "integer", "minimum": 1, "maximum": 65535 }, "protocol": { "type": "string" }, "metadata": { "$ref": "#/$defs/metadata" } } },
    "certificate": { "type": "object", "required": ["stableKey"], "properties": { "stableKey": { "$ref": "#/$defs/stableKey" }, "sha256Fingerprint": { "type": "string" }, "subject": { "type": "string" }, "issuer": { "type": "string" }, "notAfter": { "type": "string" }, "metadata": { "$ref": "#/$defs/metadata" } } },
    "binding": { "type": "object", "required": ["stableKey", "siteStableKey", "certificateStableKey"], "properties": { "stableKey": { "$ref": "#/$defs/stableKey" }, "siteStableKey": { "$ref": "#/$defs/stableKey" }, "certificateStableKey": { "$ref": "#/$defs/stableKey" }, "bindingName": { "type": "string" }, "metadata": { "$ref": "#/$defs/metadata" } } },
    "warning": { "type": "object", "required": ["code", "messageKey"], "properties": { "code": { "type": "string" }, "messageKey": { "type": "string" }, "metadata": { "$ref": "#/$defs/metadata" } } }
  }
}
