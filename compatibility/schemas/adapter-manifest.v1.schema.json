{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gcac.local/schemas/adapter-manifest.v1.schema.json",
  "title": "GCAC Adapter Manifest v1",
  "type": "object",
  "required": ["apiVersion", "adapterId", "version", "kind", "consumes", "produces", "requirements", "conflicts", "priority", "riskLevel", "supportedOperationSchemas"],
  "properties": {
    "apiVersion": { "const": "gcac.adapter/v1" },
    "adapterId": { "type": "string", "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)+$" },
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+(?:\\.\\d+)?$" },
    "kind": { "enum": ["product", "certificate_store", "artifact_codec", "service_controller", "transport", "verifier", "rollback"] },
    "consumes": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "produces": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "requirements": { "type": "object" },
    "conflicts": { "type": "array", "items": { "type": "object" } },
    "priority": { "type": "integer", "minimum": -1000, "maximum": 1000 },
    "riskLevel": { "enum": ["low", "medium", "high", "critical"] },
    "supportedOperationSchemas": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^\\d+\\.\\d+(?:\\.\\d+)?$" }, "uniqueItems": true },
    "deprecated": { "type": "boolean" },
    "replacedBy": { "type": "string" }
  },
  "additionalProperties": false
}
