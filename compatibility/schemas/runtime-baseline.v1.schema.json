{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gcac.local/schemas/runtime-baseline.v1.schema.json",
  "title": "GCAC Runtime Baseline v1",
  "type": "object",
  "required": ["apiVersion", "baselineId", "version", "agentProductLine", "osFamily", "architectures", "runtimeRequirements", "securityRequirements", "installationCapabilities", "unsupportedBoundaries"],
  "properties": {
    "apiVersion": { "const": "gcac.runtime-baseline/v1" },
    "baselineId": { "$ref": "#/$defs/id" },
    "version": { "$ref": "#/$defs/version" },
    "agentProductLine": { "$ref": "#/$defs/id" },
    "osFamily": { "enum": ["windows", "linux", "gateway"] },
    "architectures": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "runtimeRequirements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "operator"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "operator": { "enum": ["equals", "at_least", "one_of"] },
          "value": { "type": "string", "minLength": 1 },
          "values": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
        },
        "additionalProperties": false
      }
    },
    "securityRequirements": { "$ref": "#/$defs/strings" },
    "installationCapabilities": { "$ref": "#/$defs/nonEmptyStrings" },
    "unsupportedBoundaries": { "$ref": "#/$defs/strings" },
    "deprecatedAt": { "type": "string", "format": "date-time" }
  },
  "additionalProperties": false,
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)+$" },
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+(?:\\.\\d+)?$" },
    "strings": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "nonEmptyStrings": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
  }
}
