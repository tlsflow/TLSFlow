{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gcac.local/schemas/action-contract.v1.schema.json",
  "title": "GCAC Agent Action Contract v1",
  "type": "object",
  "required": [
    "schemaVersion",
    "actionType",
    "actionSchemaVersion",
    "requestId",
    "agentProduct",
    "capabilitySnapshotRef",
    "audit"
  ],
  "properties": {
    "schemaVersion": { "const": "gcac.action/v1" },
    "actionType": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)+$" },
    "actionSchemaVersion": { "type": "string", "pattern": "^\\d+\\.\\d+(?:\\.\\d+)?$" },
    "requestId": { "type": "string", "minLength": 1 },
    "idempotencyKey": { "type": "string", "minLength": 1 },
    "agentProduct": { "$ref": "#/$defs/agentProduct" },
    "capabilitySnapshotRef": { "$ref": "#/$defs/capabilitySnapshotRef" },
    "target": { "$ref": "#/$defs/actionTarget" },
    "input": { "type": "object" },
    "requiredCapabilities": { "type": "array" },
    "dryRun": { "type": "boolean" },
    "audit": { "$ref": "#/$defs/audit" },
    "evidence": { "type": "array", "items": { "$ref": "#/$defs/evidence" } },
    "recovery": { "$ref": "#/$defs/recovery" }
  },
  "$defs": {
    "agentProduct": {
      "type": "object",
      "required": ["productLine", "productVersion", "runtimeName", "runtimeVersion"],
      "properties": {
        "productLine": {
          "enum": ["windows-modern", "windows-compatibility", "linux-modern", "linux-compatibility", "gateway"]
        },
        "productVersion": { "type": "string", "minLength": 1 },
        "runtimeName": { "type": "string", "minLength": 1 },
        "runtimeVersion": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "capabilitySnapshotRef": {
      "type": "object",
      "required": ["snapshotId", "snapshotVersion", "capturedAt"],
      "properties": {
        "snapshotId": { "type": "string", "minLength": 1 },
        "snapshotVersion": { "type": "string", "minLength": 1 },
        "capturedAt": { "type": "string", "format": "date-time" }
      },
      "additionalProperties": false
    },
    "actionTarget": {
      "type": "object",
      "required": ["targetType", "targetId"],
      "properties": {
        "targetType": { "type": "string", "minLength": 1 },
        "targetId": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": true
    },
    "audit": {
      "type": "object",
      "required": ["tenantId", "requestId", "correlationId"],
      "properties": {
        "tenantId": { "type": "string", "minLength": 1 },
        "requestId": { "type": "string", "minLength": 1 },
        "correlationId": { "type": "string", "minLength": 1 },
        "executionRunId": { "type": "string" },
        "executionStepId": { "type": "string" },
        "initiatedBy": { "type": "string" }
      },
      "additionalProperties": false
    },
    "evidence": {
      "type": "object",
      "required": ["evidenceType", "summary", "observedAt"],
      "properties": {
        "evidenceType": { "type": "string", "minLength": 1 },
        "summary": { "type": "string", "minLength": 1 },
        "observedAt": { "type": "string", "format": "date-time" },
        "reference": { "type": "string" },
        "details": { "type": "object" }
      },
      "additionalProperties": false
    },
    "recovery": {
      "type": "object",
      "required": ["ledgerId", "state", "rollbackAvailable"],
      "properties": {
        "ledgerId": { "type": "string", "minLength": 1 },
        "state": { "enum": ["available", "in_progress", "completed", "failed", "manual_required"] },
        "rollbackAvailable": { "type": "boolean" },
        "resumeToken": { "type": "string" },
        "lastCheckpoint": { "type": "string" }
      },
      "additionalProperties": false
    }
  }
}
