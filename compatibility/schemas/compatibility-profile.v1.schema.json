{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gcac.local/schemas/compatibility-profile.v1.schema.json",
  "title": "GCAC Compatibility Profile v1",
  "type": "object",
  "required": ["apiVersion", "profileId", "version", "status", "match", "composition", "automation", "rollbackRequired", "verificationRequired", "limitations", "evidence"],
  "properties": {
    "apiVersion": { "const": "gcac.compatibility/v1" },
    "profileId": { "type": "string", "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)+$" },
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+(?:\\.\\d+)?$" },
    "status": { "enum": ["certified", "supported", "compatible", "experimental", "legacy", "unsupported"] },
    "match": { "type": "object" },
    "composition": {
      "type": "object",
      "propertyNames": { "enum": ["product", "certificate_store", "artifact_codec", "service_controller", "transport", "verifier", "rollback"] },
      "additionalProperties": { "type": "string", "minLength": 1 }
    },
    "automation": { "enum": ["full", "assisted", "manual", "monitor_only"] },
    "rollbackRequired": { "type": "boolean" },
    "verificationRequired": { "type": "boolean" },
    "limitations": { "type": "array", "items": { "type": "string" } },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["evidenceId", "type", "status", "reference", "observedAt"],
        "properties": {
          "evidenceId": { "type": "string" },
          "type": { "enum": ["fixture", "contract_test", "integration_test", "real_environment", "security_review"] },
          "status": { "enum": ["passed", "failed", "expired"] },
          "reference": { "type": "string" },
          "observedAt": { "type": "string", "format": "date-time" },
          "expiresAt": { "type": "string", "format": "date-time" }
        },
        "additionalProperties": false
      }
    },
    "publishedAt": { "type": "string", "format": "date-time" },
    "deprecatedAt": { "type": "string", "format": "date-time" }
  },
  "additionalProperties": false
}
