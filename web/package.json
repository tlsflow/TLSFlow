{
  "name": "gcac-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5172",
    "build": "vue-tsc --noEmit && vite build",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit tests/contract",
    "test:component": "vitest run tests/component",
    "test:e2e": "vitest run tests/e2e",
    "i18n:scan": "node scripts/scan-i18n-literals.mjs",
    "openapi:generate": "node scripts/generate-openapi-types.mjs",
    "docs:check": "npm --prefix ../docs/Documentation run docs:check",
    "docs:build": "npm --prefix ../docs/Documentation run docs:build",
    "docs:link": "node scripts/link-docs-debug.mjs",
    "docs:refresh": "npm run docs:check && npm run docs:build && npm run docs:link",
    "build:with-docs": "npm run docs:refresh && npm run build"
  },
  "dependencies": {
    "@vitejs/plugin-vue": "latest",
    "pinia": "latest",
    "vite": "latest",
    "vue": "latest",
    "vue-i18n": "^11.4.6",
    "vue-router": "latest"
  },
  "devDependencies": {
    "@types/node": "latest",
    "@vue/test-utils": "latest",
    "jsdom": "latest",
    "typescript": "latest",
    "vitest": "latest",
    "vue-tsc": "latest"
  }
}
