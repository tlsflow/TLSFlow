{
  "name": "gcac-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5172",
    "build": "vue-tsc --noEmit && vite build",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit tests/contract",
    "test:component": "vitest run tests/component",
    "test:e2e": "vitest run tests/e2e",
    "openapi:generate": "node scripts/generate-openapi-types.mjs"
  },
  "dependencies": {
    "@vitejs/plugin-vue": "latest",
    "pinia": "latest",
    "vite": "latest",
    "vue": "latest",
    "vue-i18n": "^11.4.6",
    "vue-router": "latest"
  },
  "devDependencies": {
    "@types/node": "latest",
    "@vue/test-utils": "latest",
    "jsdom": "latest",
    "typescript": "latest",
    "vitest": "latest",
    "vue-tsc": "latest"
  }
}
